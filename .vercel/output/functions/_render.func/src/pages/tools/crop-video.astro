---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "crop-video",
  name: "Crop Video",
  metaTitle: "Crop Video – Cut Region Online Free | Dayront",
  metaDescription: "Crop MP4, WebM, MOV videos. Specify X, Y, width, height. Private.",
  icon: "🔲",
  howTo: [{"title":"Upload video","text":"Select a file."},{"title":"Set crop area","text":"Enter coordinates and size."},{"title":"Download cropped video","text":"Get the selected region."}],
  faq: [],
  relatedTools: [{"href":"/tools/resize-video","icon":"↔️","name":"Resize Video"},{"href":"/tools/video-cutter","icon":"✂️","name":"Video Cutter"}],
  type: "crop-video",
  from: undefined,
  to: undefined,
  outputFormat: "mp4",
  settings: [{"name":"x","label":"X offset","type":"number","min":0,"default":0},{"name":"y","label":"Y offset","type":"number","min":0,"default":0},{"name":"w","label":"Width","type":"number","min":1,"default":640},{"name":"h","label":"Height","type":"number","min":1,"default":480}],
  tutorial: "\n    <h2>Using Our Crop Video</h2>\n    <p>Our Crop Video tool is designed to be simple and private. Upload your file, adjust any settings, and download the processed result – all inside your browser. No data ever leaves your device.</p>\n    <h3>Why Choose Dayront?</h3>\n    <ul>\n      <li>No uploads – your files stay on your device.</li>\n      <li>Fast processing using the latest browser technology.</li>\n      <li>Completely free, no registration required.</li>\n    </ul>\n  ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
