---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "mkv-to-mp3",
  name: "MKV to MP3",
  metaTitle: "MKV to MP3 Converter – Extract Audio Free Online | Dayront",
  metaDescription: "Convert MKV video to MP3 audio in your browser. No upload, completely private.",
  icon: "🎬",
  howTo: [{"title":"Upload MKV video","text":"Select MKV."},{"title":"Convert to MP3","text":"Audio extracted."},{"title":"Download MP3","text":"Get audio file."}],
  faq: [{"question":"Multi-channel?","answer":"Downmixed to stereo."},{"question":"Subtitles?","answer":"Ignored."},{"question":"File size limit?","answer":"No hard limit."}],
  relatedTools: [{"href":"/convert/avi-to-mp3","icon":"🎬","name":"AVI to MP3"},{"href":"/convert/mp4-to-mp3","icon":"🎬","name":"MP4 to MP3"},{"href":"/tools/audio-merger","icon":"🔗","name":"Audio Merger"}],
  type: "convert",
  from: "mkv",
  to: "mp3",
  outputFormat: undefined,
  settings: [{"name":"bitrate","label":"Bitrate","type":"select","options":["128k","192k","256k","320k"],"default":"192k"}],
  tutorial: "\n      <h2>Why Convert MKV to MP3?</h2>\n      <p>Converting MKV to MP3 is one of the most common audio/video tasks. Our MKV to MP3 tool makes it effortless and completely private. Whether you need to save space, improve compatibility, or extract audio for editing, this tool does it instantly in your browser.</p>\n      <h3>Key Benefits</h3>\n      <ul>\n        <li><strong>100% Private</strong> – Your files never leave your device.</li>\n        <li><strong>No Software Install</strong> – Works directly in your browser.</li>\n        <li><strong>Free & Unlimited</strong> – Use it as many times as you need.</li>\n        <li><strong>High Quality</strong> – Preserves the best possible quality during conversion.</li>\n      </ul>\n    ",
  relatedBlogs: [{"slug":"how-to-convert-mp4-to-mp3","title":"How to Convert MP4 to MP3 Online – Private, Fast & Free","categories":["mp4","mp3","audio extraction"]},{"slug":"understanding-audio-formats","title":"Understanding Audio Formats: MP3, WAV, FLAC, OGG, and M4A Explained","categories":["audio formats"]},{"slug":"the-complete-guide-to-converting-video-to-audio","title":"The Complete Guide to Converting Video to Audio: MP4, MOV, MKV to MP3","categories":["video to audio"]}],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
