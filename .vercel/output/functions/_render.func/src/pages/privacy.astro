---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromAstroUrl } from '../lib/i18n';

const lang = getLangFromAstroUrl(Astro.url);

let pages: Record<string, any> = {};
try {
  const res = await fetch(
    new URL(`/locales/${lang}/pages.json`, Astro.url.origin)
  );
  if (res.ok) pages = await res.json();
} catch {}

// Helper
function t(key: string, fallback: string): string {
  const keys = key.split('.');
  let val: any = pages;
  for (const k of keys) {
    if (val && typeof val === 'object') val = val[k];
    else return fallback;
  }
  return typeof val === 'string' ? val : fallback;
}

// Shortcut for privacy section
const priv = (key: string, fallback: string) => t(`privacy.${key}`, fallback);

// Build the sections array from translations or hardcoded
const sections = pages.privacy?.sections || [
  {
    title: '1. Our Privacy Promise',
    body: [
      "Dayront was built with a single, unwavering commitment: <strong>your files never leave your device.</strong> This isn't a marketing slogan — it's the fundamental architecture of our entire service.",
      "When you use Dayront to convert, cut, merge, or edit any media file, the processing happens entirely within your browser. Your files are never uploaded to our servers. We never see them, store them, or access them in any way.",
      "We designed Dayront to be the tool we'd want our own families to use. That means privacy isn't an afterthought — it's the foundation.",
    ],
  },
  {
    title: '2. What We Don\'t Collect',
    body: [
      "Let's be absolutely clear about what Dayront does <strong>not</strong> do:",
      "<ul><li><strong>We don't upload your files.</strong> All processing is local. We couldn't access your files even if we wanted to.</li><li><strong>We don't require accounts.</strong> No sign‑up, no login, no user profiles. You use Dayront anonymously.</li><li><strong>We don't track your conversions.</strong> We have no idea which files you're processing or how often.</li><li><strong>We don't store your files.</strong> No server‑side storage exists for user files.</li><li><strong>We don't sell data.</strong> We have no user data to sell. It's that simple.</li><li><strong>We don't use invasive analytics.</strong> No fingerprinting, no cross‑site tracking, no user behavior profiling.</li></ul>",
    ],
  },
  {
    title: '3. What We Do Collect',
    body: [
      "We collect the absolute minimum needed to keep the website running:",
      "<ul><li><strong>Anonymous page view counts.</strong> We may use a privacy‑focused analytics tool that counts page visits without cookies, without tracking individuals, and without collecting personal data. This helps us understand which tools are most popular so we can improve them.</li><li><strong>Your theme preference.</strong> When you toggle between light and dark mode, we save that choice in your browser's local storage. This data never leaves your device.</li><li><strong>Your language preference.</strong> If you select a language, we remember it locally so you don't have to set it every visit.</li><li><strong>Temporary converted files.</strong> If you enable the 24‑hour workspace feature, your processed files are stored in your browser's local database — a storage that stays on your device. You can clear this anytime.</li></ul>",
      "None of this information is transmitted to us. It stays right where it belongs — on your computer.",
    ],
  },
  {
    title: '4. Cookies & Local Storage',
    body: [
      "Dayront uses minimal local storage — not for tracking, but for basic functionality:",
      "<ul><li><strong>Theme preference</strong> — stored locally so your dark mode choice persists.</li><li><strong>Language preference</strong> — stored locally so you don't have to reselect your language.</li><li><strong>Advertisement cookies</strong> — our ad partners may set cookies to serve relevant ads. These are subject to the ad network's own privacy policy.</li></ul>",
      "You can clear local storage at any time through your browser settings. Dayront will continue to work perfectly without it — you'll just be back to the default theme and language.",
    ],
  },
  {
    title: '5. Advertisements',
    body: [
      "Dayront is free and always will be. To keep the servers running, we display a small number of advertisements. Here's how we handle ads responsibly:",
      "<ul><li>Ads are placed in fixed positions that never block or interrupt your conversion process.</li><li>Ad containers have reserved dimensions so the page never jumps or shifts while loading.</li><li>We do not share any file data, personal information, or conversion details with advertisers — because we don't have any to share.</li><li>Ad networks may use cookies for frequency capping and basic targeting. Please refer to the respective ad network's privacy policy for more details on how they handle data.</li></ul>",
      "If you have concerns about a specific advertisement you see on Dayront, please contact us and we'll investigate.",
    ],
  },
  {
    title: '6. Data Security',
    body: [
      "Because your files never reach our servers, the primary security consideration is your own device and browser. We recommend:",
      "<ul><li>Keeping your browser updated to the latest version</li><li>Using a modern browser with strong security defaults (Chrome, Firefox, Safari, Edge, Brave)</li><li>Being mindful of browser extensions that may access your browsing activity</li></ul>",
      "Our website is served over HTTPS, ensuring that the connection between your browser and our server is encrypted. The processing engine that powers Dayront is served from our domain and verified for integrity.",
    ],
  },
  {
    title: '7. Children\'s Privacy',
    body: [
      "Dayront is not directed at children under 13 years of age. We do not knowingly collect personal information from children under 13. Since we don't collect personal information at all, this is inherently satisfied — but we state it here for clarity.",
    ],
  },
  {
    title: '8. Your Rights',
    body: [
      "Depending on your jurisdiction, you may have certain rights regarding your personal data, including the right to access, correct, delete, or port your data.",
      "Because Dayront does not collect or store personal data, there is effectively nothing to access, correct, or delete. Your files are on your device. Your preferences are in your browser. You control everything.",
      "If you have any questions about exercising your privacy rights, contact us and we'll respond promptly.",
    ],
  },
  {
    title: '9. Changes to This Privacy Policy',
    body: [
      "We may update this Privacy Policy from time to time to reflect changes in our practices or for other operational, legal, or regulatory reasons. When we make changes, we'll update the \"Last updated\" date at the top of this page.",
      "If the changes are significant, we'll place a notice on our website. We encourage you to review this policy periodically to stay informed about how we protect your privacy.",
    ],
  },
  {
    title: '10. Contact Us',
    body: [
      "If you have questions, concerns, or requests regarding this Privacy Policy or your privacy while using Dayront, please reach out:",
      "<strong>Email:</strong> <a href=\"mailto:privacy@dayront.com\" class=\"text-sky hover:underline\">privacy@dayront.com</a>",
      "<strong>Response time:</strong> We aim to reply to all privacy‑related inquiries within 48 hours.",
      "For general questions or feedback, you can also email <a href=\"mailto:hello@dayront.com\" class=\"text-sky hover:underline\">hello@dayront.com</a>.",
    ],
  },
];
---

<BaseLayout lang={lang}
  title={priv('metaTitle', "Privacy Policy – Dayront")}
  description={priv('metaDescription', "Dayront's privacy policy: your files never leave your device. Learn how we protect your data, what we collect, and how we handle ads.")}
>
  <section class="max-w-3xl mx-auto px-4 py-16 bg-white dark:bg-gray-950">
    
    <div class="mb-12">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-black dark:text-white mb-3">
        {priv('heading', 'Privacy Policy')}
      </h1>
      <p class="text-gray-500 dark:text-gray-400">
        {priv('lastUpdated', 'Last updated: January 1, 2025')}
      </p>
    </div>

    <div class="space-y-10">
      {sections.map((section: any) => (
        <div>
          <h2 class="text-2xl font-bold text-black dark:text-white mb-3">
            {section.title}
          </h2>
          {Array.isArray(section.body)
            ? section.body.map((para: string) => (
                <p
                  class="text-gray-700 dark:text-white leading-relaxed mt-2"
                  set:html={para}
                />
              ))
            : <p class="text-gray-700 dark:text-white leading-relaxed" set:html={section.body} />
          }
        </div>
      ))}
    </div>

  </section>
</BaseLayout>