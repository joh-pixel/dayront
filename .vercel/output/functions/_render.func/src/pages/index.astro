  .dashboard-bottom strong {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: #0f172a;
  }

  :global(.dark) .dashboard-bottom strong {
    color: white;
  }

  .fake-process {
    border: 0;
    border-radius: 9px;
    padding: 9px 13px;
    color: white;
    background: #0284c7;
    font-size: 9px;
    font-weight: 800;
  }

  /* TERMINAL CLI */

  .cli-section {
    padding: 80px 0;
    background: rgba(14,165,233,.02);
  }

  :global(.dark) .cli-section {
    background: rgba(15,23,42,.5);
  }

  .cli-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }

  .cli-window {
    border-radius: 18px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid #1e293b;
    box-shadow: 0 30px 80px rgba(0,0,0,.25);
    transition: transform .3s ease;
  }

  .cli-window-bar {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    background: #1e293b;
    border-bottom: 1px solid #334155;
  }

  .cli-window-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #64748b;
  }

  .cli-window-bar strong {
    margin-left: auto;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
  }

  .cli-body {
    padding: 25px 20px;
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    color: #cbd5e1;
    font-size: 13px;
  }

  .cli-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .prompt {
    color: #38bdf8;
    font-weight: 700;
  }

  .command {
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid transparent;
    animation: typing 2.5s steps(30, end) forwards;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #38bdf8;
    animation: blink 1s step-end infinite;
  }

  .cli-output {
    margin-top: 18px;
    opacity: 0;
    animation: fadeInUp .5s 2.6s forwards;
  }

  .progress-bar {
    height: 6px;
    background: #1e293b;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #0284c7, #38bdf8);
    border-radius: 8px;
    animation: progress 1.5s 2.6s ease forwards;
  }

  .success {
    color: #4ade80;
    font-size: 12px;
    display: block;
  }

  .cli-copy .section-kicker {
    color: #0284c7;
  }

  .cli-copy h3 {
    margin: 12px 0 10px;
    color: #0f172a;
    font-size: 22px;
    font-weight: 800;
  }

  :global(.dark) .cli-copy h3 {
    color: white;
  }

  .cli-copy p {
    color: #64748b;
    line-height: 1.65;
    margin-bottom: 15px;
  }

  /* STATS */

  .stats-section {
    position: relative;
    z-index: 20;
    margin-top: -20px;
  }

  .stats-card {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(18px);
    box-shadow: 0 25px 70px rgba(15,23,42,.08);
    overflow: hidden;
  }

  :global(.dark) .stats-card {
    background: rgba(15,23,42,.9);
    border-color: #1e293b;
  }

  .stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 25px 15px;
    border-right: 1px solid #e2e8f0;
  }

  :global(.dark) .stat-item {
    border-color: #1e293b;
  }

  .stat-item:last-child {
    border-right: 0;
  }

  .stat-icon {
    font-size: 20px;
  }

  .stat-number {
    color: #0284c7;
    font-size: 25px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -.04em;
  }

  .stat-label {
    margin-top: 5px;
    color: #64748b;
    font-size: 10px;
    font-weight: 600;
  }

  /* GENERAL */

  .section {
    padding: 110px 0;
  }

  .soft-section {
    padding: 110px 0;
    background: #f8fafc;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }

  :global(.dark) .soft-section {
    background: rgba(15,23,42,.45);
    border-color: #1e293b;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .split-heading {
    max-width: none;
    display: flex;
    align-items: end;
    justify-content: space-between;
    text-align: left;
  }

  .section-kicker {
    display: block;
    margin-bottom: 12px;
    color: #0284c7;
    font-size: 10px;
    letter-spacing: .16em;
    font-weight: 900;
  }

  .section-heading h2 {
    margin: 0;
    color: #020617;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -.045em;
    font-weight: 900;
  }

  :global(.dark) .section-heading h2 {
    color: white;
  }

  .section-heading p {
    max-width: 650px;
    margin: 18px auto 0;
    color: #64748b;
    line-height: 1.7;
  }

  .split-heading p {
    margin-left: 0;
  }

  .text-link {
    color: #0284c7;
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
  }

  /* CHARTS */

  .charts-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 20px;
  }

  .chart-card {
    min-width: 0;
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: white;
    box-shadow: 0 15px 45px rgba(15,23,42,.045);
  }

  :global(.dark) .chart-card {
    border-color: #1e293b;
    background: #0f172a;
  }

  .chart-kicker {
    color: #94a3b8;
  }

  .chart-card h3 {
    margin: 3px 0 0;
    color: #0f172a;
    font-size: 17px;
    font-weight: 800;
  }

  :global(.dark) .chart-card h3 {
    color: white;
  }

  .chart-value {
    text-align: right;
  }

  .chart-value strong {
    display: block;
    color: #0f172a;
    font-size: 25px;
  }

  :global(.dark) .chart-value strong {
    color: white;
  }

  .positive {
    color: #16a34a;
    font-size: 9px;
    font-weight: 700;
  }

  .big-live-chart {
    height: 280px;
    position: relative;
    margin-top: 20px;
  }

  .horizontal-lines {
    position: absolute;
    inset: 0 0 35px 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .horizontal-lines span {
    width: 100%;
    border-top: 1px dashed #e2e8f0;
  }

  :global(.dark) .horizontal-lines span {
    border-color: #1e293b;
  }

  .big-live-chart svg {
    position: absolute;
    inset: 0 0 35px;
    width: 100%;
    height: calc(100% - 35px);
  }

  #live-area {
    fill: rgba(14,165,233,.10);
  }

  #live-line {
    fill: none;
    stroke: #0ea5e9;
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: drawChart 2.4s ease forwards;
  }

  #live-dot {
    fill: #0ea5e9;
    filter: drop-shadow(0 0 8px rgba(14,165,233,.45));
    animation: chartPulse 1.5s infinite;
  }

  .chart-axis {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    color: #94a3b8;
    font-size: 9px;
  }

  .chart-footer {
    display: flex;
    justify-content: space-between;
    padding-top: 15px;
    border-top: 1px solid #e2e8f0;
    color: #94a3b8;
    font-size: 9px;
  }

  :global(.dark) .chart-footer {
    border-color: #1e293b;
  }

  .chart-footer span:first-child {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0ea5e9;
  }

  .mini-live {
    color: #16a34a;
    font-size: 8px;
    font-weight: 900;
  }

  .donut-wrapper {
    min-height: 270px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
  }

  .donut {
    width: 155px;
    height: 155px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      conic-gradient(
        #0284c7 0 55%,
        #38bdf8 55% 75%,
        #7dd3fc 75% 90%,
        #e0f2fe 90% 100%
      );
    position: relative;
    animation: rotateIn 1s ease both;
  }

  .donut::before {
    content: '';
    position: absolute;
    inset: 17px;
    border-radius: 50%;
    background: white;
  }

  :global(.dark) .donut::before {
    background: #0f172a;
  }

  .donut-center {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .donut-center strong {
    display: block;
    color: #0f172a;
    font-size: 28px;
    line-height: 1;
  }

  :global(.dark) .donut-center strong {
    color: white;
  }

  .donut-center span {
    color: #94a3b8;
    font-size: 9px;
  }

  .donut-list {
    flex: 1;
  }

  .donut-list div {
    display: grid;
    grid-template-columns: 8px 1fr auto;
    align-items: center;
    gap: 7px;
    margin: 12px 0;
    color: #64748b;
    font-size: 10px;
  }

  .donut-list i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #0284c7;
  }

  .donut-list div:nth-child(2) i { background: #38bdf8; }
  .donut-list div:nth-child(3) i { background: #7dd3fc; }
  .donut-list div:nth-child(4) i { background: #e0f2fe; }

  .donut-list strong {
    color: #0f172a;
  }

  :global(.dark) .donut-list strong {
    color: white;
  }

  /* HINT */

  .hint-section {
    padding: 0 0 30px;
  }

  .hint-box {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    border: 1px solid rgba(14,165,233,.18);
    border-radius: 18px;
    background: linear-gradient(100deg, rgba(14,165,233,.06), rgba(250,204,21,.04));
  }

  .hint-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 13px;
    color: #0284c7;
    background: rgba(14,165,233,.1);
  }

  .hint-content {
    flex: 1;
  }

  .hint-content span {
    display: block;
    color: #0284c7;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: .13em;
  }

  .hint-content h3,
  .hint-content p {
    transition: opacity .15s ease;
  }

  .hint-content h3 {
    margin: 3px 0;
    color: #0f172a;
    font-size: 13px;
  }

  :global(.dark) .hint-content h3 {
    color: white;
  }

  .hint-content p {
    margin: 0;
    color: #64748b;
    font-size: 11px;
    line-height: 1.5;
  }

  #next-tip {
    width: 38px;
    height: 38px;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    color: #0284c7;
    background: white;
    cursor: pointer;
    transition: .25s ease;
  }

  #next-tip:hover {
    transform: rotate(180deg);
  }

  /* TOOLS */

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
  }

  .premium-tool-card {
    position: relative;
    overflow: hidden;
    padding: 22px;
    min-height: 170px;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    background: white;
    transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
  }

  :global(.dark) .premium-tool-card {
    border-color: #1e293b;
    background: #0f172a;
  }

  .premium-tool-card::after {
    content: '';
    position: absolute;
    width: 100px;
    height: 100px;
    top: -50px;
    right: -50px;
    border-radius: 50%;
    background: rgba(14,165,233,.08);
    transition: transform .4s ease;
  }

  .premium-tool-card:hover {
    transform: translateY(-7px);
    border-color: rgba(14,165,233,.35);
    box-shadow: 0 20px 50px rgba(15,23,42,.09);
  }

  .premium-tool-card:hover::after {
    transform: scale(2);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .tool-icon {
    font-size: 29px;
  }

  .tool-category {
    padding: 5px 8px;
    border-radius: 999px;
    color: #64748b;
    background: #f8fafc;
    font-size: 8px;
    font-weight: 800;
  }

  :global(.dark) .tool-category {
    background: #1e293b;
  }

  .premium-tool-card h3 {
    margin: 20px 0 5px;
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
  }

  :global(.dark) .premium-tool-card h3 {
    color: white;
  }

  .premium-tool-card p {
    color: #64748b;
    font-size: 11px;
  }

  .tool-arrow {
    position: absolute;
    right: 20px;
    bottom: 18px;
    color: #0284c7;
    font-size: 18px;
  }

  .center-button {
    display: flex;
    justify-content: center;
    margin-top: 38px;
  }

  /* IMAGE SHOWCASE (replaces video) */

  .image-showcase {
    padding: 110px 0;
    background: #020617;
    color: white;
    overflow: hidden;
  }

  .showcase-layout {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 70px;
    align-items: center;
  }

  .showcase-text h2 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
    font-weight: 900;
  }

  .showcase-text h2 span {
    display: block;
    color: #38bdf8;
  }

  .showcase-text > p {
    max-width: 520px;
    margin: 24px 0;
    color: #94a3b8;
    line-height: 1.75;
  }

  .video-points {
    margin: 28px 0;
  }

  .video-points div {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid #1e293b;
  }

  .video-points span {
    color: #38bdf8;
    font-size: 10px;
    font-weight: 900;
  }

  .video-points strong {
    font-size: 12px;
  }

  .showcase-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .image-mockup {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 25px;
    overflow: hidden;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 30px 90px rgba(0,0,0,.35);
  }

  .mockup-toolbar {
    height: 40px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    border-bottom: 1px solid #1e293b;
    background: #1e293b;
  }

  .mockup-toolbar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #475569;
  }

  .mockup-toolbar small {
    margin-left: auto;
    color: #94a3b8;
    font-size: 10px;
    font-weight: 600;
  }

  .mockup-body {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mockup-file,
  .mockup-output {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid #334155;
    border-radius: 14px;
  }

  .file-icon {
    font-size: 22px;
  }

  .mockup-file strong,
  .mockup-output strong {
    display: block;
    font-size: 12px;
    color: #f1f5f9;
  }

  .mockup-file small,
  .mockup-output small {
    color: #64748b;
    font-size: 10px;
  }

  .badge {
    margin-left: auto;
    padding: 4px 8px;
    border-radius: 999px;
    background: rgba(34,197,94,.1);
    color: #4ade80;
    font-size: 9px;
    font-weight: 800;
  }

  .badge.done {
    background: rgba(34,197,94,.15);
  }

  .mockup-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    color: #64748b;
    font-size: 24px;
  }

  .format-badge {
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(14,165,233,.08);
    color: #38bdf8;
    font-weight: 800;
    font-size: 11px;
  }

  .format-badge.output {
    background: rgba(34,197,94,.08);
    color: #4ade80;
  }

  .mockup-cta {
    padding: 0 20px 20px;
  }

  .mockup-cta button {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: #0284c7;
    color: white;
    font-weight: 700;
    font-size: 12px;
    opacity: 0.5;
    cursor: default;
  }

  /* VISUAL */

  .visual-grid {
    display: grid;
    grid-template-columns: 1.3fr .7fr;
    gap: 18px;
  }

  .visual-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 22px;
    background: white;
  }

  :global(.dark) .visual-card {
    border-color: #1e293b;
    background: #0f172a;
  }

  .visual-large {
    grid-row: span 2;
  }

  .visual-image {
    position: relative;
    overflow: hidden;
    background: #f8fafc;
  }

  :global(.dark) .visual-image {
    background: #020617;
  }

  .visual-editor {
    height: 420px;
  }

  .visual-converter,
  .visual-security {
    height: 190px;
  }

  .visual-toolbar {
    height: 42px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border-bottom: 1px solid #e2e8f0;
  }

  :global(.dark) .visual-toolbar {
    border-color: #1e293b;
  }

  .visual-toolbar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cbd5e1;
  }

  .visual-toolbar div {
    width: 70px;
    height: 7px;
    margin-left: auto;
    border-radius: 10px;
    background: #e2e8f0;
  }

  .editor-stage {
    height: calc(100% - 42px);
    padding: 30px;
  }

  .editor-video {
    height: 230px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background:
      radial-gradient(circle at 60% 30%, rgba(56,189,248,.3), transparent 25%),
      linear-gradient(135deg, #0f172a, #164e63);
  }

  .editor-play {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: rgba(255,255,255,.12);
    backdrop-filter: blur(10px);
  }

  .editor-timeline {
    margin-top: 25px;
  }

  .timeline-line {
    height: 3px;
    margin-bottom: 15px;
    background: #bae6fd;
    position: relative;
  }

  .timeline-line::after {
    content: '';
    position: absolute;
    left: 35%;
    top: -5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #0284c7;
  }

  .timeline-track {
    height: 40px;
    display: flex;
    gap: 5px;
  }

  .timeline-track span {
    flex: 1;
    border-radius: 5px;
    background: repeating-linear-gradient(
      90deg,
      #bae6fd 0 3px,
      transparent 3px 8px
    );
    opacity: .7;
  }

  .visual-copy {
    padding: 20px 22px 23px;
  }

  .visual-copy span {
    color: #0284c7;
    font-size: 8px;
    letter-spacing: .14em;
    font-weight: 900;
  }

  .visual-copy h3 {
    margin: 7px 0;
    color: #0f172a;
    font-size: 16px;
    font-weight: 800;
  }

  :global(.dark) .visual-copy h3 {
    color: white;
  }

  .visual-copy p {
    color: #64748b;
    font-size: 11px;
    line-height: 1.6;
  }

  .visual-converter {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .converter-file {
    width: 75px;
    height: 85px;
    display: grid;
    place-items: center;
    border: 1px solid #bae6fd;
    border-radius: 14px;
    color: #0284c7;
    background: rgba(14,165,233,.06);
    font-size: 16px;
    font-weight: 900;
  }

  .converter-file.output {
    border-color: #bbf7d0;
    color: #16a34a;
