---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromAstroUrl } from '../lib/i18n';
const lang = getLangFromAstroUrl(Astro.url);
import { tools } from '../lib/tools';


let pages: Record<string, any> = {};
let common: Record<string, any> = {};
try {
  const [pagesRes, commonRes] = await Promise.all([
    fetch(new URL(`/locales/${lang}/pages.json`, Astro.url.origin)),
    fetch(new URL(`/locales/${lang}/common.json`, Astro.url.origin)),
  ]);
  if (pagesRes.ok) pages = await pagesRes.json();
  if (commonRes.ok) common = await commonRes.json();
} catch {}

function t(key: string, fallback: string): string {
  const keys = key.split('.');
  let val: any = pages;
  for (const k of keys) {
    if (val && typeof val === 'object') val = val[k];
    else return fallback;
  }
  return typeof val === 'string' ? val : fallback;
}
const tc = (key: string, fallback: string) => common[key] || fallback;

const toolCount = tools.length;

const stats = [
  { value: toolCount, suffix: '+', label: 'Media Tools', icon: '🛠️' },
  { value: 0, suffix: '', label: 'Required Uploads', icon: '☁️' },
  { value: 100, suffix: '%', label: 'Browser Processing', icon: '🔐' },
  { value: 24, suffix: '/7', label: 'Available', icon: '⚡' },
];

const features = [
  {
    icon: '🔐',
    title: 'Private by Design',
    description:
      'For supported tools, processing happens directly inside your browser. Your working files do not need to be sent to a conversion server.',
    link: '/privacy',
  },
  {
    icon: '⚡',
    title: 'Fast Local Processing',
    description:
      'Modern browser technologies and WebAssembly make it possible to process many media tasks without waiting for a remote upload.',
    link: '/tools',
  },
  {
    icon: '📱',
    title: 'Works on Your Devices',
    description:
      'Use Dayront on phones, tablets, laptops and desktops with a responsive interface designed for real-world use.',
    link: '/tools',
  },
  {
    icon: '🆓',
    title: 'Free to Start',
    description:
      'Choose a tool, select your file and get started without creating an account or entering payment information.',
    link: '/tools',
  },
  {
    icon: '🌍',
