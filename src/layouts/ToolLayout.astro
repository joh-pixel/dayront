---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import Converter from '../components/conversion/Converter';
import PrivacyBadge from '../components/ui/PrivacyBadge.astro';
import { tools } from '../lib/tools';
import { getLangFromAstroUrl } from '../lib/i18n';

// --- AI COMPONENT IMPORTS ---
import AICaptions from '../components/ai/AICaptions.astro';
import AIRemoveBackground from '../components/ai/AIRemoveBackground.astro';
import AIPhotoEditor from '../components/ai/AIPhotoEditor.astro';
import BurnSubtitles from '../components/ai/BurnSubtitles.astro';

export interface Props {
  toolKey?: string;
  toolConfig?: {
    type: string;
    from?: string;
    to?: string;
    outputFormat?: string;
    label: string;
    settings?: any[];
  };
  metaTitle?: string;
  metaDescription?: string;
  title?: string;
  description?: string;
  toolName?: string;
  toolIcon?: string;
  howTo?: { title: string; text: string }[];
  faq?: { question: string; answer: string }[];
  relatedTools?: { href: string; icon: string; name: string }[];
  preConverter?: any;
  postConverter?: any;
  extraContent?: {
    tutorial?: string;
    relatedBlogs?: { slug: string; title: string; categories?: string[] }[];
  };
}

const {
  toolKey,
  toolConfig: toolConfigProp,
  metaTitle: metaTitleProp,
  metaDescription: metaDescriptionProp,
  title: titleProp,
  description: descriptionProp,
  toolName: toolNameProp,
  toolIcon: toolIconProp,
  howTo: howToProp,
  faq: faqProp,
  relatedTools: relatedToolsProp = [],
  preConverter,
  postConverter,
  extraContent,
} = Astro.props;

const lang = getLangFromAstroUrl(Astro.url);

let toolsTranslations: Record<string, any> = {};
let commonTranslations: Record<string, any> = {};

try {
  const [toolsRes, commonRes] = await Promise.all([
    fetch(new URL(`/locales/${lang}/tools.json`, Astro.url.origin)),
    fetch(new URL(`/locales/${lang}/common.json`, Astro.url.origin)),
  ]);
  if (toolsRes.ok) toolsTranslations = await toolsRes.json();
  if (commonRes.ok) commonTranslations = await commonRes.json();
} catch {}

let metaTitle = metaTitleProp || titleProp || '';
let metaDescription = metaDescriptionProp || descriptionProp || '';
let toolName = toolNameProp || '';
let toolIcon = toolIconProp || '';
let howTo = howToProp || [];
let faq = faqProp || [];
let relatedTools = relatedToolsProp || [];
let toolConfig = toolConfigProp;

if (toolKey) {
  const toolData = tools.find(t => t.slug === toolKey);
  if (toolData) {
    metaTitle = metaTitle || toolData.metaTitle;
    metaDescription = metaDescription || toolData.metaDescription;
    toolName = toolName || toolData.name;
    toolIcon = toolIcon || toolData.icon;
    howTo = howTo.length > 0 ? howTo : toolData.howTo;
    faq = faq.length > 0 ? faq : toolData.faq;

    const tTool = toolsTranslations[toolKey] || {};
    if (tTool.title) toolName = tTool.title;
    if (tTool.metaTitle) metaTitle = tTool.metaTitle;
    if (tTool.metaDescription) metaDescription = tTool.metaDescription;
    if (tTool.icon) toolIcon = tTool.icon;
    if (tTool.howTo) howTo = tTool.howTo;
    if (tTool.faq) faq = tTool.faq;

    if (!toolConfig) {
      toolConfig = {
        type: toolData.type || 'convert',
        from: toolData.from,
        to: toolData.to,
        outputFormat: toolData.outputFormat,
        label: toolName,
        settings: toolData.settings || [],
      };
    }

    if (relatedTools.length === 0 && toolData.relatedTools) {
      relatedTools = toolData.relatedTools
        .map((slug: string) => {
          const t = tools.find(tt => tt.slug === slug);
          if (!t) return null;
          const relatedTrans = toolsTranslations[slug] || {};
          return {
            href: t.from && t.to ? `/convert/${t.slug}` : `/tools/${t.slug}`,
            icon: relatedTrans.icon || t.icon,
            name: relatedTrans.title || t.name,
          };
        })
        .filter(Boolean) as any[];
    }
  }
}

if (!toolConfig) {
  toolConfig = { type: 'convert', label: toolName || 'Conversion', settings: [] };
}

// ─────────────────────────────────────────────────────────
// List of AI (non-Converter) tool types.
// Anything in this list uses a dedicated component.
// ─────────────────────────────────────────────────────────
const AI_TYPES = [
  'ai-captions',
  'ai-remove-bg',
  'ai-photo-editor',
  'burn-subtitles',
];

const isAITool = AI_TYPES.includes(toolConfig.type);

const howToHeading = commonTranslations.how_to_use || 'How to use';
const faqHeading = commonTranslations.faq_heading || 'Frequently Asked Questions';
const relatedToolsHeading = commonTranslations.related_tools || 'Related Tools';
const relatedArticlesHeading = commonTranslations.related_articles || 'Related Articles';

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: toolName,
  description: metaDescription,
  step: howTo.map((step: any, i: number) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: step.title,
    text: step.text,
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((q: any) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-7xl mx-auto px-4 py-8 sm:py-12">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center flex-wrap gap-x-2 gap-y-1">
        <li><a href="/" class="hover:text-sky transition dark:hover:text-sky">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/tools" class="hover:text-sky transition dark:hover:text-sky">Tools</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-gray-900 dark:text-white font-medium">{toolName}</li>
      </ol>
    </nav>

    <div class="lg:grid lg:grid-cols-3 lg:gap-10">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-3xl">{toolIcon}</span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-black dark:text-white">{toolName}</h1>
        </div>

        <PrivacyBadge />

        {preConverter && <div class="mb-6">{preConverter}</div>}

        {/* ─── AI TOOL ROUTING ─── */}
        {toolConfig.type === 'ai-captions' && <AICaptions toolConfig={toolConfig} />}
        {toolConfig.type === 'ai-remove-bg' && <AIRemoveBackground toolConfig={toolConfig} />}
        {toolConfig.type === 'ai-photo-editor' && <AIPhotoEditor toolConfig={toolConfig} />}
        {toolConfig.type === 'burn-subtitles' && <BurnSubtitles toolConfig={toolConfig} />}

        {/* ─── STANDARD CONVERTER (only if NOT an AI tool) ─── */}
        {!isAITool && <Converter client:load toolConfig={toolConfig} />}

        {postConverter && <div class="mt-6">{postConverter}</div>}

        <AdSlot position="below-tool" class="my-10" />

        {howTo.length > 0 && (
          <section class="mt-16">
            <h2 class="text-2xl font-bold text-black dark:text-white mb-6">
              {howToHeading} {toolName}
            </h2>
            <ol class="space-y-6">
              {howTo.map((step: any, i: number) => (
                <li class="flex gap-4">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full bg-sky text-black font-bold flex items-center justify-center text-sm">
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-semibold text-lg text-black dark:text-white">{step.title}</h3>
                    <p class="text-gray-600 dark:text-white">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}

        {faq.length > 0 && (
          <section class="mt-16">
            <h2 class="text-2xl font-bold text-black dark:text-white mb-6">{faqHeading}</h2>
            <dl class="space-y-6">
              {faq.map((q: any) => (
                <div>
                  <dt class="font-semibold text-lg text-black dark:text-white mb-2">{q.question}</dt>
                  <dd class="text-gray-600 dark:text-white">{q.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {extraContent?.tutorial && (
          <section class="mt-16 prose dark:prose-invert max-w-none" set:html={extraContent.tutorial} />
        )}

        {extraContent?.relatedBlogs && extraContent.relatedBlogs.length > 0 && (
          <section class="mt-16">
            <h2 class="text-2xl font-bold text-black dark:text-white mb-6">{relatedArticlesHeading}</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {extraContent.relatedBlogs.map((post: any) => (
                <a
                  href={`/blog/${post.slug}`}
                  class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 hover:border-sky transition"
                >
                  <h3 class="font-semibold text-black dark:text-white text-sm">{post.title}</h3>
                </a>
              ))}
            </div>
          </section>
        )}

        {relatedTools.length > 0 && (
          <section class="mt-16">
            <h2 class="text-2xl font-bold text-black dark:text-white mb-6">{relatedToolsHeading}</h2>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
              {relatedTools.map((tool: any) => (
                <a
                  href={tool.href}
                  class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 hover:border-sky transition flex flex-col items-start gap-2"
                >
                  <span class="text-2xl">{tool.icon}</span>
                  <span class="text-sm font-medium text-black dark:text-white">{tool.name}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="hidden lg:block space-y-8">
        <div class="sticky top-24">
          <h3 class="text-lg font-semibold text-black dark:text-white mb-4">{relatedToolsHeading}</h3>
          <ul class="space-y-2">
            {relatedTools.map((tool: any) => (
              <li>
                <a
                  href={tool.href}
                  class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition"
                >
                  <span>{tool.icon}</span>
                  <span class="text-sm font-medium text-black dark:text-white">{tool.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>