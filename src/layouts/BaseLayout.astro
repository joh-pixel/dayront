---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import { getCollection } from 'astro:content';
import { tools } from '../lib/tools';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL } = Astro.props;

// Build search data once for the entire site
let blogItems: any[] = [];
try {
  const blogPosts = await getCollection('blog');
  blogItems = blogPosts.map(p => ({
    title: p.data.title,
    description: p.data.description,
    url: `/blog/${p.id.replace(/\.mdx$/, '').replace(/^en\//, '')}`,
    type: 'blog',
    icon: '📝',
  }));
} catch (e) {
  // blog collection not yet set up – ignore
}

const toolItems = tools.map(t => ({
  title: t.name,
  description: t.description,
  url: t.from && t.to ? `/convert/${t.slug}` : `/tools/${t.slug}`,
  type: 'tool',
  icon: t.icon,
}));

const allSearchItems = [...toolItems, ...blogItems];
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />

    <!-- Theme detection — runs before any render to prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>

    <!-- Listen for system theme changes -->
    <script is:inline>
      (function () {
        const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
        mediaQuery.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) {
            document.documentElement.classList.toggle('dark', e.matches);
          }
        });
      })();
    </script>

    <!-- Preload critical font (optional — remove if not using Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-black dark:text-white antialiased transition-colors duration-200">
    <!-- TEMPORARY DEBUG BANNER (remove after testing) -->
    <div id="coi-check" style="position:fixed;bottom:0;left:0;background:red;color:white;padding:4px 8px;font-size:12px;z-index:9999"></div>

    <Header />

    <!-- Small ad block below header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <AdSlot position="below-header" class="my-2" />
    </div>

    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Sticky footer ad -->
    <AdSlot position="sticky-footer" class="fixed bottom-0 left-0 right-0 z-40" />

    <!-- Real‑time search modal (hidden by default) -->
    <SearchModal items={allSearchItems} />
    <script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js');
    });
  }
</script>
  </body>
</html>

<!-- Global styles for ad spacing -->
<style is:global>
  body {
    padding-bottom: 60px;
  }
  @media (min-width: 768px) {
    body {
      padding-bottom: 90px;
    }
  }

  body {
    animation: pageFadeIn 0.3s ease-out;
  }

  @keyframes pageFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      animation: none;
    }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.addEventListener('astro:before-swap', () => {
    document.body.style.opacity = '0';
    document.body.style.transition = 'opacity 0.15s ease-out';
  });

  document.addEventListener('astro:after-swap', () => {
    document.body.style.opacity = '1';
    document.body.style.transition = 'opacity 0.15s ease-out';
  });

  document.addEventListener('astro:after-swap', () => {
    const theme = localStorage.getItem('theme') ||
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
  });
</script>