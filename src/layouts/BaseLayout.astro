---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import { getCollection } from 'astro:content';
import { tools } from '../lib/tools';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
} = Astro.props;

/* -------------------------------------------------------
   SITE SEARCH DATA
------------------------------------------------------- */

let blogItems: any[] = [];

try {
  const blogPosts = await getCollection('blog');

  blogItems = blogPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.id
      .replace(/\.mdx$/, '')
      .replace(/^en\//, '')}`,
    type: 'blog',
    icon: '📝',
  }));
} catch {
  blogItems = [];
}

const toolItems = tools.map((tool) => ({
  title: tool.name,
  description: tool.description,
  url:
    tool.from && tool.to
      ? `/convert/${tool.slug}`
      : `/tools/${tool.slug}`,
  type: 'tool',
  icon: tool.icon,
}));

const allSearchItems = [
  ...toolItems,
  ...blogItems,
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />

    <meta
      name="theme-color"
      content="#030712"
      media="(prefers-color-scheme: dark)"
    />

    <meta
      name="mobile-web-app-capable"
      content="yes"
    />

    <meta
      name="apple-mobile-web-app-capable"
      content="yes"
    />

    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />

    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />

    <!-- =================================================
         EARLY THEME DETECTION
    ================================================== -->

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');

          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;

          const theme =
            stored ||
            (prefersDark ? 'dark' : 'light');

          document.documentElement.classList.toggle(
            'dark',
            theme === 'dark'
          );
        } catch {
          // Ignore storage restrictions.
        }
      })();
    </script>

    <!-- =================================================
         SYSTEM THEME LISTENER
    ================================================== -->

    <script is:inline>
      (() => {
        const mediaQuery = window.matchMedia(
          '(prefers-color-scheme: dark)'
        );

        const updateTheme = (event) => {
          if (!localStorage.getItem('theme')) {
            document.documentElement.classList.toggle(
              'dark',
              event.matches
            );
          }
        };

        if (mediaQuery.addEventListener) {
          mediaQuery.addEventListener(
            'change',
            updateTheme
          );
        } else {
          mediaQuery.addListener(updateTheme);
        }
      })();
    </script>

    <!-- =================================================
         FONT
    ================================================== -->

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- =================================================
         PWA
    ================================================== -->

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="manifest"
      href="/manifest.json"
    />

    <!-- =================================================
         PERFORMANCE HINTS
    ================================================== -->

    <link
      rel="dns-prefetch"
      href="//fonts.googleapis.com"
    />

    <link
      rel="dns-prefetch"
      href="//fonts.gstatic.com"
    />

    <!-- =================================================
         GLOBAL WORKSPACE VARIABLES
    ================================================== -->

    <style is:global>
      :root {
        --workspace-header-height: 64px;
        --workspace-radius: 18px;
        --workspace-radius-lg: 24px;
        --workspace-content-width: 1440px;
      }

      html {
        background: #ffffff;
        color-scheme: light;
      }

      html.dark {
        background: #030712;
        color-scheme: dark;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        background: #ffffff;
        color: #000000;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      html.dark body {
        background: #030712;
        color: #ffffff;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      ::selection {
        background: rgba(56, 189, 248, 0.25);
      }

      /* Better mobile tap behavior */
      button,
      a,
      input,
      select,
      textarea {
        -webkit-tap-highlight-color: transparent;
      }

      button,
      a {
        touch-action: manipulation;
      }

      /* Prevent images from overflowing */
      img,
      video,
      canvas,
      svg {
        max-width: 100%;
      }

      /* Better keyboard navigation */
      :focus-visible {
        outline: 3px solid rgba(14, 165, 233, 0.45);
        outline-offset: 3px;
      }

      /* =================================================
         PAGE TRANSITION
      ================================================== */

      body {
        animation:
          dayront-page-in
          0.35s
          cubic-bezier(0.22, 1, 0.36, 1)
          both;
      }

      @keyframes dayront-page-in {
        from {
          opacity: 0;
          transform: translateY(6px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* =================================================
         WORKSPACE UTILITIES
      ================================================== */

      .workspace-shell {
        width: 100%;
        max-width: var(--workspace-content-width);
        margin-inline: auto;
      }

      .workspace-panel {
        border: 1px solid rgb(229 231 235);
        border-radius: var(--workspace-radius-lg);
        background: #ffffff;
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.03),
          0 10px 35px rgba(0, 0, 0, 0.04);
      }

      html.dark .workspace-panel {
        border-color: rgb(31 41 55);
        background: rgb(17 24 39);
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.2),
          0 15px 45px rgba(0, 0, 0, 0.2);
      }

      .workspace-grid-bg {
        background-image:
          linear-gradient(
            to right,
            rgba(148, 163, 184, 0.08) 1px,
            transparent 1px
          ),
          linear-gradient(
            to bottom,
            rgba(148, 163, 184, 0.08) 1px,
            transparent 1px
          );
        background-size: 32px 32px;
      }

      html.dark .workspace-grid-bg {
        background-image:
          linear-gradient(
            to right,
            rgba(148, 163, 184, 0.035) 1px,
            transparent 1px
          ),
          linear-gradient(
            to bottom,
            rgba(148, 163, 184, 0.035) 1px,
            transparent 1px
          );
      }

      /* =================================================
         SCROLLBAR
      ================================================== */

      * {
        scrollbar-width: thin;
        scrollbar-color:
          rgba(148, 163, 184, 0.55)
          transparent;
      }

      *::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      *::-webkit-scrollbar-track {
        background: transparent;
      }

      *::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.45);
      }

      *::-webkit-scrollbar-thumb:hover {
        background: rgba(148, 163, 184, 0.7);
      }

      /* =================================================
         REDUCED MOTION
      ================================================== */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        body {
          animation: none;
        }
      }
    </style>
  </head>

  <body
    class="min-h-screen flex flex-col bg-white text-black antialiased dark:bg-gray-950 dark:text-white"
  >
    <!-- =================================================
         GLOBAL HEADER
    ================================================== -->

    <Header />

    <!-- =================================================
         BELOW HEADER AD
    ================================================== -->

    <div
      class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8"
    >
      <AdSlot
        position="below-header"
        class="my-2"
      />
    </div>

    <!-- =================================================
         MAIN APPLICATION / MEDIA WORKSPACE
    ================================================== -->

    <main
      id="main-content"
      class="relative flex-1 min-w-0"
    >
      <slot />
    </main>

    <!-- =================================================
         FOOTER
    ================================================== -->

    <Footer />

    <!-- =================================================
         STICKY FOOTER AD
    ================================================== -->

    <AdSlot
      position="sticky-footer"
      class="fixed bottom-0 left-0 right-0 z-40"
    />

    <!-- =================================================
         GLOBAL SEARCH
    ================================================== -->

    <SearchModal items={allSearchItems} />

    <!-- =================================================
         PWA INSTALL BUTTON
    ================================================== -->

    <button
      id="pwa-install-btn"
      type="button"
      aria-label="Install Dayront"
      class="fixed bottom-20 right-4 z-50 hidden items-center gap-2 rounded-full bg-sky px-4 py-2.5 font-semibold text-black shadow-xl transition-all duration-300 hover:-translate-y-0.5 hover:bg-sky-bright"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"
        />
      </svg>

      <span>Install Dayront</span>
    </button>

    <!-- =================================================
         GLOBAL LIVE STATUS
    ================================================== -->

    <div
      id="dayront-live-status"
      class="pointer-events-none fixed bottom-20 left-1/2 z-50 -translate-x-1/2 translate-y-5 opacity-0 transition-all duration-300"
      aria-live="polite"
      aria-atomic="true"
    >
      <div
        class="flex items-center gap-2 rounded-full border border-gray-200 bg-white/95 px-4 py-2 text-xs font-medium text-gray-700 shadow-xl backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/95 dark:text-gray-300"
      >
        <span
          class="h-2 w-2 animate-pulse rounded-full bg-green-500"
        ></span>

        <span id="dayront-live-status-text">
          Ready
        </span>
      </div>
    </div>

    <!-- =================================================
         SERVICE WORKER
    ================================================== -->

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js')
            .catch(() => {
              // Service worker is optional.
            });
        });
      }
    </script>

    <!-- =================================================
         PWA INSTALL
    ================================================== -->

    <script>
      let deferredPrompt = null;

      const installBtn =
        document.getElementById(
          'pwa-install-btn'
        );

      window.addEventListener(
        'beforeinstallprompt',
        (event) => {
          event.preventDefault();

          deferredPrompt = event;

          if (!installBtn) return;

          installBtn.classList.remove('hidden');
          installBtn.classList.add(
            'inline-flex'
          );
        }
      );

      installBtn?.addEventListener(
        'click',
        async () => {
          if (!deferredPrompt) return;

          deferredPrompt.prompt();

          try {
            const { outcome } =
              await deferredPrompt.userChoice;

            if (outcome === 'accepted') {
              installBtn.classList.add(
                'hidden'
              );

              installBtn.classList.remove(
                'inline-flex'
              );
            }
          } catch {
            // Ignore install prompt errors.
          }

          deferredPrompt = null;
        }
      );

      window.addEventListener(
        'appinstalled',
        () => {
          installBtn?.classList.add(
            'hidden'
          );

          installBtn?.classList.remove(
            'inline-flex'
          );

          deferredPrompt = null;
        }
      );
    </script>

    <!-- =================================================
         THEME + ASTRO NAVIGATION
    ================================================== -->

    <script>
      function applyDayrontTheme() {
        try {
          const stored =
            localStorage.getItem('theme');

          const prefersDark =
            window.matchMedia(
              '(prefers-color-scheme: dark)'
            ).matches;

          const theme =
            stored ||
            (prefersDark
              ? 'dark'
              : 'light');

          document.documentElement.classList.toggle(
            'dark',
            theme === 'dark'
          );
        } catch {
          // Ignore.
        }
      }

      document.addEventListener(
        'astro:before-swap',
        () => {
          document.body.style.opacity = '0';
          document.body.style.transition =
            'opacity 0.15s ease-out';
        }
      );

      document.addEventListener(
        'astro:after-swap',
        () => {
          applyDayrontTheme();

          requestAnimationFrame(() => {
            document.body.style.opacity = '1';
            document.body.style.transition =
              'opacity 0.2s ease-out';
          });
        }
      );

      window.addEventListener(
        'storage',
        (event) => {
          if (event.key === 'theme') {
            applyDayrontTheme();
          }
        }
      );
    </script>

    <!-- =================================================
         GLOBAL MEDIA WORKSPACE EVENTS
    ================================================== -->

    <script>
      (() => {
        const status =
          document.getElementById(
            'dayront-live-status'
          );

        const statusText =
          document.getElementById(
            'dayront-live-status-text'
          );

        let statusTimer;

        window.dayrontStatus =
          function showDayrontStatus(
            message
          ) {
            if (!status || !statusText)
              return;

            statusText.textContent =
              message;

            status.classList.remove(
              'translate-y-5',
              'opacity-0'
            );

            status.classList.add(
              'translate-y-0',
              'opacity-100'
            );

            clearTimeout(statusTimer);

            statusTimer = setTimeout(
              () => {
                status.classList.add(
                  'translate-y-5',
                  'opacity-0'
                );

                status.classList.remove(
                  'translate-y-0',
                  'opacity-100'
                );
              },
              3200
            );
          };
      })();
    </script>

    <!-- =================================================
         CONNECTION / ONLINE STATUS
    ================================================== -->

    <script>
      function updateConnectionStatus() {
        if (
          typeof window.dayrontStatus !==
          'function'
        ) {
          return;
        }

        if (navigator.onLine) {
          window.dayrontStatus(
            'You are back online'
          );
        } else {
          window.dayrontStatus(
            'Offline mode — local tools may still work'
          );
        }
      }

      window.addEventListener(
        'online',
        updateConnectionStatus
      );

      window.addEventListener(
        'offline',
        updateConnectionStatus
      );
    </script>
  </body>
</html>