---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import { tools } from '../lib/tools';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  lang?: string;
  toolSlug?: string;
  publishedAt?: string;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  lang: propLang,
  toolSlug,
  publishedAt,
  author,
  noindex,
} = Astro.props;

const lang = propLang || Astro.params.locale || 'en';

let blogItems: any[] = [];
try {
  const blogPosts = await getCollection('blog', (entry) => entry.id.startsWith(`${lang}/`));
  blogItems = blogPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${lang}/${post.id.replace(/\.mdx$/, '').replace(new RegExp(`^${lang}\/`), '')}`,
    type: 'blog',
    icon: '📝',
  }));
} catch {
  blogItems = [];
}

const toolItems = tools.map((tool) => ({
  title: tool.name,
  description: tool.description,
  url: tool.from && tool.to ? `/convert/${tool.slug}` : `/tools/${tool.slug}`,
  type: 'tool',
  icon: tool.icon,
}));

const allSearchItems = [...toolItems, ...blogItems];
---

<!doctype html>
<html lang={lang} style="color-scheme: light dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      toolSlug={toolSlug}
      publishedAt={publishedAt}
      author={author}
      noindex={noindex}
    />

    <!-- ★ ASTRO CLIENT ROUTER — instant client-side navigation + View Transitions -->
    <ClientRouter />

    <script type="importmap">
    {
      "imports": {
        "onnxruntime-web": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.mjs",
        "onnxruntime-web/wasm": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.wasm.min.mjs",
        "onnxruntime-web/webgpu": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgpu.min.mjs",
        "onnxruntime-web/webgl": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgl.min.mjs",
        "@huggingface/transformers": "https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.2.0/+esm",
        "@imgly/background-removal": "https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm"
      }
    }
    </script>

    <!-- ═══════════════════════════════════════════════════════════
         THEME BOOT — runs before first paint, reads the user's
         saved theme from the unified settings store.
         Prevents the "flash of wrong theme" on every page load.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      (() => {
        const SETTINGS_KEY = 'dayront:settings:v1';
        let theme = 'auto';

        try {
          const raw = localStorage.getItem(SETTINGS_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed.theme === 'string') {
              theme = parsed.theme;
            }
          }
        } catch {}

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = theme === 'dark' || (theme === 'auto' && prefersDark);
        document.documentElement.classList.toggle('dark', isDark);

        // Follow system changes only when theme is 'auto'
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
            let current = 'auto';
            try {
              const raw = localStorage.getItem(SETTINGS_KEY);
              if (raw) {
                const parsed = JSON.parse(raw);
                if (parsed && typeof parsed.theme === 'string') current = parsed.theme;
              }
            } catch {}
            if (current === 'auto') {
              document.documentElement.classList.toggle('dark', e.matches);
            }
          });
        } catch {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/icon-96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/icons/icon-144.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />

    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />

    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content="#2CB5F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C4A6E" media="(prefers-color-scheme: dark)" />

    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Dayront" />

    <script src="/i18n.js" defer></script>

    <!-- ═══════════════════════════════════════════════════════════
         LANGUAGE BOOT — reads from the unified settings store,
         falls back to legacy keys, then to 'en'.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      (() => {
        const SETTINGS_KEY = 'dayront:settings:v1';
        const supportedLocales = ['en', 'es', 'pt', 'de', 'fr', 'ja'];
        const pathSegments = window.location.pathname.split('/').filter(Boolean);

        let lang = 'en';

        // 1. URL prefix takes priority
        if (supportedLocales.includes(pathSegments[0])) {
          lang = pathSegments[0];
        } else {
          // 2. Unified settings store
          try {
            const raw = localStorage.getItem(SETTINGS_KEY);
            if (raw) {
              const parsed = JSON.parse(raw);
              if (parsed && typeof parsed.lang === 'string' && supportedLocales.includes(parsed.lang)) {
                lang = parsed.lang;
              }
            }
          } catch {}

          // 3. Legacy keys (in case settings store is empty)
          if (lang === 'en') {
            try {
              const legacy = localStorage.getItem('dayront:dayront-lang')
                || localStorage.getItem('dayront:lang');
              if (legacy && supportedLocales.includes(legacy)) lang = legacy;
            } catch {}
          }
        }

        document.documentElement.lang = lang;

        document.querySelectorAll('#lang-select, #lang-select-mobile').forEach((sel) => {
          if (sel) sel.value = lang;
        });
      })();
    </script>

    <slot name="head" />
  </head>

  <body
    data-shell="web"
    class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-black dark:text-white antialiased"
  >
    <Header lang={lang} />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <AdSlot position="below-header" class="my-3 md:my-4" />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <AdSlot position="sticky-footer" class="fixed bottom-0 left-0 right-0 z-40" />

    <SearchModal items={allSearchItems} />

    <a
      id="install-arrow-btn"
      href="https://download.dayront.com"
      rel="noopener"
      aria-label="Get the Dayront app for bigger files"
      title="Get the app for bigger files"
      class="install-arrow-btn"
      hidden
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <path d="M7 10l5 5 5-5" />
        <path d="M12 15V3" />
      </svg>
    </a>

    <script>
      (() => {
        if (!('serviceWorker' in navigator)) return;

        navigator.serviceWorker.addEventListener('controllerchange', () => {
          window.location.reload();
        });

        window.addEventListener('load', async () => {
          try {
            const registration = await navigator.serviceWorker.register('/sw.js', {
              scope: '/',
              updateViaCache: 'none',
            });
            await registration.update();
            if (registration.waiting) {
              registration.waiting.postMessage({ type: 'SKIP_WAITING' });
            }
          } catch (error) {
            console.warn('Dayront SW registration failed:', error);
          }
        });
      })();
    </script>

    <script>
      (() => {
        const btn = document.getElementById('install-arrow-btn');
        if (!btn) return;

        const w = window;
        const isNative =
          w.Capacitor?.isNativePlatform?.() === true ||
          w.__TAURI__ !== undefined;
        if (isNative) return;

        const path = location.pathname;
        const isToolPage = path.startsWith('/tools/') || path.startsWith('/convert/');
        if (!isToolPage) return;

        if (path === '/download' || path.startsWith('/download/')) return;
        const host = location.hostname;
        if (host === 'download.dayront.com' || host === 'www.download.dayront.com') {
          return;
        }

        const SEEN_KEY = 'dayront:install-arrow-seen:v1';
        let alreadySeen = false;
        try {
          alreadySeen = !!localStorage.getItem(SEEN_KEY);
        } catch {}
        if (alreadySeen) return;

        setTimeout(() => {
          btn.hidden = false;
          requestAnimationFrame(() => {
            btn.setAttribute('data-visible', 'true');
          });
          try {
            localStorage.setItem(SEEN_KEY, Date.now().toString());
          } catch {}
        }, 2200);

        btn.addEventListener('click', () => {
          try {
            localStorage.setItem(SEEN_KEY, Date.now().toString());
          } catch {}
        });
      })();
    </script>

    <SpeedInsights />
    <Analytics />
  </body>
</html>

<style is:global>
  body { padding-bottom: 64px; }
  @media (min-width: 768px) { body { padding-bottom: 96px; } }

  /* Non-mobile pages keep a subtle fade; mobile shell handles its own transitions */
  body[data-shell="web"] {
    animation: dayront-page-fade-in 0.3s ease-out;
  }
  @keyframes dayront-page-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    body[data-shell="web"] { animation: none; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ── Install arrow ── */
  .install-arrow-btn {
    position: fixed;
    right: 1.25rem;
    bottom: 5.5rem;
    z-index: 45;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%);
    color: #ffffff;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(44, 181, 240, 0.42), 0 2px 6px rgba(15, 23, 42, 0.12);
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
    animation: install-arrow-pulse 2.6s ease-in-out infinite;
    animation-play-state: paused;
  }
  .install-arrow-btn[data-visible="true"] {
    opacity: 1;
    transform: scale(1);
    animation-play-state: running;
  }
  .install-arrow-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 12px 28px rgba(44, 181, 240, 0.55), 0 4px 10px rgba(15, 23, 42, 0.15);
    animation-play-state: paused;
  }
  .install-arrow-btn:active { transform: scale(0.95); }
  @keyframes install-arrow-pulse {
    0%, 100% { box-shadow: 0 8px 20px rgba(44, 181, 240, 0.42), 0 2px 6px rgba(15, 23, 42, 0.12); }
    50%      { box-shadow: 0 10px 26px rgba(44, 181, 240, 0.65), 0 2px 6px rgba(15, 23, 42, 0.12); }
  }
  @supports (padding: max(0px)) {
    .install-arrow-btn { bottom: max(5.5rem, calc(4.5rem + env(safe-area-inset-bottom))); }
  }
  @media (min-width: 768px) {
    .install-arrow-btn { right: 1.5rem; bottom: 6.5rem; width: 52px; height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .install-arrow-btn { animation: none; transition: opacity 0.2s ease; }
    .install-arrow-btn[data-visible="true"] { transform: none; }
    .install-arrow-btn:hover { transform: none; }
  }

  /* ── Notify form ── */
  .notify-form { display: flex; flex-direction: column; gap: 0.625rem; width: 100%; max-width: 520px; margin: 0 auto; }
  .notify-form__honeypot { position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; padding: 0 !important; margin: -1px !important; }
  .notify-form__row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  @media (min-width: 480px) { .notify-form__row { flex-wrap: nowrap; } }
  .notify-form__input { flex: 1 1 220px; min-width: 0; padding: 0.75rem 1rem; min-height: 48px; border-radius: 10px; border: 1px solid #cbd5e1; background: #ffffff; color: #0f172a; font-size: 0.95rem; font-family: inherit; transition: border-color 0.15s ease, box-shadow 0.15s ease; }
  .notify-form__input::placeholder { color: #94a3b8; }
  .notify-form__input:focus { outline: none; border-color: #2CB5F0; box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.18); }
  .notify-form__input:disabled { background: #f1f5f9; opacity: 0.7; cursor: not-allowed; }
  .notify-form__button { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.75rem 1.5rem; min-height: 48px; border: none; border-radius: 10px; background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%); color: #ffffff; font-weight: 700; font-size: 0.95rem; font-family: inherit; cursor: pointer; box-shadow: 0 4px 14px rgba(44, 181, 240, 0.32); transition: all 0.15s ease; white-space: nowrap; }
  .notify-form__button:hover:not(:disabled) { box-shadow: 0 6px 22px rgba(44, 181, 240, 0.45); transform: translateY(-1px); }
  .notify-form__button:active:not(:disabled) { transform: scale(0.98); }
  .notify-form__button:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
  .notify-form__spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255, 255, 255, 0.35); border-top-color: #ffffff; border-radius: 50%; animation: notify-spin 0.7s linear infinite; }
  @keyframes notify-spin { to { transform: rotate(360deg); } }
  .notify-form__message { font-size: 0.85rem; line-height: 1.5; padding: 0.6rem 0.85rem; border-radius: 8px; text-align: left; }
  .notify-form__message--success { background: #DCFCE7; color: #166534; border: 1px solid #86EFAC; }
  .notify-form__message--error { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }
  .notify-form__fineprint { margin: 0; font-size: 0.75rem; color: #64748b; text-align: center; line-height: 1.5; }
  .dark .notify-form__input { background: #0f172a; color: #e2e8f0; border-color: #334155; }
  .dark .notify-form__input::placeholder { color: #64748b; }
  .dark .notify-form__input:focus { border-color: #2CB5F0; box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.25); }
  .dark .notify-form__input:disabled { background: #1e293b; }
  .dark .notify-form__button { background: linear-gradient(135deg, #2CB5F0 0%, #38BDF8 100%); }
  .dark .notify-form__message--success { background: #052e16; color: #86EFAC; border-color: #166534; }
  .dark .notify-form__message--error { background: #450a0a; color: #FCA5A5; border-color: #991B1B; }
  .dark .notify-form__fineprint { color: #94a3b8; }
</style>