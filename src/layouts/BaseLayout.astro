---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import { getCollection } from 'astro:content';
import { tools } from '../lib/tools';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  lang?: string;
}

const { title, description, ogImage, canonicalURL, lang: propLang } = Astro.props;
const lang = propLang || Astro.params.locale || 'en';

let blogItems: any[] = [];
try {
  const blogPosts = await getCollection('blog', (entry) => entry.id.startsWith(`${lang}/`));
  blogItems = blogPosts.map(post => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${lang}/${post.id.replace(/\.mdx$/, '').replace(new RegExp(`^${lang}\/`), '')}`,
    type: 'blog',
    icon: '📝',
  }));
} catch {
  blogItems = [];
}

const toolItems = tools.map(tool => ({
  title: tool.name,
  description: tool.description,
  url: tool.from && tool.to ? `/convert/${tool.slug}` : `/tools/${tool.slug}`,
  type: 'tool',
  icon: tool.icon,
}));

const allSearchItems = [...toolItems, ...blogItems];
---

<!doctype html>
<html lang={lang} style="color-scheme: light dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />

    <!-- ★ IMPORT MAP — resolves bare module specifiers for CDN-loaded libs ★ -->
    <script type="importmap">
    {
      "imports": {
        "onnxruntime-web": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.mjs",
        "onnxruntime-web/wasm": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.wasm.min.mjs",
        "onnxruntime-web/webgpu": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgpu.min.mjs",
        "onnxruntime-web/webgl": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgl.min.mjs",
        "@huggingface/transformers": "https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.2.0/+esm",
        "@imgly/background-removal": "https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm"
      }
    }
    </script>
    <!-- ★ END IMPORT MAP ★ -->

    <!-- Theme – device preference only -->
    <script is:inline>
      (() => {
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = (e) => {
          document.documentElement.classList.toggle('dark', e.matches);
        };
        apply(mq);
        mq.addEventListener('change', apply);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- ════════════════════════════════════════════════════
         PWA — icons, manifest, meta
         ════════════════════════════════════════════════════ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content="#2CB5F0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Dayront" />

    <script src="/i18n.js" defer></script>

    <script is:inline>
      (() => {
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const supportedLocales = ['en', 'es', 'pt', 'de', 'fr', 'ja'];
        let lang = 'en';

        if (supportedLocales.includes(pathSegments[0])) {
          lang = pathSegments[0];
        } else {
          lang = localStorage.getItem('dayront-lang') || 'en';
        }

        document.documentElement.lang = lang;

        document.querySelectorAll('#lang-select, #lang-select-mobile').forEach(sel => {
          if (sel) sel.value = lang;
        });
      })();
    </script>

    <slot name="head" />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-black dark:text-white antialiased transition-colors duration-200"
  >
    <Header lang={lang} />

    <!-- ★ AD SLOT — Below Header (rotates every few seconds) ★ -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <AdSlot position="below-header" class="my-3 md:my-4" />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- ★ AD SLOT — Sticky Footer (fixed to bottom of viewport, always visible) ★ -->
    <AdSlot position="sticky-footer" class="fixed bottom-0 left-0 right-0 z-40" />

    <SearchModal items={allSearchItems} />

    <button
      id="pwa-install-btn"
      type="button"
      aria-label="Install Dayront"
      class="fixed bottom-20 right-4 z-50 bg-sky text-black font-semibold px-4 py-2 rounded-full shadow-lg hover:bg-sky-bright transition-all duration-300 hidden items-center gap-2"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
      </svg>
      Install Dayront
    </button>

    <!-- ════════════════════════════════════════════════════
         SERVICE WORKER REGISTRATION
         ════════════════════════════════════════════════════ -->
    <script>
      (() => {
        if (!('serviceWorker' in navigator)) return;

        navigator.serviceWorker.addEventListener('controllerchange', () => {
          window.location.reload();
        });

        window.addEventListener('load', async () => {
          try {
            const registration = await navigator.serviceWorker.register('/sw.js', {
              scope: '/',
              updateViaCache: 'none',
            });
            await registration.update();
            if (registration.waiting) {
              registration.waiting.postMessage({ type: 'SKIP_WAITING' });
            }
          } catch (error) {
            console.warn('Dayront SW registration failed:', error);
          }
        });
      })();
    </script>

    <!-- ════════════════════════════════════════════════════
         PWA INSTALL PROMPT
         ════════════════════════════════════════════════════ -->
    <script>
      (() => {
        let deferredPrompt = null;
        const installButton = document.getElementById('pwa-install-btn');
        if (!installButton) return;

        window.addEventListener('beforeinstallprompt', (event) => {
          event.preventDefault();
          deferredPrompt = event;
          installButton.classList.remove('hidden');
          installButton.classList.add('inline-flex');
        });

        installButton.addEventListener('click', async () => {
          if (!deferredPrompt) return;
          try {
            deferredPrompt.prompt();
            const result = await deferredPrompt.userChoice;
            if (result?.outcome === 'accepted') {
              installButton.classList.add('hidden');
              installButton.classList.remove('inline-flex');
            }
          } catch (error) {
            console.warn('Dayront install prompt failed:', error);
          }
          deferredPrompt = null;
        });

        window.addEventListener('appinstalled', () => {
          installButton.classList.add('hidden');
          installButton.classList.remove('inline-flex');
          deferredPrompt = null;
        });
      })();
    </script>

    <SpeedInsights />
    <Analytics />
  </body>
</html>

<style is:global>
  /* ════════════════════════════════════════════════════════
     GLOBAL LAYOUT STYLES
     ════════════════════════════════════════════════════════ */

  /* Reserve space for sticky footer ad */
  body {
    padding-bottom: 64px;
  }

  @media (min-width: 768px) {
    body {
      padding-bottom: 96px;
    }
  }

  body {
    animation: dayront-page-fade-in 0.3s ease-out;
  }

  @keyframes dayront-page-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      animation: none;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ════════════════════════════════════════════════════════
     NOTIFY FORM — global so any page can drop in <NotifyForm />
     ════════════════════════════════════════════════════════ */

  .notify-form {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  /* Honeypot — invisible to humans, visible to bots */
  .notify-form__honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
    padding: 0 !important;
    margin: -1px !important;
  }

  .notify-form__row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 480px) {
    .notify-form__row { flex-wrap: nowrap; }
  }

  .notify-form__input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 0.75rem 1rem;
    min-height: 48px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .notify-form__input::placeholder { color: #94a3b8; }
  .notify-form__input:focus {
    outline: none;
    border-color: #2CB5F0;
    box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.18);
  }
  .notify-form__input:disabled {
    background: #f1f5f9;
    opacity: 0.7;
    cursor: not-allowed;
  }

  .notify-form__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    min-height: 48px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(44, 181, 240, 0.32);
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .notify-form__button:hover:not(:disabled) {
    box-shadow: 0 6px 22px rgba(44, 181, 240, 0.45);
    transform: translateY(-1px);
  }
  .notify-form__button:active:not(:disabled) { transform: scale(0.98); }
  .notify-form__button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .notify-form__spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: notify-spin 0.7s linear infinite;
  }
  @keyframes notify-spin { to { transform: rotate(360deg); } }

  .notify-form__message {
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    text-align: left;
  }
  .notify-form__message--success {
    background: #DCFCE7;
    color: #166534;
    border: 1px solid #86EFAC;
  }
  .notify-form__message--error {
    background: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FCA5A5;
  }

  .notify-form__fineprint {
    margin: 0;
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .notify-form__input {
      background: #0f172a;
      color: #e2e8f0;
      border-color: #334155;
    }
    .notify-form__input::placeholder { color: #64748b; }
    .notify-form__input:focus {
      border-color: #2CB5F0;
      box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.25);
    }
    .notify-form__input:disabled { background: #1e293b; }

    .notify-form__button {
      background: linear-gradient(135deg, #2CB5F0 0%, #38BDF8 100%);
    }

    .notify-form__message--success {
      background: #052e16;
      color: #86EFAC;
      border-color: #166534;
    }
    .notify-form__message--error {
      background: #450a0a;
      color: #FCA5A5;
      border-color: #991B1B;
    }

    .notify-form__fineprint { color: #94a3b8; }
  }
</style>

<script>
  document.addEventListener('astro:before-swap', () => {
    document.body.style.opacity = '0';
    document.body.style.transition = 'opacity 0.15s ease-out';
  });

  document.addEventListener('astro:after-swap', () => {
    document.body.style.opacity = '1';
    document.body.style.transition = 'opacity 0.15s ease-out';

    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', isDark);
  });
</script>