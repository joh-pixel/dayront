---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/shared/SeoHead.astro';
import AdSlot from '../components/layout/AdSlot.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import FirstRunWelcome from '../components/ui/FirstRunWelcome.tsx';
import { getCollection } from 'astro:content';
import { tools } from '../lib/tools';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  lang?: string;
  // ★ SEO pass-through
  toolSlug?: string;
  publishedAt?: string;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  lang: propLang,
  toolSlug,
  publishedAt,
  author,
  noindex,
} = Astro.props;

const lang = propLang || Astro.params.locale || 'en';

let blogItems: any[] = [];
try {
  const blogPosts = await getCollection('blog', (entry) => entry.id.startsWith(`${lang}/`));
  blogItems = blogPosts.map(post => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${lang}/${post.id.replace(/\.mdx$/, '').replace(new RegExp(`^${lang}\/`), '')}`,
    type: 'blog',
    icon: '📝',
  }));
} catch {
  blogItems = [];
}

const toolItems = tools.map(tool => ({
  title: tool.name,
  description: tool.description,
  url: tool.from && tool.to ? `/convert/${tool.slug}` : `/tools/${tool.slug}`,
  type: 'tool',
  icon: tool.icon,
}));

const allSearchItems = [...toolItems, ...blogItems];
---

<!doctype html>
<html lang={lang} style="color-scheme: light dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SeoHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      toolSlug={toolSlug}
      publishedAt={publishedAt}
      author={author}
      noindex={noindex}
    />

    <!-- ★ IMPORT MAP — resolves bare module specifiers for CDN-loaded libs ★ -->
    <script type="importmap">
    {
      "imports": {
        "onnxruntime-web": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.mjs",
        "onnxruntime-web/wasm": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.wasm.min.mjs",
        "onnxruntime-web/webgpu": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgpu.min.mjs",
        "onnxruntime-web/webgl": "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.webgl.min.mjs",
        "@huggingface/transformers": "https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.2.0/+esm",
        "@imgly/background-removal": "https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm"
      }
    }
    </script>
    <!-- ★ END IMPORT MAP ★ -->

    <!-- Theme – device preference only -->
    <script is:inline>
      (() => {
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = (e) => {
          document.documentElement.classList.toggle('dark', e.matches);
        };
        apply(mq);
        mq.addEventListener('change', apply);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- ════════════════════════════════════════════════════
         PWA — expanded icon set, manifest, theme colors
         ════════════════════════════════════════════════════ -->

    <!-- SVG favicon (modern browsers) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PNG favicons (multi-size fallback) -->
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/icons/icon-96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/icons/icon-144.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />

    <!-- Apple touch icons (iOS home screen) -->
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Theme color (adapts to system light/dark) -->
    <meta name="theme-color" content="#2CB5F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C4A6E" media="(prefers-color-scheme: dark)" />

    <!-- Web app capability hints -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Dayront" />

    <script src="/i18n.js" defer></script>

    <script is:inline>
      (() => {
        const pathSegments = window.location.pathname.split('/').filter(Boolean);
        const supportedLocales = ['en', 'es', 'pt', 'de', 'fr', 'ja'];
        let lang = 'en';

        if (supportedLocales.includes(pathSegments[0])) {
          lang = pathSegments[0];
        } else {
          lang = localStorage.getItem('dayront-lang') || 'en';
        }

        document.documentElement.lang = lang;

        document.querySelectorAll('#lang-select, #lang-select-mobile').forEach(sel => {
          if (sel) sel.value = lang;
        });
      })();
    </script>

    <slot name="head" />
  </head>

  <body
    class="min-h-screen flex flex-col bg-white dark:bg-gray-950 text-black dark:text-white antialiased transition-colors duration-200"
  >
    <Header lang={lang} />

    <!-- ★ AD SLOT — Below Header (rotates every few seconds) ★ -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <AdSlot position="below-header" class="my-3 md:my-4" />
    </div>

    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- ★ AD SLOT — Sticky Footer (fixed to bottom of viewport, always visible) ★ -->
    <AdSlot position="sticky-footer" class="fixed bottom-0 left-0 right-0 z-40" />

    <!-- ★ First-run welcome toast — shows once per browser ★ -->
    <FirstRunWelcome client:load />

    <SearchModal items={allSearchItems} />

    <!-- ════════════════════════════════════════════════════
         FLOATING INSTALL BUTTON — links to download subdomain
         ════════════════════════════════════════════════════ -->
    <a
      id="pwa-install-btn"
      href="https://download.dayront.com"
      rel="noopener"
      aria-label="Install Dayront"
      class="pwa-float-btn hidden"
    >
      <svg class="pwa-float-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
      </svg>
      <span>Install Dayront</span>
    </a>

    <!-- ════════════════════════════════════════════════════
         SERVICE WORKER REGISTRATION
         ════════════════════════════════════════════════════ -->
    <script>
      (() => {
        if (!('serviceWorker' in navigator)) return;

        navigator.serviceWorker.addEventListener('controllerchange', () => {
          window.location.reload();
        });

        window.addEventListener('load', async () => {
          try {
            const registration = await navigator.serviceWorker.register('/sw.js', {
              scope: '/',
              updateViaCache: 'none',
            });
            await registration.update();
            if (registration.waiting) {
              registration.waiting.postMessage({ type: 'SKIP_WAITING' });
            }
          } catch (error) {
            console.warn('Dayront SW registration failed:', error);
          }
        });
      })();
    </script>

    <!-- ════════════════════════════════════════════════════
         FLOATING BUTTON VISIBILITY
         ════════════════════════════════════════════════════ -->
    <script>
      (() => {
        const btn = document.getElementById('pwa-install-btn');
        if (!btn) return;

        const host = location.hostname;
        if (host === 'download.dayront.com' || host === 'www.download.dayront.com') {
          return;
        }

        if (location.pathname === '/download') {
          return;
        }

        setTimeout(() => {
          btn.classList.remove('hidden');
          btn.classList.add('pwa-float-btn--visible');
        }, 1200);
      })();
    </script>

    <SpeedInsights />
    <Analytics />
  </body>
</html>

<style is:global>
  /* ════════════════════════════════════════════════════════
     GLOBAL LAYOUT STYLES
     ════════════════════════════════════════════════════════ */

  /* Reserve space for sticky footer ad */
  body {
    padding-bottom: 64px;
  }

  @media (min-width: 768px) {
    body {
      padding-bottom: 96px;
    }
  }

  body {
    animation: dayront-page-fade-in 0.3s ease-out;
  }

  @keyframes dayront-page-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      animation: none;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* ════════════════════════════════════════════════════════
     FLOATING INSTALL BUTTON
     ════════════════════════════════════════════════════════ */

  .pwa-float-btn {
    position: fixed;
    right: 1rem;
    bottom: 5rem;
    z-index: 45;

    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;

    background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: inherit;
    text-decoration: none;
    white-space: nowrap;

    box-shadow:
      0 8px 24px rgba(44, 181, 240, 0.42),
      0 2px 6px rgba(15, 23, 42, 0.12);

    transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.3s ease;
    opacity: 0;
    pointer-events: none;
  }

  .pwa-float-btn--visible {
    opacity: 1;
    pointer-events: auto;
  }

  .pwa-float-btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 12px 32px rgba(44, 181, 240, 0.55),
      0 4px 10px rgba(15, 23, 42, 0.15);
  }

  .pwa-float-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .pwa-float-btn__icon {
    flex-shrink: 0;
  }

  /* Safe area for iPhone home indicator */
  @supports (padding: max(0px)) {
    .pwa-float-btn {
      bottom: max(5rem, calc(4rem + env(safe-area-inset-bottom)));
    }
  }

  @media (min-width: 768px) {
    .pwa-float-btn {
      right: 1.5rem;
      bottom: 6rem;
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
    }
  }

  /* Reduce motion */
  @media (prefers-reduced-motion: reduce) {
    .pwa-float-btn {
      transition: opacity 0.2s ease;
    }
    .pwa-float-btn:hover {
      transform: none;
    }
  }

  /* ════════════════════════════════════════════════════════
     FIRST-RUN WELCOME TOAST
     ════════════════════════════════════════════════════════ */

  .first-run-toast {
    position: fixed;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%) translateY(0);
    z-index: 44;

    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.75rem 0.875rem;
    align-items: flex-start;

    width: calc(100% - 2rem);
    max-width: 420px;
    padding: 1rem 1rem 0.875rem;

    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow:
      0 20px 50px -12px rgba(44, 181, 240, 0.25),
      0 8px 20px -8px rgba(15, 23, 42, 0.12);

    animation: first-run-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .first-run-toast--out {
    transform: translateX(-50%) translateY(16px);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes first-run-in {
    from {
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
  }

  .first-run-toast__icon {
    grid-row: 1 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #e5f7fe;
    flex-shrink: 0;
  }

  .first-run-toast__body {
    grid-column: 2 / 3;
    min-width: 0;
  }

  .first-run-toast__title {
    font-size: 0.92rem;
    font-weight: 800;
    color: #0c4a6e;
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  .first-run-toast__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.78rem;
    color: #334155;
    line-height: 1.45;
  }

  .first-run-toast__list li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .first-run-toast__list span {
    flex-shrink: 0;
    font-size: 0.75rem;
    line-height: 1;
  }

  .first-run-toast__close {
    grid-row: 1 / 2;
    grid-column: 3 / 4;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #94a3b8;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .first-run-toast__close:hover {
    background: #f1f5f9;
    color: #475569;
  }

  .first-run-toast__cta {
    grid-row: 2 / 3;
    grid-column: 3 / 4;
    align-self: end;
    padding: 0.45rem 0.9rem;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #2cb5f0, #0ea5e9);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.1s ease;
    white-space: nowrap;
    box-shadow: 0 3px 10px rgba(44, 181, 240, 0.28);
  }

  .first-run-toast__cta:hover { opacity: 0.92; }
  .first-run-toast__cta:active { transform: scale(0.97); }

  @media (min-width: 640px) {
    .first-run-toast {
      left: 1rem;
      bottom: 1.5rem;
      transform: none;
      width: 100%;
      max-width: 380px;
    }
    .first-run-toast--out {
      transform: translateY(16px);
    }
    @keyframes first-run-in {
      from {
        transform: translateY(20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
  }

  @media (prefers-color-scheme: dark) {
    .first-run-toast {
      background: #0f172a;
      border-color: #1e293b;
      box-shadow:
        0 20px 50px -12px rgba(44, 181, 240, 0.35),
        0 8px 20px -8px rgba(0, 0, 0, 0.5);
    }
    .first-run-toast__icon { background: #0c2a42; }
    .first-run-toast__title { color: #c7ebfc; }
    .first-run-toast__list { color: #cbd5e1; }
    .first-run-toast__close { color: #64748b; }
    .first-run-toast__close:hover { background: #1e293b; color: #cbd5e1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .first-run-toast,
    .first-run-toast--out {
      animation: none;
      transition: opacity 0.15s ease;
    }
  }

  /* ════════════════════════════════════════════════════════
     NOTIFY FORM — global so any page can drop in <NotifyForm />
     ════════════════════════════════════════════════════════ */

  .notify-form {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
  }

  /* Honeypot — invisible to humans, visible to bots */
  .notify-form__honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
    padding: 0 !important;
    margin: -1px !important;
  }

  .notify-form__row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 480px) {
    .notify-form__row { flex-wrap: nowrap; }
  }

  .notify-form__input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 0.75rem 1rem;
    min-height: 48px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .notify-form__input::placeholder { color: #94a3b8; }
  .notify-form__input:focus {
    outline: none;
    border-color: #2CB5F0;
    box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.18);
  }
  .notify-form__input:disabled {
    background: #f1f5f9;
    opacity: 0.7;
    cursor: not-allowed;
  }

  .notify-form__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    min-height: 48px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(44, 181, 240, 0.32);
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .notify-form__button:hover:not(:disabled) {
    box-shadow: 0 6px 22px rgba(44, 181, 240, 0.45);
    transform: translateY(-1px);
  }
  .notify-form__button:active:not(:disabled) { transform: scale(0.98); }
  .notify-form__button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    transform: none;
  }

  .notify-form__spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: notify-spin 0.7s linear infinite;
  }
  @keyframes notify-spin { to { transform: rotate(360deg); } }

  .notify-form__message {
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 0.6rem 0.85rem;
    border-radius: 8px;
    text-align: left;
  }
  .notify-form__message--success {
    background: #DCFCE7;
    color: #166534;
    border: 1px solid #86EFAC;
  }
  .notify-form__message--error {
    background: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FCA5A5;
  }

  .notify-form__fineprint {
    margin: 0;
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .notify-form__input {
      background: #0f172a;
      color: #e2e8f0;
      border-color: #334155;
    }
    .notify-form__input::placeholder { color: #64748b; }
    .notify-form__input:focus {
      border-color: #2CB5F0;
      box-shadow: 0 0 0 3px rgba(44, 181, 240, 0.25);
    }
    .notify-form__input:disabled { background: #1e293b; }

    .notify-form__button {
      background: linear-gradient(135deg, #2CB5F0 0%, #38BDF8 100%);
    }

    .notify-form__message--success {
      background: #052e16;
      color: #86EFAC;
      border-color: #166534;
    }
    .notify-form__message--error {
      background: #450a0a;
      color: #FCA5A5;
      border-color: #991B1B;
    }

    .notify-form__fineprint { color: #94a3b8; }
  }
</style>

<script>
  document.addEventListener('astro:before-swap', () => {
    document.body.style.opacity = '0';
    document.body.style.transition = 'opacity 0.15s ease-out';
  });

  document.addEventListener('astro:after-swap', () => {
    document.body.style.opacity = '1';
    document.body.style.transition = 'opacity 0.15s ease-out';

    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', isDark);

    const btn = document.getElementById('pwa-install-btn');
    if (btn) {
      const host = location.hostname;
      const onDownloadHost =
        host === 'download.dayront.com' ||
        host === 'www.download.dayront.com';
      const onDownloadPage = location.pathname === '/download';

      if (onDownloadHost || onDownloadPage) {
        btn.classList.add('hidden');
        btn.classList.remove('pwa-float-btn--visible');
      } else {
        btn.classList.remove('hidden');
        btn.classList.add('pwa-float-btn--visible');
      }
    }
  });
</script>