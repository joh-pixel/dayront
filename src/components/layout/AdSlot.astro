---
import { getActiveAds } from '../../lib/ads';
import AdTracker from './AdTracker.astro';

export interface Props {
  position: 'sticky-footer' | 'below-tool' | 'in-content' | 'below-header';
  class?: string;
  pauseOnHover?: boolean;
}

const { position, class: className = '', pauseOnHover = true } = Astro.props;

const dimensionsMap = {
  'sticky-footer':   'h-[60px] md:h-[90px]',
  'below-tool':      'h-[90px] md:h-[120px]',
  'in-content':      'h-[250px] md:h-[280px]',
  'below-header':    'h-[50px] md:h-[60px]',
};

const reservedHeight = dimensionsMap[position];
const ads = getActiveAds(position);
const slideshowId = `adslot-${position}-${Math.random().toString(36).slice(2, 8)}`;
---

{ads.length === 0 && (
  <a
    href="/advertise"
    class:list={[
      'adslot group relative w-full overflow-hidden rounded-xl',
      'flex items-center justify-center',
      'border border-sky-200/60 dark:border-sky-500/20',
      'transition-all duration-300 hover:scale-[1.005] hover:border-sky-400',
      'hover:shadow-lg hover:shadow-sky-500/20',
      reservedHeight,
      className,
    ]}
    data-ad-position={position}
    aria-label="Advertise with us on Dayront"
  >
    <div class="absolute inset-0 adslot-bg" aria-hidden="true"></div>
    <div class="absolute inset-0 adslot-shimmer" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-10 -right-10 w-40 h-40 rounded-full bg-sky-400/20 blur-3xl transition-transform duration-700 group-hover:scale-150" aria-hidden="true"></div>

    <div class="relative flex items-center gap-3 md:gap-4 px-4 md:px-6">
      <span class="relative shrink-0 flex items-center justify-center w-9 h-9 md:w-11 md:h-11 rounded-xl bg-gradient-to-br from-sky-400 to-sky-600 text-white shadow-md shadow-sky-500/40 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-[-4deg]" aria-hidden="true">
        <span class="absolute inset-0 rounded-xl bg-sky-400/50 adslot-ping"></span>
        <svg class="relative w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 0 1-3.417.592l-2.147-6.15M18 13a3 3 0 1 0 0-6M5.436 13.683A4.001 4.001 0 0 1 7 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 0 1-1.564-.317z"/>
        </svg>
      </span>

      <div class="min-w-0 flex flex-col leading-tight gap-0.5">
        <span class="flex items-center gap-1.5 text-[9px] md:text-[10px] font-black uppercase tracking-[0.15em] text-sky-600 dark:text-sky-400">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-sky-500"></span>
          </span>
          Advertise with us
        </span>
        <span class="text-[13px] md:text-[15px] font-extrabold text-gray-900 dark:text-white truncate tracking-tight">
          Reach creators who <span class="text-sky-500">care about their craft.</span>
        </span>
      </div>

      <span class="hidden sm:inline-flex shrink-0 items-center gap-1.5 ml-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-3 py-1.5 text-[11px] md:text-xs font-bold whitespace-nowrap transition-all duration-300 group-hover:bg-sky-500 group-hover:text-white group-hover:gap-2.5">
        Learn more
        <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
)}

{ads.length > 0 && (
  <div
    id={slideshowId}
    class:list={[
      'adslot-slideshow group relative w-full overflow-hidden rounded-xl',
      'border border-gray-200 dark:border-gray-800',
      'bg-white dark:bg-gray-900',
      'transition-all duration-200 hover:border-sky-400 hover:shadow-md',
      reservedHeight,
      className,
    ]}
    data-position={position}
    data-count={ads.length}
    data-pause-on-hover={pauseOnHover ? 'true' : 'false'}
  >
    {ads.map((ad, index) => (
      <a
        href={ad.href}
        class:list={[
          'adslot-slide absolute inset-0 flex items-center justify-center',
          index === 0 ? 'is-active' : '',
        ]}
        data-slide-index={index}
        data-ad-id={ad.id}
        data-advertiser={ad.advertiser}
        data-duration={ad.duration ?? 6}
        data-is-dayront={ad.isDayront ? 'true' : 'false'}
        target={ad.isDayront ? undefined : '_blank'}
        rel={ad.isDayront ? undefined : 'noopener sponsored'}
        aria-label={`Advertisement from ${ad.advertiser}`}
      >
        {ad.label && (
          <span class="absolute top-1 right-2 z-10 text-[9px] font-black uppercase tracking-widest text-gray-500 dark:text-gray-400 bg-white/85 dark:bg-gray-900/85 backdrop-blur-sm px-1.5 py-0.5 rounded">
            {ad.label}
          </span>
        )}

        {ad.image && (
          <img
            src={ad.image}
            alt={ad.alt}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        )}

        {!ad.image && ad.isDayront && (
          <div class="absolute inset-0 flex items-center">
            <div class="absolute inset-0 adslot-bg" aria-hidden="true"></div>
            <div class="absolute inset-0 adslot-shimmer" aria-hidden="true"></div>
            <div class="pointer-events-none absolute -top-10 -right-10 w-40 h-40 rounded-full bg-sky-400/20 blur-3xl transition-transform duration-700 group-hover:scale-150" aria-hidden="true"></div>

            <div class="relative flex items-center gap-3 md:gap-4 px-4 md:px-6 w-full">
              <span class="relative shrink-0 flex items-center justify-center w-9 h-9 md:w-11 md:h-11 rounded-xl bg-gradient-to-br from-sky-400 to-sky-600 text-white shadow-md shadow-sky-500/40 text-base md:text-lg transition-transform duration-300 group-hover:scale-110 group-hover:rotate-[-4deg]" aria-hidden="true">
                <span class="absolute inset-0 rounded-xl bg-sky-400/50 adslot-ping"></span>
                <span class="relative">{ad.emoji || '✨'}</span>
              </span>

              <div class="min-w-0 flex flex-col leading-tight gap-0.5 flex-1">
                <span class="text-[13px] md:text-[15px] font-extrabold text-gray-900 dark:text-white truncate tracking-tight">
                  {ad.title}
                </span>
                {ad.subtitle && (
                  <span class="text-[11px] md:text-xs font-medium text-gray-500 dark:text-gray-400 truncate">
                    {ad.subtitle}
                  </span>
                )}
              </div>

              {ad.ctaText && (
                <span class="hidden sm:inline-flex shrink-0 items-center gap-1.5 ml-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 px-3 py-1.5 text-[11px] md:text-xs font-bold whitespace-nowrap transition-all duration-300 group-hover:bg-sky-500 group-hover:text-white group-hover:gap-2.5">
                  {ad.ctaText}
                  <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/>
                  </svg>
                </span>
              )}
            </div>
          </div>
        )}
      </a>
    ))}

    {ads.length > 1 && (
      <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5">
        {ads.map((_, i) => (
          <span
            class:list={[
              'adslot-dot w-1.5 h-1.5 rounded-full transition-all duration-300',
              i === 0 ? 'bg-sky-500 w-4' : 'bg-gray-300 dark:bg-gray-600',
            ]}
            data-dot-index={i}
            aria-hidden="true"
          ></span>
        ))}
      </div>
    )}
  </div>
)}

{ads.length > 0 && ads.map((ad) => (
  <AdTracker
    adId={ad.id}
    position={position}
    advertiser={ad.advertiser}
  />
))}

<style>
  .adslot-slide {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease-in-out;
    z-index: 1;
  }
  .adslot-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
  }

  .adslot-bg {
    background: linear-gradient(110deg, rgba(224, 242, 254, 0.7) 0%, rgba(255, 255, 255, 0.9) 40%, rgba(224, 242, 254, 0.5) 100%);
    background-size: 200% 200%;
    animation: adslot-gradient 8s ease infinite;
  }
  :global(.dark) .adslot-bg {
    background: linear-gradient(110deg, rgba(14, 165, 233, 0.08) 0%, rgba(17, 24, 39, 0.6) 40%, rgba(14, 165, 233, 0.06) 100%);
    background-size: 200% 200%;
    animation: adslot-gradient 8s ease infinite;
  }
  @keyframes adslot-gradient {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .adslot-shimmer {
    background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.6) 50%, transparent 80%);
    transform: translateX(-100%);
    animation: adslot-shimmer-sweep 5s ease-in-out infinite;
  }
  :global(.dark) .adslot-shimmer {
    background: linear-gradient(100deg, transparent 20%, rgba(56, 189, 248, 0.15) 50%, transparent 80%);
  }
  @keyframes adslot-shimmer-sweep {
    0%        { transform: translateX(-100%); }
    60%, 100% { transform: translateX(200%); }
  }

  .adslot-ping {
    animation: adslot-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes adslot-ping {
    0%   { transform: scale(1);   opacity: 0.6; }
    80%  { transform: scale(1.6); opacity: 0; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .adslot:hover .adslot-shimmer,
  .adslot-slide:hover .adslot-shimmer {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .adslot-bg, .adslot-shimmer, .adslot-ping {
      animation: none !important;
    }
    .adslot-slide {
      transition: none !important;
    }
  }
</style>

<script>
  (function () {
    if (typeof window === 'undefined') return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initSlideshow(container) {
      const slides = Array.from(container.querySelectorAll('.adslot-slide'));
      const dots = Array.from(container.querySelectorAll('.adslot-dot'));

      if (slides.length < 2) return;
      if (reduceMotion) return;

      const pauseOnHover = container.dataset.pauseOnHover === 'true';
      let current = 0;
      let timer = null;
      let paused = false;

      const slideDurations = slides.map(function (s) {
        return Math.max(2, parseInt(s.dataset.duration || '6', 10));
      });

      function setActive(index) {
        slides.forEach(function (s, i) {
          s.classList.toggle('is-active', i === index);
        });
        dots.forEach(function (d, i) {
          d.classList.toggle('bg-sky-500', i === index);
          d.classList.toggle('w-4', i === index);
          d.classList.toggle('bg-gray-300', i !== index);
          d.classList.toggle('dark:bg-gray-600', i !== index);
        });
      }

      function scheduleNext() {
        if (timer) window.clearTimeout(timer);
        const duration = slideDurations[current] * 1000;
        timer = window.setTimeout(function () {
          if (paused) {
            scheduleNext();
            return;
          }
          current = (current + 1) % slides.length;
          setActive(current);
          scheduleNext();
        }, duration);
      }

      dots.forEach(function (dot, i) {
        dot.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          current = i;
          setActive(current);
          scheduleNext();
        });
      });

      if (pauseOnHover) {
        container.addEventListener('mouseenter', function () { paused = true; });
        container.addEventListener('mouseleave', function () { paused = false; });
      }

      document.addEventListener('visibilitychange', function () {
        paused = document.hidden;
      });

      setActive(0);
      scheduleNext();
    }

    function initAll() {
      document.querySelectorAll('.adslot-slideshow').forEach(initSlideshow);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll, { once: true });
    } else {
      initAll();
    }

    document.addEventListener('astro:after-swap', initAll);
  })();
</script>