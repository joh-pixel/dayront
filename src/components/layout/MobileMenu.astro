---
/**
 * src/components/layout/MobileMenu.astro
 * ----------------------------------------------------------------------------
 * Mobile slide-in navigation drawer.
 *
 *   • Hamburger trigger button (mobile only — hidden from md: up)
 *   • Right-side drawer that slides in/out
 *   • Backdrop that closes on outside click
 *   • ESC key closes
 *   • X button closes
 *   • Body scroll lock while open
 *   • Focus returns to the trigger on close
 *   • Respects safe-area insets on notched devices
 *
 * Self-contained: trigger + backdrop + drawer + behaviour.
 * Rendered by Header.astro once per page.
 */
---

<div data-mobile-menu class="md:hidden">

  <!-- ── Trigger (hamburger) ─────────────────────────────────── -->
  <button
    type="button"
    data-mobile-menu-trigger
    aria-label="Open menu"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="mobile-menu-drawer"
    class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white/70 text-gray-800 transition hover:bg-gray-100 active:scale-[0.97] dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-100 dark:hover:bg-gray-800"
  >
    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 7h16" />
      <path d="M4 12h16" />
      <path d="M4 17h16" />
    </svg>
  </button>

  <!-- ── Backdrop ────────────────────────────────────────────── -->
  <div
    data-mobile-menu-backdrop
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-40 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-300 ease-out"
  ></div>

  <!-- ── Drawer ──────────────────────────────────────────────── -->
  <aside
    id="mobile-menu-drawer"
    data-mobile-menu-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    class="fixed inset-y-0 right-0 z-50 w-64 max-w-[85vw] translate-x-full bg-white shadow-2xl transition-transform duration-300 ease-out dark:bg-gray-900"
    style="padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);"
  >
    <!-- Drawer header -->
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-gray-800">
      <span class="text-sm font-bold text-gray-900 dark:text-white">Menu</span>
      <button
        type="button"
        data-mobile-menu-close
        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-700 transition hover:bg-gray-200 active:scale-[0.95] dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
        aria-label="Close menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer body -->
    <nav class="flex h-[calc(100%-3.75rem)] flex-col overflow-y-auto p-4">
      <button
        type="button"
        data-mobile-menu-search
        class="mb-2 flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="M21 21l-4.35-4.35" />
        </svg>
        Search
      </button>

      <hr class="my-2 border-gray-200 dark:border-gray-800" />

      <div class="flex flex-col space-y-1">
        <a href="/tools" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Tools</a>
        <a href="/convert" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Converters</a>
        <a href="/blog" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Blog</a>
        <a href="/download" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Download App</a>
        <a href="/about" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">About</a>
        <a href="/privacy" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Privacy</a>
        <a href="/terms" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Terms</a>
      </div>
    </nav>
  </aside>
</div>

<script>
  (() => {
    function initMobileMenu() {
      const root = document.querySelector<HTMLElement>('[data-mobile-menu]');
      if (!root) return;

      // Skip if already initialised (protects against duplicate listeners
      // after ClientRouter navigation).
      if (root.hasAttribute('data-mobile-menu-bound')) return;
      root.setAttribute('data-mobile-menu-bound', '1');

      const trigger  = root.querySelector<HTMLButtonElement>('[data-mobile-menu-trigger]');
      const drawer   = root.querySelector<HTMLElement>('[data-mobile-menu-drawer]');
      const backdrop = root.querySelector<HTMLElement>('[data-mobile-menu-backdrop]');
      const closers  = root.querySelectorAll<HTMLElement>('[data-mobile-menu-close]');
      const search   = root.querySelector<HTMLElement>('[data-mobile-menu-search]');

      if (!trigger || !drawer || !backdrop) return;

      let isOpen = false;
      let previousOverflow = '';

      function open() {
        if (isOpen) return;
        isOpen = true;

        backdrop.classList.remove('pointer-events-none', 'opacity-0');
        backdrop.classList.add('opacity-100');

        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');

        trigger.setAttribute('aria-expanded', 'true');

        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';

        const firstFocusable = drawer.querySelector<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );
        firstFocusable?.focus();
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;

        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');

        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');

        window.setTimeout(() => {
          if (!isOpen) backdrop.classList.add('pointer-events-none');
        }, 300);

        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = previousOverflow;
        trigger.focus();
      }

      trigger.addEventListener('click', open);
      closers.forEach((el) => el.addEventListener('click', close));
      backdrop.addEventListener('click', close);

      // Search button: close the drawer first, then trigger the global
      // search modal (defined by SearchModal.astro).
      if (search) {
        search.addEventListener('click', () => {
          close();
          const w = window as any;
          if (typeof w.openSearch === 'function') w.openSearch();
        });
      }

      // Close drawer when any nav link is tapped (so the next page starts
      // with the drawer collapsed).
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => { close(); });
      });

      window.addEventListener('keydown', (e) => {
        if (isOpen && e.key === 'Escape') {
          e.preventDefault();
          close();
        }
      });

      const mql = window.matchMedia('(min-width: 768px)');
      const handleBreakpoint = (e: MediaQueryListEvent | MediaQueryList) => {
        if (e.matches && isOpen) close();
      };
      if (typeof mql.addEventListener === 'function') {
        mql.addEventListener('change', handleBreakpoint);
      } else if (typeof (mql as any).addListener === 'function') {
        (mql as any).addListener(handleBreakpoint);
      }
    }

    // Run on first load, after every ClientRouter navigation, and after the
    // browser restores a bfcache page. `astro:page-load` covers Astro's
    // View Transitions; the DOMContentLoaded fallback covers non-router pages.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenu, { once: true });
    } else {
      initMobileMenu();
    }

    document.addEventListener('astro:page-load', initMobileMenu);
    window.addEventListener('pageshow', (event) => {
      if ((event as PageTransitionEvent).persisted) initMobileMenu();
    });
  })();
</script>