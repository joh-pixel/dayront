---
/**
 * src/components/layout/MobileMenu.astro
 * ----------------------------------------------------------------------------
 * Mobile slide-in navigation drawer.
 *
 *   • Hamburger trigger button (mobile only — hidden from md: up)
 *   • Right-side drawer that slides in/out
 *   • Backdrop that closes on outside click
 *   • ESC key closes / X button closes
 *   • Body scroll lock while open (with scrollbar-width compensation)
 *   • Focus management
 *   • Respects safe-area insets
 *   • Survives Astro ClientRouter navigation
 *
 * Critical layout is inline — no percentage heights, no reliance on
 * Tailwind emitting any particular utility. The drawer is a flex column:
 * header (shrink-0) + nav (flex-1, min-h-0, scrollable).
 *
 * The drawer + backdrop are portaled to <body> so `position: fixed`
 * resolves against the viewport, not the header.
 */
---

<!-- ── Trigger (hamburger) — stays inside the header ── -->
<button
  type="button"
  data-mobile-menu-trigger
  aria-label="Open menu"
  aria-expanded="false"
  aria-haspopup="dialog"
  aria-controls="mobile-menu-drawer"
  class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white/70 text-gray-800 transition hover:bg-gray-100 active:scale-[0.97] dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-100 dark:hover:bg-gray-800"
>
  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 7h16" />
    <path d="M4 12h16" />
    <path d="M4 17h16" />
  </svg>
</button>

<!-- ── Backdrop (portaled to <body> on init) ── -->
<div
  data-mobile-menu-backdrop
  aria-hidden="true"
  class="bg-black/50 backdrop-blur-sm"
  style="
    position: fixed;
    inset: 0;
    z-index: 60;
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease-out;
  "
></div>

<!-- ── Drawer (portaled to <body> on init) ── -->
<aside
  id="mobile-menu-drawer"
  data-mobile-menu-drawer
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  class="bg-white dark:bg-gray-900"
  style="
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 17rem;
    max-width: 88vw;
    z-index: 70;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.25);
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  "
>
  <!-- Drawer header -->
  <div class="flex shrink-0 items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-gray-800">
    <span class="text-sm font-bold text-gray-900 dark:text-white">Menu</span>
    <button
      type="button"
      data-mobile-menu-close
      class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-700 transition hover:bg-gray-200 active:scale-[0.95] dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
      aria-label="Close menu"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer body — flex-1 so it takes whatever space the header leaves -->
  <nav
    class="flex flex-col gap-0.5 overflow-y-auto p-4"
    style="flex: 1 1 auto; min-height: 0;"
  >
    <button
      type="button"
      data-mobile-menu-search
      class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      Search
    </button>

    <hr class="my-2 border-gray-200 dark:border-gray-800" />

    <a href="/tools" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Tools</a>
    <a href="/convert" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Converters</a>
    <a href="/blog" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Blog</a>
    <a href="/download" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Download App</a>
    <a href="/about" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">About</a>
    <a href="/privacy" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Privacy</a>
    <a href="/terms" class="rounded-lg px-3 py-2.5 text-base font-medium text-gray-900 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">Terms</a>
  </nav>
</aside>

<script>
  (() => {
    const SEL_TRIGGER  = '[data-mobile-menu-trigger]';
    const SEL_DRAWER   = '[data-mobile-menu-drawer]';
    const SEL_BACKDROP = '[data-mobile-menu-backdrop]';

    function portalToBody() {
      const backdrop = document.querySelector(SEL_BACKDROP);
      const drawer   = document.querySelector(SEL_DRAWER);
      if (backdrop && backdrop.parentElement !== document.body) {
        document.body.appendChild(backdrop);
      }
      if (drawer && drawer.parentElement !== document.body) {
        document.body.appendChild(drawer);
      }
    }

    function init() {
      const trigger  = document.querySelector(SEL_TRIGGER) as HTMLButtonElement | null;
      const drawer   = document.querySelector(SEL_DRAWER)  as HTMLElement | null;
      const backdrop = document.querySelector(SEL_BACKDROP) as HTMLElement | null;
      if (!trigger || !drawer || !backdrop) return;

      portalToBody();

      if (trigger.hasAttribute('data-mobile-menu-bound')) return;
      trigger.setAttribute('data-mobile-menu-bound', '1');

      const closers = drawer.querySelectorAll<HTMLElement>('[data-mobile-menu-close]');
      const search  = drawer.querySelector<HTMLElement>('[data-mobile-menu-search]');

      let isOpen = false;
      let prevHtmlOverflow = '';
      let prevBodyOverflow = '';
      let prevBodyPaddingRight = '';

      function lockScroll() {
        // Preserve scroll position and prevent layout shift on desktop by
        // compensating for the scrollbar width. On mobile this is a no-op
        // because innerWidth === clientWidth.
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        prevHtmlOverflow = document.documentElement.style.overflow;
        prevBodyOverflow = document.body.style.overflow;
        prevBodyPaddingRight = document.body.style.paddingRight;

        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
        if (scrollbarWidth > 0) {
          document.body.style.paddingRight = `${scrollbarWidth}px`;
        }
      }

      function unlockScroll() {
        document.documentElement.style.overflow = prevHtmlOverflow;
        document.body.style.overflow = prevBodyOverflow;
        document.body.style.paddingRight = prevBodyPaddingRight;
      }

      function open() {
        if (isOpen) return;
        isOpen = true;
        backdrop.style.opacity = '1';
        backdrop.style.pointerEvents = 'auto';
        drawer.style.transform = 'translateX(0)';
        trigger.setAttribute('aria-expanded', 'true');
        lockScroll();
        const firstFocusable = drawer.querySelector<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );
        firstFocusable?.focus();
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;
        drawer.style.transform = 'translateX(100%)';
        backdrop.style.opacity = '0';
        backdrop.style.pointerEvents = 'none';
        trigger.setAttribute('aria-expanded', 'false');
        unlockScroll();
        trigger.focus();
      }

      trigger.addEventListener('click', open);
      closers.forEach((el) => el.addEventListener('click', close));
      backdrop.addEventListener('click', close);

      if (search) {
        search.addEventListener('click', () => {
          close();
          const w = window as any;
          if (typeof w.openSearch === 'function') w.openSearch();
        });
      }

      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => { close(); });
      });

      window.addEventListener('keydown', (e) => {
        if (isOpen && e.key === 'Escape') {
          e.preventDefault();
          close();
        }
      });

      const mql = window.matchMedia('(min-width: 768px)');
      const handleBreakpoint = (e: MediaQueryListEvent | MediaQueryList) => {
        if (e.matches && isOpen) close();
      };
      if (typeof mql.addEventListener === 'function') {
        mql.addEventListener('change', handleBreakpoint);
      } else if (typeof (mql as any).addListener === 'function') {
        (mql as any).addListener(handleBreakpoint);
      }
    }

    document.addEventListener('astro:before-swap', () => {
      document.querySelectorAll(
        `body > ${SEL_DRAWER}, body > ${SEL_BACKDROP}`,
      ).forEach((el) => el.remove());
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }

    document.addEventListener('astro:page-load', init);
    window.addEventListener('pageshow', (event) => {
      if ((event as PageTransitionEvent).persisted) init();
    });
  })();
</script>