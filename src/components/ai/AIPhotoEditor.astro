---
interface Props { toolConfig?: any; }
const { toolConfig } = Astro.props;
---

<div class="ai-tool" data-tool="ai-photo-editor">
  <div id="aip-upload-zone" class="border-2 border-dashed border-sky-200 dark:border-sky-900/50 bg-sky-50/40 dark:bg-sky-950/10 rounded-2xl p-8 sm:p-12 text-center transition">
    <input type="file" id="aip-file-input" accept="image/*" class="hidden" autocomplete="off" />
    <div class="text-5xl mb-4">🎨</div>
    <p class="text-base text-gray-700 dark:text-gray-300 mb-2 font-medium">Upload a photo to edit</p>
    <p class="text-xs text-gray-400 mb-4">JPG, PNG, WebP — edited entirely on your device</p>
    <button id="aip-browse-btn" class="bg-sky-500 hover:bg-sky-600 text-white font-semibold px-6 py-2.5 rounded-lg transition">Choose Photo</button>
  </div>

  <div id="aip-selected-card" class="hidden mt-4 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-4">
    <div class="flex items-center justify-between mb-3">
      <span class="text-sm font-semibold text-black dark:text-white">Selected file</span>
      <span class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-xs px-2.5 py-1 rounded-full">1 file</span>
    </div>
    <div class="flex items-center justify-between">
      <span id="aip-file-name" class="text-sm text-gray-700 dark:text-gray-300 truncate mr-4"></span>
      <span id="aip-file-size" class="text-sm text-gray-500 shrink-0"></span>
    </div>
  </div>

  <div id="aip-editor" class="hidden mt-4 space-y-4">
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-black dark:text-white">Preview</h2>
        <button id="aip-reset-all" class="text-xs text-sky-500 hover:text-sky-600 font-medium">Reset all edits</button>
      </div>
      <div class="p-3 bg-gray-100 dark:bg-black">
        <div class="rounded-xl overflow-hidden mx-auto" id="aip-preview-bg" style="max-width: 100%; background-image: linear-gradient(45deg, #eee 25%, transparent 25%), linear-gradient(-45deg, #eee 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #eee 75%), linear-gradient(-45deg, transparent 75%, #eee 75%); background-size: 20px 20px; background-position: 0 0, 0 10px, 10px -10px, -10px 0px;">
          <canvas id="aip-canvas" class="w-full block" style="max-height: 55vh; object-fit: contain;"></canvas>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-1.5 grid grid-cols-4 gap-1">
      <button data-mode="ai" class="aip-mode-tab px-2 py-2.5 rounded-xl text-[11px] font-semibold transition bg-sky-500 text-white">✨ AI</button>
      <button data-mode="filters" class="aip-mode-tab px-2 py-2.5 rounded-xl text-[11px] font-semibold transition bg-transparent text-gray-600 dark:text-gray-400">🎞️ Filters</button>
      <button data-mode="manual" class="aip-mode-tab px-2 py-2.5 rounded-xl text-[11px] font-semibold transition bg-transparent text-gray-600 dark:text-gray-400">🎚️ Manual</button>
      <button data-mode="background" class="aip-mode-tab px-2 py-2.5 rounded-xl text-[11px] font-semibold transition bg-transparent text-gray-600 dark:text-gray-400">🖼️ BG</button>
    </div>

    <div id="aip-mode-ai" class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 space-y-3">
      <p class="text-xs text-gray-500 dark:text-gray-400">Describe what you want — the AI understands actions like "blur it", "make it brighter", or styles like "warm vintage".</p>
      <textarea id="aip-prompt" rows="3" placeholder="e.g. make it brighter, blur the background, warm vintage, dramatic noir" class="w-full p-3 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm text-black dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500" autocomplete="off"></textarea>
      <div class="flex flex-wrap gap-1.5">
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">make it brighter</button>
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">blur it</button>
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">black and white</button>
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">warm vintage</button>
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">dramatic noir</button>
        <button class="aip-quick-prompt px-3 py-1.5 bg-sky-50 dark:bg-sky-900/20 hover:bg-sky-100 dark:hover:bg-sky-900/40 text-sky-600 dark:text-sky-300 rounded-full text-xs font-medium transition">soft dreamy</button>
      </div>
      <button id="aip-apply-prompt" class="w-full bg-gradient-to-r from-purple-600 to-sky-500 hover:from-purple-700 hover:to-sky-600 text-white font-semibold py-3 rounded-xl transition">✨ Apply AI Style</button>
      <p id="aip-prompt-status" class="text-xs text-gray-500 text-center"></p>
    </div>

    <div id="aip-mode-filters" class="hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4">
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Tap a filter to apply instantly</p>
      <div id="aip-filters-grid" class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-2"></div>
    </div>

    <div id="aip-mode-manual" class="hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 space-y-4">
      <div class="flex items-center justify-between mb-1">
        <h3 class="font-semibold text-black dark:text-white text-sm">Manual Adjustments</h3>
        <button id="aip-reset-manual" class="text-xs text-sky-500 hover:text-sky-600 font-medium">Reset sliders</button>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Brightness</label>
          <span id="aip-brightness-val" class="text-xs font-mono text-gray-500">0</span>
        </div>
        <input type="range" id="aip-brightness" min="-100" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Contrast</label>
          <span id="aip-contrast-val" class="text-xs font-mono text-gray-500">0</span>
        </div>
        <input type="range" id="aip-contrast" min="-100" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Saturation</label>
          <span id="aip-saturation-val" class="text-xs font-mono text-gray-500">0</span>
        </div>
        <input type="range" id="aip-saturation" min="-100" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Warmth</label>
          <span id="aip-warmth-val" class="text-xs font-mono text-gray-500">0</span>
        </div>
        <input type="range" id="aip-warmth" min="-100" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Blur</label>
          <span id="aip-blur-val" class="text-xs font-mono text-gray-500">0px</span>
        </div>
        <input type="range" id="aip-blur" min="0" max="20" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Grayscale</label>
          <span id="aip-grayscale-val" class="text-xs font-mono text-gray-500">0%</span>
        </div>
        <input type="range" id="aip-grayscale" min="0" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Vignette</label>
          <span id="aip-vignette-val" class="text-xs font-mono text-gray-500">0%</span>
        </div>
        <input type="range" id="aip-vignette" min="0" max="100" value="0" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
      </div>

      <div class="pt-3 border-t border-gray-100 dark:border-gray-800">
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-2">Transform</label>
        <div class="grid grid-cols-4 gap-2">
          <button data-transform="rotate-left" class="aip-transform-btn flex flex-col items-center gap-1 p-2.5 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">
            <svg class="w-4 h-4 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6-6M3 10l6 6"/></svg>
            <span class="text-[10px] text-gray-500">Rotate L</span>
          </button>
          <button data-transform="rotate-right" class="aip-transform-btn flex flex-col items-center gap-1 p-2.5 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">
            <svg class="w-4 h-4 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 10H11a8 8 0 00-8 8v2M21 10l-6-6M21 10l-6 6"/></svg>
            <span class="text-[10px] text-gray-500">Rotate R</span>
          </button>
          <button data-transform="flip-h" class="aip-transform-btn flex flex-col items-center gap-1 p-2.5 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">
            <svg class="w-4 h-4 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3"/></svg>
            <span class="text-[10px] text-gray-500">Flip H</span>
          </button>
          <button data-transform="flip-v" class="aip-transform-btn flex flex-col items-center gap-1 p-2.5 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">
            <svg class="w-4 h-4 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M12 3v18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3"/></svg>
            <span class="text-[10px] text-gray-500">Flip V</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ★ BACKGROUND MODE (with custom image upload) ★ -->
    <div id="aip-mode-background" class="hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 space-y-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">Remove the background and optionally replace it. Runs entirely in your browser.</p>

      <div id="aip-bg-remove-row">
        <button id="aip-bg-remove-btn" class="w-full bg-purple-600 hover:bg-purple-700 disabled:opacity-60 text-white font-semibold py-3 rounded-xl transition">✨ Remove Background</button>
        <p id="aip-bg-remove-status" class="mt-2 text-xs text-gray-500 text-center"></p>
        <p class="mt-1 text-[10px] text-gray-400 text-center">First run downloads an AI model (~11 MB, cached after)</p>
      </div>

      <!-- Progress bar -->
      <div id="aip-bg-progress" class="hidden">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></div>
            <span class="text-xs font-medium text-purple-900 dark:text-purple-100" id="aip-bg-progress-label">Preparing…</span>
          </div>
          <span id="aip-bg-progress-pct" class="text-xs font-semibold text-purple-600 dark:text-purple-300">0%</span>
        </div>
        <div class="w-full h-1.5 bg-purple-100 dark:bg-purple-900/30 rounded-full overflow-hidden">
          <div id="aip-bg-progress-bar" class="h-full bg-purple-500 transition-all duration-300" style="width: 0%"></div>
        </div>
        <p id="aip-bg-progress-status" class="mt-2 text-xs text-gray-500"></p>
      </div>

      <div id="aip-bg-options" class="hidden space-y-4 pt-3 border-t border-gray-100 dark:border-gray-800">
        <h3 class="font-semibold text-black dark:text-white text-sm">Replace Background</h3>

        <!-- Background type buttons: None / Color / Image / Blur / Original -->
        <div class="grid grid-cols-5 gap-2">
          <button data-bg-type="transparent" class="aip-bg-type-btn flex flex-col items-center gap-1 p-2 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition border-2 border-transparent">
            <div class="w-6 h-6 rounded-md" style="background-image: linear-gradient(45deg, #ccc 25%, transparent 25%), linear-gradient(-45deg, #ccc 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #ccc 75%), linear-gradient(-45deg, transparent 75%, #ccc 75%); background-size: 8px 8px; background-position: 0 0, 0 4px, 4px -4px, -4px 0px; border: 1px solid #ddd;"></div>
            <span class="text-[9px] text-gray-500">None</span>
          </button>
          <button data-bg-type="color" class="aip-bg-type-btn flex flex-col items-center gap-1 p-2 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition border-2 border-transparent">
            <div class="w-6 h-6 rounded-md" style="background: linear-gradient(135deg, #0ea5e9, #ec4899);"></div>
            <span class="text-[9px] text-gray-500">Color</span>
          </button>
          <button data-bg-type="image" class="aip-bg-type-btn flex flex-col items-center gap-1 p-2 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition border-2 border-transparent">
            <div class="w-6 h-6 rounded-md flex items-center justify-center bg-gradient-to-br from-emerald-400 to-teal-600">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <span class="text-[9px] text-gray-500">Image</span>
          </button>
          <button data-bg-type="blur" class="aip-bg-type-btn flex flex-col items-center gap-1 p-2 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition border-2 border-transparent">
            <div class="w-6 h-6 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #a1a1aa, #52525b);">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/></svg>
            </div>
            <span class="text-[9px] text-gray-500">Blur</span>
          </button>
          <button data-bg-type="original" class="aip-bg-type-btn flex flex-col items-center gap-1 p-2 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition border-2 border-transparent">
            <div class="w-6 h-6 rounded-md" style="background: linear-gradient(135deg, #a16207, #78350f);"></div>
            <span class="text-[9px] text-gray-500">Original</span>
          </button>
        </div>

        <!-- Solid color picker -->
        <div id="aip-bg-color-picker" class="hidden">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-2">Pick a background color</label>
          <input type="color" id="aip-bg-color" value="#ffffff" class="w-full h-12 rounded-lg border border-gray-200 dark:border-gray-700 cursor-pointer" />
          <div class="flex gap-2 mt-2 flex-wrap">
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#ffffff" data-color="#ffffff"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#000000" data-color="#000000"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#0ea5e9" data-color="#0ea5e9"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#ec4899" data-color="#ec4899"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#22c55e" data-color="#22c55e"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#eab308" data-color="#eab308"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#a855f7" data-color="#a855f7"></button>
            <button class="aip-bg-swatch w-8 h-8 rounded-lg border border-gray-200 dark:border-gray-700" style="background:#f97316" data-color="#f97316"></button>
          </div>
        </div>

        <!-- ★ Custom image picker (NEW) ★ -->
        <div id="aip-bg-image-picker" class="hidden">
          <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-2">Upload a background image</label>
          <label class="w-full border-2 border-dashed border-sky-300 dark:border-sky-700 hover:border-sky-500 rounded-lg py-4 text-sm text-sky-600 dark:text-sky-300 font-medium transition flex items-center justify-center gap-2 cursor-pointer bg-sky-50 dark:bg-sky-950/20">
            <input type="file" id="aip-bg-image-input" accept="image/*" class="hidden" />
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Choose background image
          </label>

          <!-- Preview row (shown after upload) -->
          <div id="aip-bg-image-row" class="hidden mt-3 flex items-center gap-3 p-2 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <img id="aip-bg-image-thumb" class="w-12 h-12 rounded-lg object-cover border border-gray-200 dark:border-gray-700" />
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-black dark:text-white truncate">Custom background</p>
              <p id="aip-bg-image-name" class="text-[10px] text-gray-500 truncate"></p>
            </div>
            <button id="aip-bg-image-remove" class="shrink-0 w-7 h-7 rounded-lg hover:bg-red-100 dark:hover:bg-red-900/30 flex items-center justify-center transition">
              <svg class="w-3.5 h-3.5 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>

        <!-- Blur strength -->
        <div id="aip-bg-blur-picker" class="hidden">
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-medium text-gray-600 dark:text-gray-400">Blur strength</label>
            <span id="aip-bg-blur-val" class="text-xs font-mono text-gray-500">15px</span>
          </div>
          <input type="range" id="aip-bg-blur" min="5" max="40" value="15" step="1" class="w-full accent-sky-500" autocomplete="off" form="" />
        </div>

        <button id="aip-bg-restore-btn" class="w-full text-xs text-gray-500 hover:text-sky-500 py-2">Restore original photo</button>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 space-y-3">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" id="aip-clean" checked class="accent-sky-500 w-4 h-4" autocomplete="off" form="" />
        <span class="text-xs text-gray-700 dark:text-gray-300">Clean metadata before download</span>
      </label>
      <button id="aip-download-btn" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-semibold py-3 rounded-xl transition">⬇ Download Edited Photo</button>
      <button id="aip-again-btn" class="w-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold py-2.5 rounded-xl text-sm transition">Edit Another Photo</button>
    </div>
  </div>

  <div id="aip-error" class="hidden mt-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl text-red-800 dark:text-red-200 text-sm"></div>
</div>

<script>
  import { downloadBlob } from '../../ai/utils/video-codecs.js';

  const el = (id) => document.getElementById(id);
  const canvas = el('aip-canvas');
  const ctx = canvas.getContext('2d', { willReadFrequently: true });

  let img = null;
  let originalImage = null;
  let foregroundImage = null;
  let selectedFile = null;

  const DEFAULT_STATE = {
    brightness: 0, contrast: 0, saturation: 0, warmth: 0,
    blur: 0, grayscale: 0, vignette: 0,
    rotation: 0, flipH: false, flipV: false,
  };
  let state = { ...DEFAULT_STATE };

  const DEFAULT_BG_STATE = {
    mode: 'transparent',       // 'transparent' | 'color' | 'image' | 'blur' | 'original'
    color: '#ffffff',
    blurAmount: 15,
    imageURL: null,
  };
  let bgState = { ...DEFAULT_BG_STATE };
  let bgRemovalInProgress = false;

  // ★ Custom background image
  let customBgURL = null;
  let customBgImg = null;

  const SLIDER_IDS = ['brightness', 'contrast', 'saturation', 'warmth', 'blur', 'grayscale', 'vignette'];
  const SLIDER_LABELS = {
    brightness: 'aip-brightness-val', contrast: 'aip-contrast-val', saturation: 'aip-saturation-val',
    warmth: 'aip-warmth-val', blur: 'aip-blur-val', grayscale: 'aip-grayscale-val', vignette: 'aip-vignette-val',
  };

  const FILTERS = [
    { name: 'Original',  state: {} },
    { name: 'Vivid',     state: { saturation: 40, contrast: 15, brightness: 5 } },
    { name: 'Vintage',   state: { saturation: -20, contrast: -10, warmth: 30, vignette: 30, grayscale: 10 } },
    { name: 'Mono',      state: { grayscale: 100, contrast: 15 } },
    { name: 'Noir',      state: { grayscale: 100, contrast: 40, brightness: -10, vignette: 40 } },
    { name: 'Warm',      state: { warmth: 40, saturation: 15, brightness: 5 } },
    { name: 'Cool',      state: { warmth: -40, saturation: 10 } },
    { name: 'Faded',     state: { contrast: -25, saturation: -30, brightness: 10 } },
    { name: 'Cinematic', state: { contrast: 25, saturation: -10, warmth: -15, vignette: 35 } },
    { name: 'Dreamy',    state: { blur: 1, brightness: 10, contrast: -15, saturation: 15 } },
    { name: 'Dramatic',  state: { contrast: 45, saturation: 20, vignette: 40 } },
    { name: 'Sepia',     state: { warmth: 60, saturation: -40, contrast: 10, grayscale: 30 } },
    { name: 'Soft',      state: { blur: 2, contrast: -15, brightness: 8, saturation: -10 } },
    { name: 'Punch',     state: { contrast: 35, saturation: 35 } },
    { name: 'Frost',     state: { warmth: -30, saturation: 5, brightness: 10, contrast: 5 } },
    { name: 'Neon',      state: { saturation: 70, contrast: 30, brightness: 5 } },
    { name: 'Pastel',    state: { saturation: -20, brightness: 20, contrast: -20 } },
    { name: 'HDR',       state: { contrast: 45, saturation: 40, brightness: 5 } },
    { name: 'Ocean',     state: { warmth: -50, saturation: 25, contrast: 15 } },
    { name: 'Sunset',    state: { warmth: 55, saturation: 30, brightness: 8, vignette: 15 } },
  ];

  const PROMPT_RULES = [
    { keys: ['blur', 'blurry', 'out of focus', 'soften', 'soften it'], set: { blur: 8 } },
    { keys: ['slight blur', 'a bit blurry', 'little blur'], set: { blur: 3 } },
    { keys: ['heavily blur', 'very blurry', 'extreme blur'], set: { blur: 15 } },
    { keys: ['sharpen', 'sharper', 'crisp', 'crisper'], set: { contrast: 20, saturation: 5 } },
    { keys: ['brighten', 'brighter', 'make it bright', 'lighter', 'lighten', 'bright'], set: { brightness: 25 } },
    { keys: ['darken', 'darker', 'make it dark', 'dim'], set: { brightness: -25 } },
    { keys: ['increase contrast', 'more contrast', 'high contrast'], set: { contrast: 35 } },
    { keys: ['reduce contrast', 'less contrast', 'low contrast'], set: { contrast: -25 } },
    { keys: ['desaturate', 'less color', 'muted colors', 'desaturated'], set: { saturation: -40 } },
    { keys: ['more color', 'more saturated', 'saturate', 'colorful', 'vibrant', 'vivid'], set: { saturation: 45 } },
    { keys: ['add warmth', 'warmer', 'warm tone', 'warm'], set: { warmth: 40, saturation: 15 } },
    { keys: ['cooler', 'cool tone', 'cool', 'cooler tone', 'blue tint'], set: { warmth: -40 } },
    { keys: ['black and white', 'b&w', 'bw', 'monochrome', 'mono', 'grayscale', 'greyscale'], set: { grayscale: 100, contrast: 10 } },
    { keys: ['noir', 'moody', 'dark and moody'], set: { grayscale: 100, contrast: 40, brightness: -15, vignette: 45 } },
    { keys: ['vintage', 'retro', 'old', 'antique', 'old-fashioned'], set: { saturation: -20, contrast: -10, warmth: 35, vignette: 25, grayscale: 10 } },
    { keys: ['sepia', 'aged', 'old photo'], set: { warmth: 65, saturation: -45, contrast: 10, grayscale: 35 } },
    { keys: ['golden hour', 'golden'], set: { warmth: 55, saturation: 25, brightness: 10 } },
    { keys: ['sunny', 'sunshine', 'cozy'], set: { warmth: 40, saturation: 15, brightness: 8 } },
    { keys: ['frost', 'frosty', 'icy', 'ice', 'winter'], set: { warmth: -55, saturation: 5, brightness: 10, contrast: 10 } },
    { keys: ['cinematic', 'movie', 'film', 'movie look'], set: { contrast: 30, saturation: -10, warmth: -20, vignette: 35 } },
    { keys: ['dramatic', 'intense', 'bold', 'drama'], set: { contrast: 45, saturation: 25, vignette: 40 } },
    { keys: ['soft', 'dreamy', 'gentle', 'romantic', 'ethereal'], set: { blur: 2, brightness: 12, contrast: -20, saturation: 15 } },
    { keys: ['faded', 'washed', 'washed out', 'matte'], set: { contrast: -25, saturation: -30, brightness: 12 } },
    { keys: ['hazy', 'haze', 'atmospheric'], set: { contrast: -15, blur: 1, brightness: 15, warmth: 10 } },
    { keys: ['night', 'nighttime', 'evening', 'moody night'], set: { brightness: -25, contrast: 20, vignette: 30 } },
    { keys: ['pastel', 'pastel tones'], set: { saturation: -15, brightness: 20, contrast: -15 } },
    { keys: ['neon', 'neon lights', 'cyberpunk'], set: { saturation: 60, contrast: 30 } },
    { keys: ['hdr', 'high dynamic range'], set: { contrast: 45, saturation: 40 } },
    { keys: ['summer', 'summery'], set: { warmth: 30, saturation: 25, brightness: 10 } },
    { keys: ['autumn', 'fall'], set: { warmth: 45, saturation: 15, contrast: 10 } },
    { keys: ['clean', 'minimal', 'modern'], set: { contrast: 10, brightness: 5 } },
    { keys: ['foggy', 'fog', 'mist'], set: { contrast: -20, blur: 2, brightness: 12 } },
    { keys: ['sunset', 'dusk'], set: { warmth: 55, saturation: 25, vignette: 15 } },
    { keys: ['sunrise', 'dawn'], set: { warmth: 30, brightness: 15, saturation: 15 } },
    { keys: ['underwater', 'deep sea'], set: { warmth: -50, saturation: 30, brightness: -10, blur: 1 } },
    { keys: ['red tint', 'reddish'], set: { warmth: 50 } },
    { keys: ['blue tint', 'bluish'], set: { warmth: -50 } },
    { keys: ['green tint', 'greenish'], set: { warmth: -20, saturation: 15 } },
    { keys: ['purple tint', 'purple'], set: { warmth: 20, saturation: 15 } },
    { keys: ['orange tint'], set: { warmth: 45, saturation: 20 } },
    { keys: ['vignette', 'dark edges', 'darkened edges'], set: { vignette: 50 } },
    { keys: ['no vignette', 'remove vignette'], set: { vignette: 0 } },
  ];

  function parsePromptToState(prompt) {
    const lower = prompt.toLowerCase();
    const patch = {};
    const matched = [];
    const sortedRules = [...PROMPT_RULES].sort((a, b) => {
      const maxA = Math.max(...a.keys.map(k => k.length));
      const maxB = Math.max(...b.keys.map(k => k.length));
      return maxB - maxA;
    });
    for (const rule of sortedRules) {
      for (const keyword of rule.keys) {
        const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const regex = new RegExp(`\\b${escaped}\\b`, 'i');
        if (regex.test(lower)) {
          for (const [k, v] of Object.entries(rule.set)) {
            if (k === 'brightness' && v < 0) patch[k] = v;
            else patch[k] = (patch[k] || 0) + v;
          }
          matched.push(keyword);
          break;
        }
      }
    }
    for (const key of SLIDER_IDS) {
      if (key in patch) {
        if (key === 'blur') patch[key] = Math.max(0, Math.min(20, patch[key]));
        else if (key === 'grayscale' || key === 'vignette') patch[key] = Math.max(0, Math.min(100, patch[key]));
        else patch[key] = Math.max(-100, Math.min(100, patch[key]));
      }
    }
    return { patch, matched };
  }

  function syncSlidersToState() {
    for (const id of SLIDER_IDS) {
      const input = el(`aip-${id}`);
      if (input) input.value = String(state[id] ?? 0);
    }
    updateSliderLabels();
  }

  function updateSliderLabels() {
    for (const id of SLIDER_IDS) {
      const labelEl = el(SLIDER_LABELS[id]);
      if (!labelEl) continue;
      const val = state[id] ?? 0;
      if (id === 'blur') labelEl.textContent = `${val}px`;
      else if (id === 'grayscale' || id === 'vignette') labelEl.textContent = `${val}%`;
      else labelEl.textContent = (val > 0 ? '+' : '') + val;
    }
  }

  function resetState() {
    state = { ...DEFAULT_STATE };
    bgState = { ...DEFAULT_BG_STATE };
    foregroundImage = null;

    // Clear custom bg
    if (customBgURL) { try { URL.revokeObjectURL(customBgURL); } catch {} }
    customBgURL = null;
    customBgImg = null;
    el('aip-bg-image-row')?.classList.add('hidden');
    const bgInput = el('aip-bg-image-input');
    if (bgInput) bgInput.value = '';

    syncSlidersToState();
    el('aip-bg-options')?.classList.add('hidden');
    el('aip-bg-remove-row')?.classList.remove('hidden');
    el('aip-bg-progress')?.classList.add('hidden');
    updateBgTypeButtons();
    updateBgSubOptions();
    render();
  }

  function buildCanvasFilter() {
    const parts = [];
    if (state.brightness !== 0) parts.push(`brightness(${100 + state.brightness}%)`);
    if (state.contrast !== 0) parts.push(`contrast(${100 + state.contrast}%)`);
    if (state.saturation !== 0) parts.push(`saturate(${100 + state.saturation}%)`);
    if (state.blur > 0) parts.push(`blur(${state.blur}px)`);
    if (state.grayscale > 0) parts.push(`grayscale(${state.grayscale}%)`);
    if (state.warmth > 0) parts.push(`sepia(${Math.min(100, state.warmth * 0.6)}%)`);
    if (state.warmth < 0) parts.push(`hue-rotate(${state.warmth * 0.3}deg)`);
    return parts.length ? parts.join(' ') : 'none';
  }

  // ═══════════════════════════════════════════════════════
  // RENDER — handles background compositing
  // ═══════════════════════════════════════════════════════
  function render() {
    const source = foregroundImage || img;
    if (!source) return;

    const rotated = state.rotation % 180 !== 0;
    const w = rotated ? source.naturalHeight : source.naturalWidth;
    const h = rotated ? source.naturalWidth : source.naturalHeight;

    canvas.width = w;
    canvas.height = h;

    ctx.save();
    ctx.clearRect(0, 0, w, h);

    // ★ STEP 1: Draw background layer if we have a foreground-only image
    if (foregroundImage) {
      if (bgState.mode === 'color') {
        ctx.fillStyle = bgState.color;
        ctx.fillRect(0, 0, w, h);
      } else if (bgState.mode === 'image' && customBgImg) {
        // ★ NEW: Draw custom background image (cover-fit)
        const bgW = customBgImg.naturalWidth;
        const bgH = customBgImg.naturalHeight;
        const scale = Math.max(w / bgW, h / bgH);
        const drawW = bgW * scale;
        const drawH = bgH * scale;
        ctx.drawImage(customBgImg, (w - drawW) / 2, (h - drawH) / 2, drawW, drawH);
      } else if (bgState.mode === 'blur' && originalImage) {
        const origRotated = state.rotation % 180 !== 0;
        const origW = origRotated ? originalImage.naturalHeight : originalImage.naturalWidth;
        const origH = origRotated ? originalImage.naturalWidth : originalImage.naturalHeight;
        ctx.save();
        ctx.filter = `blur(${bgState.blurAmount}px)`;
        const scale = Math.max(w / origW, h / origH);
        const drawW = origW * scale;
        const drawH = origH * scale;
        ctx.drawImage(originalImage, (w - drawW) / 2, (h - drawH) / 2, drawW, drawH);
        ctx.filter = 'none';
        ctx.restore();
      } else if (bgState.mode === 'original' && originalImage) {
        const origRotated = state.rotation % 180 !== 0;
        const origW = origRotated ? originalImage.naturalHeight : originalImage.naturalWidth;
        const origH = origRotated ? originalImage.naturalWidth : originalImage.naturalHeight;
        const scale = Math.max(w / origW, h / origH);
        const drawW = origW * scale;
        const drawH = origH * scale;
        ctx.drawImage(originalImage, (w - drawW) / 2, (h - drawH) / 2, drawW, drawH);
      }
    }

    // ★ STEP 2: Draw foreground (with transform + filter)
    ctx.save();
    ctx.translate(w / 2, h / 2);
    ctx.rotate((state.rotation * Math.PI) / 180);
    ctx.scale(state.flipH ? -1 : 1, state.flipV ? -1 : 1);
    ctx.translate(-source.naturalWidth / 2, -source.naturalHeight / 2);

    ctx.filter = buildCanvasFilter();
    ctx.drawImage(source, 0, 0);
    ctx.filter = 'none';
    ctx.restore();

    // ★ STEP 3: Vignette on top
    if (state.vignette > 0) {
      const strength = state.vignette / 100;
      const gradient = ctx.createRadialGradient(w / 2, h / 2, Math.min(w, h) * 0.3, w / 2, h / 2, Math.max(w, h) * 0.75);
      gradient.addColorStop(0, 'rgba(0,0,0,0)');
      gradient.addColorStop(1, `rgba(0,0,0,${strength * 0.85})`);
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, w, h);
    }

    ctx.restore();
    updatePreviewBackground();
  }

  function updatePreviewBackground() {
    const previewBg = el('aip-preview-bg');
    if (!previewBg) return;
    if (foregroundImage && bgState.mode === 'transparent') {
      previewBg.style.backgroundImage = 'linear-gradient(45deg, #eee 25%, transparent 25%), linear-gradient(-45deg, #eee 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #eee 75%), linear-gradient(-45deg, transparent 75%, #eee 75%)';
      previewBg.style.backgroundSize = '20px 20px';
      previewBg.style.backgroundPosition = '0 0, 0 10px, 10px -10px, -10px 0px';
    } else {
      previewBg.style.backgroundImage = 'none';
      previewBg.style.backgroundColor = 'transparent';
    }
  }

  // ═══════════════════════════════════════════════════════
  // BACKGROUND REMOVAL
  // ═══════════════════════════════════════════════════════
  el('aip-bg-remove-btn')?.addEventListener('click', async () => {
    if (!originalImage || bgRemovalInProgress) return;
    bgRemovalInProgress = true;

    const statusEl = el('aip-bg-remove-status');
    const progressBox = el('aip-bg-progress');
    const progressBar = el('aip-bg-progress-bar');
    const progressPct = el('aip-bg-progress-pct');
    const progressLabel = el('aip-bg-progress-label');
    const progressStatus = el('aip-bg-progress-status');
    const removeBtn = el('aip-bg-remove-btn');

    if (removeBtn) removeBtn.disabled = true;
    if (statusEl) statusEl.textContent = '';
    if (progressBox) progressBox.classList.remove('hidden');

    const setProgress = (pct, label, statusMsg) => {
      const safe = Math.max(0, Math.min(100, pct));
      if (progressBar) progressBar.style.width = `${safe}%`;
      if (progressPct) progressPct.textContent = `${Math.round(safe)}%`;
      if (label && progressLabel) progressLabel.textContent = label;
      if (statusMsg !== undefined && progressStatus) progressStatus.textContent = statusMsg;
    };

    try {
      setProgress(0, 'Preparing…', 'Loading background removal engine…');

      const { removeBackground } = await import('../../ai/utils/background-remover.js');
      const blob = await removeBackground(selectedFile, {
        onProgress: (p) => {
          const pct = p * 100;
          let label = 'Preparing…';
          let status = 'Loading AI model…';

          if (p < 0.4) {
            label = 'Loading model…';
            status = 'Downloading AI model (cached after first run)';
          } else if (p < 0.9) {
            label = 'Removing background…';
            status = 'Analyzing image and cutting out the subject';
          } else if (p < 1) {
            label = 'Finalizing…';
            status = 'Almost there…';
          } else {
            label = 'Done!';
            status = 'Background removed successfully';
          }

          setProgress(pct, label, status);
        },
      });

      setProgress(97, 'Finalizing…', 'Loading result image…');

      const resultImg = new Image();
      await new Promise((resolve, reject) => {
        resultImg.onload = resolve;
        resultImg.onerror = () => reject(new Error('Could not load processed image'));
        resultImg.src = URL.createObjectURL(blob);
      });

      foregroundImage = resultImg;
      bgState.mode = 'transparent';

      setProgress(100, 'Done!', 'Background removed successfully');

      el('aip-bg-remove-row')?.classList.add('hidden');
      el('aip-bg-options')?.classList.remove('hidden');
      updateBgTypeButtons();
      updateBgSubOptions();

      render();
      renderFilterThumbnails();
      bgRemovalInProgress = false;
    } catch (err) {
      console.error('[photo-editor] background removal failed:', err);
      if (statusEl) statusEl.textContent = `❌ ${err?.message || String(err)}`;
      if (progressBox) progressBox.classList.add('hidden');
      if (removeBtn) removeBtn.disabled = false;
      bgRemovalInProgress = false;
    }
  });

  // ─── Background type buttons ───
  document.querySelectorAll('.aip-bg-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const newMode = btn.dataset.bgType;

      // If switching to 'image' but no image uploaded yet, prompt to upload
      if (newMode === 'image' && !customBgImg) {
        // Update the mode anyway so the picker is visible
        bgState.mode = 'image';
        updateBgTypeButtons();
        updateBgSubOptions();
        // Trigger file picker automatically
        el('aip-bg-image-input')?.click();
        return;
      }

      bgState.mode = newMode;
      updateBgTypeButtons();
      updateBgSubOptions();
      render();
    });
  });

  function updateBgTypeButtons() {
    document.querySelectorAll('.aip-bg-type-btn').forEach(btn => {
      const active = btn.dataset.bgType === bgState.mode;
      btn.style.borderColor = active ? '#0ea5e9' : 'transparent';
      btn.style.background = active ? 'rgba(14, 165, 233, 0.1)' : '';
    });
  }

  function updateBgSubOptions() {
    el('aip-bg-color-picker')?.classList.toggle('hidden', bgState.mode !== 'color');
    el('aip-bg-image-picker')?.classList.toggle('hidden', bgState.mode !== 'image');
    el('aip-bg-blur-picker')?.classList.toggle('hidden', bgState.mode !== 'blur');
  }

  // ─── Color picker ───
  el('aip-bg-color')?.addEventListener('input', (e) => {
    bgState.color = e.target.value;
    if (bgState.mode !== 'color') {
      bgState.mode = 'color';
      updateBgTypeButtons();
      updateBgSubOptions();
    }
    render();
  });

  document.querySelectorAll('.aip-bg-swatch').forEach(btn => {
    btn.addEventListener('click', () => {
      bgState.color = btn.dataset.color;
      if (el('aip-bg-color')) el('aip-bg-color').value = bgState.color;
      bgState.mode = 'color';
      updateBgTypeButtons();
      updateBgSubOptions();
      render();
    });
  });

  // ─── ★ Custom background image ───
  el('aip-bg-image-input')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (customBgURL) { try { URL.revokeObjectURL(customBgURL); } catch {} }
    customBgURL = URL.createObjectURL(file);

    // Load image
    customBgImg = await new Promise((resolve) => {
      const image = new Image();
      image.onload = () => resolve(image);
      image.onerror = () => resolve(null);
      image.src = customBgURL;
    });

    if (!customBgImg) {
      showError('Could not load background image.');
      return;
    }

    // Show thumbnail row
    el('aip-bg-image-row')?.classList.remove('hidden');
    if (el('aip-bg-image-thumb')) el('aip-bg-image-thumb').src = customBgURL;
    if (el('aip-bg-image-name')) el('aip-bg-image-name').textContent = file.name;

    // Switch mode + render
    bgState.mode = 'image';
    updateBgTypeButtons();
    updateBgSubOptions();
    render();
  });

  el('aip-bg-image-remove')?.addEventListener('click', () => {
    if (customBgURL) { try { URL.revokeObjectURL(customBgURL); } catch {} }
    customBgURL = null;
    customBgImg = null;
    el('aip-bg-image-row')?.classList.add('hidden');
    if (el('aip-bg-image-input')) el('aip-bg-image-input').value = '';

    // Fall back to transparent
    bgState.mode = 'transparent';
    updateBgTypeButtons();
    updateBgSubOptions();
    render();
  });

  // ─── Blur slider ───
  el('aip-bg-blur')?.addEventListener('input', (e) => {
    bgState.blurAmount = Number(e.target.value);
    if (el('aip-bg-blur-val')) el('aip-bg-blur-val').textContent = `${bgState.blurAmount}px`;
    render();
  });

  // ─── Restore original photo ───
  el('aip-bg-restore-btn')?.addEventListener('click', () => {
    foregroundImage = null;
    bgState = { ...DEFAULT_BG_STATE };

    if (customBgURL) { try { URL.revokeObjectURL(customBgURL); } catch {} }
    customBgURL = null;
    customBgImg = null;
    el('aip-bg-image-row')?.classList.add('hidden');
    if (el('aip-bg-image-input')) el('aip-bg-image-input').value = '';

    el('aip-bg-options')?.classList.add('hidden');
    el('aip-bg-remove-row')?.classList.remove('hidden');
    el('aip-bg-progress')?.classList.add('hidden');
    el('aip-bg-remove-btn') && (el('aip-bg-remove-btn').disabled = false);
    el('aip-bg-remove-status') && (el('aip-bg-remove-status').textContent = '');

    updateBgSubOptions();
    render();
    renderFilterThumbnails();
  });

  // ─── File upload ───
  const dropZone = el('aip-upload-zone');
  ['dragenter', 'dragover'].forEach(ev => dropZone?.addEventListener(ev, e => { e.preventDefault(); dropZone.classList.add('border-sky-400'); }));
  ['dragleave', 'drop'].forEach(ev => dropZone?.addEventListener(ev, e => { e.preventDefault(); dropZone.classList.remove('border-sky-400'); }));
  dropZone?.addEventListener('drop', e => { const f = e.dataTransfer?.files?.[0]; if (f) handleFile(f); });
  el('aip-browse-btn')?.addEventListener('click', () => el('aip-file-input')?.click());
  el('aip-file-input')?.addEventListener('change', e => { const f = e.target.files?.[0]; if (f) handleFile(f); });

  function handleFile(file) {
    selectedFile = file;
    el('aip-file-name').textContent = file.name;
    el('aip-file-size').textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;

    resetState();

    const image = new Image();
    image.onload = () => {
      img = image;
      originalImage = image;
      state.rotation = 0;
      state.flipH = false;
      state.flipV = false;
      el('aip-selected-card')?.classList.remove('hidden');
      el('aip-editor')?.classList.remove('hidden');
      el('aip-upload-zone')?.classList.add('hidden');
      render();
      buildFiltersGrid();
      renderFilterThumbnails();
    };
    image.onerror = () => showError('Could not load this image.');
    image.src = URL.createObjectURL(file);
  }

  function showError(msg) {
    const box = el('aip-error');
    if (!box) return;
    box.textContent = msg;
    box.classList.remove('hidden');
  }

  // ─── Mode tabs ───
  document.querySelectorAll('.aip-mode-tab').forEach(tab => {
    tab.addEventListener('click', () => switchMode(tab.dataset.mode));
  });

  function switchMode(mode) {
    document.querySelectorAll('.aip-mode-tab').forEach(t => {
      const active = t.dataset.mode === mode;
      t.classList.toggle('bg-sky-500', active);
      t.classList.toggle('text-white', active);
      t.classList.toggle('bg-transparent', !active);
      t.classList.toggle('text-gray-600', !active);
      t.classList.toggle('dark:text-gray-400', !active);
    });
    ['ai', 'filters', 'manual', 'background'].forEach(m => {
      el(`aip-mode-${m}`)?.classList.toggle('hidden', m !== mode);
    });
    if (mode === 'filters' && img) renderFilterThumbnails();
  }

  // ─── AI prompt ───
  document.querySelectorAll('.aip-quick-prompt').forEach(btn => {
    btn.addEventListener('click', () => {
      el('aip-prompt').value = btn.textContent;
    });
  });

  el('aip-apply-prompt')?.addEventListener('click', () => {
    const prompt = el('aip-prompt')?.value?.trim();
    if (!prompt) {
      el('aip-prompt-status').textContent = 'Type or pick a prompt first.';
      return;
    }
    el('aip-prompt-status').textContent = 'Applying style…';
    const { patch, matched } = parsePromptToState(prompt);
    if (matched.length === 0) {
      el('aip-prompt-status').textContent = 'No matching style found. Try: "blur it", "make it brighter", "warm vintage", "black and white".';
      return;
    }
    for (const [k, v] of Object.entries(patch)) state[k] = v;
    syncSlidersToState();
    render();
    setTimeout(() => {
      el('aip-prompt-status').textContent = `✅ Applied: ${matched.slice(0, 5).join(', ')}${matched.length > 5 ? '…' : ''}`;
    }, 200);
  });

  // ─── Filters grid ───
  function buildFiltersGrid() {
    const grid = el('aip-filters-grid');
    if (!grid) return;
    grid.innerHTML = '';

    FILTERS.forEach((filter, idx) => {
      const card = document.createElement('button');
      card.className = 'group flex flex-col items-center gap-1.5 p-1.5 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition';
      card.dataset.filterIdx = String(idx);

      const thumbWrap = document.createElement('div');
      thumbWrap.className = 'w-full aspect-square rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800 border-2 border-transparent group-hover:border-sky-400 transition';

      const thumbCanvas = document.createElement('canvas');
      thumbCanvas.className = 'w-full h-full block';
      thumbCanvas.style.width = '100%';
      thumbCanvas.style.height = '100%';
      thumbCanvas.style.objectFit = 'cover';
      thumbWrap.appendChild(thumbCanvas);

      const nameEl = document.createElement('span');
      nameEl.className = 'text-[10px] font-medium text-gray-700 dark:text-gray-300 text-center';
      nameEl.textContent = filter.name;

      card.appendChild(thumbWrap);
      card.appendChild(nameEl);

      card.addEventListener('click', () => applyFilter(filter));
      grid.appendChild(card);
    });

    if (img) renderFilterThumbnails();
  }

  function renderFilterThumbnails() {
    const source = foregroundImage || img;
    if (!source) return;
    const cards = document.querySelectorAll('[data-filter-idx]');
    if (cards.length === 0) return;

    cards.forEach(card => {
      const idx = Number(card.dataset.filterIdx);
      const filter = FILTERS[idx];
      const thumbCanvas = card.querySelector('canvas');
      if (!thumbCanvas) return;

      const SIZE = 200;
      thumbCanvas.width = SIZE;
      thumbCanvas.height = SIZE;
      const tCtx = thumbCanvas.getContext('2d');

      const imgAspect = source.naturalWidth / source.naturalHeight;
      let sx = 0, sy = 0, sw = source.naturalWidth, sh = source.naturalHeight;
      if (imgAspect > 1) {
        sw = source.naturalHeight;
        sx = (source.naturalWidth - sw) / 2;
      } else {
        sh = source.naturalWidth;
        sy = (source.naturalHeight - sh) / 2;
      }

      tCtx.filter = buildFilterString(filter.state);
      tCtx.drawImage(source, sx, sy, sw, sh, 0, 0, SIZE, SIZE);
      tCtx.filter = 'none';

      if (filter.state.vignette > 0) {
        const strength = filter.state.vignette / 100;
        const gradient = tCtx.createRadialGradient(SIZE / 2, SIZE / 2, SIZE * 0.25, SIZE / 2, SIZE / 2, SIZE * 0.7);
        gradient.addColorStop(0, 'rgba(0,0,0,0)');
        gradient.addColorStop(1, `rgba(0,0,0,${strength * 0.85})`);
        tCtx.fillStyle = gradient;
        tCtx.fillRect(0, 0, SIZE, SIZE);
      }
    });
  }

  function buildFilterString(patch) {
    const s = { ...DEFAULT_STATE, ...patch };
    const parts = [];
    if (s.brightness) parts.push(`brightness(${100 + s.brightness}%)`);
    if (s.contrast) parts.push(`contrast(${100 + s.contrast}%)`);
    if (s.saturation) parts.push(`saturate(${100 + s.saturation}%)`);
    if (s.blur) parts.push(`blur(${s.blur}px)`);
    if (s.grayscale) parts.push(`grayscale(${s.grayscale}%)`);
    if (s.warmth > 0) parts.push(`sepia(${Math.min(100, s.warmth * 0.6)}%)`);
    if (s.warmth < 0) parts.push(`hue-rotate(${s.warmth * 0.3}deg)`);
    return parts.length ? parts.join(' ') : 'none';
  }

  function applyFilter(filter) {
    state = { ...DEFAULT_STATE, rotation: state.rotation, flipH: state.flipH, flipV: state.flipV, ...filter.state };
    syncSlidersToState();
    render();
    el('aip-prompt-status').textContent = `✅ Applied filter: ${filter.name}`;
  }

  // ─── Manual sliders ───
  SLIDER_IDS.forEach(id => {
    const input = el(`aip-${id}`);
    if (!input || input.dataset.bound) return;
    input.dataset.bound = '1';
    const handler = () => {
      state[id] = Number(input.value);
      updateSliderLabels();
      render();
    };
    input.addEventListener('input', handler);
    input.addEventListener('change', handler);
  });

  el('aip-reset-manual')?.addEventListener('click', () => {
    for (const id of SLIDER_IDS) state[id] = 0;
    syncSlidersToState();
    render();
  });

  el('aip-reset-all')?.addEventListener('click', resetState);

  // ─── Transform buttons ───
  document.querySelectorAll('.aip-transform-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.transform;
      if (action === 'rotate-left') state.rotation = (state.rotation - 90 + 360) % 360;
      else if (action === 'rotate-right') state.rotation = (state.rotation + 90) % 360;
      else if (action === 'flip-h') state.flipH = !state.flipH;
      else if (action === 'flip-v') state.flipV = !state.flipV;
      render();
    });
  });

  // ─── Download ───
  el('aip-download-btn')?.addEventListener('click', () => {
    canvas.toBlob((blob) => {
      if (!blob) return;
      const base = selectedFile ? selectedFile.name.replace(/\.[^.]+$/, '') : 'edited';
      downloadBlob(blob, `${base}-edited.png`);
    }, 'image/png', 0.95);
  });

  // ─── Reset everything ───
  el('aip-again-btn')?.addEventListener('click', () => {
    if (img) { try { URL.revokeObjectURL(img.src); } catch {} }
    if (foregroundImage) { try { URL.revokeObjectURL(foregroundImage.src); } catch {} }
    if (customBgURL) { try { URL.revokeObjectURL(customBgURL); } catch {} }

    img = null;
    originalImage = null;
    foregroundImage = null;
    selectedFile = null;
    customBgURL = null;
    customBgImg = null;

    resetState();
    el('aip-editor')?.classList.add('hidden');
    el('aip-selected-card')?.classList.add('hidden');
    el('aip-upload-zone')?.classList.remove('hidden');
    if (el('aip-file-input')) el('aip-file-input').value = '';
    if (el('aip-prompt')) el('aip-prompt').value = '';
    if (el('aip-prompt-status')) el('aip-prompt-status').textContent = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  buildFiltersGrid();
</script>