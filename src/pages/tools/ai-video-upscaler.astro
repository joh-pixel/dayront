---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "ai-video-upscaler",
  name: "AI Video Upscaler",
  metaTitle: "AI Video Upscaler – Upscale to 4K with AI Online Free | Dayront",
  metaDescription: "Upscale videos to 4K Ultra HD with AI directly in your browser. No uploads, 100% private, powered by WebGPU.",
  icon: "✨",
  howTo: [
    { title: "Upload your video", text: "Select the low-resolution video you want to enhance." },
    { title: "Choose an AI model", text: "Pick a speed/quality balance for the AI upscaling." },
    { title: "Upscale in browser", text: "The AI processes each frame on your GPU. Download the HD video when done." }
  ],
  faq: [
    { question: "Is it really free?", answer: "Yes, all processing happens on your device — no servers, no limits." },
    { question: "Does it work on mobile?", answer: "Currently requires a desktop browser with WebGPU (Chrome or Edge 113+)." },
    { question: "What AI model is used?", answer: "We use WebSR (Anime4K CNN) running on WebGPU for real-time video upscaling." },
    { question: "Are my videos uploaded anywhere?", answer: "No. Your video never leaves your device. 100% private." }
  ],
  relatedTools: [
    { href: "/tools/ai-frame-interpolation", icon: "🎞️", name: "AI Frame Interpolation" },
    { href: "/tools/resize-video", icon: "↔️", name: "Resize Video" },
    { href: "/tools/video-compressor", icon: "📉", name: "Video Compressor" }
  ],
  type: "ai-upscale",
  from: undefined,
  to: undefined,
  outputFormat: "mp4",
  settings: [
    { name: "model", label: "AI Model", type: "select", options: ["anime4k/cnn-2x-s", "anime4k/cnn-2x-m"], default: "anime4k/cnn-2x-s" }
  ],
  tutorial: `
    <h2>Using Our AI Video Upscaler</h2>
    <p>Unlike traditional upscalers that just stretch pixels and blur your video, our AI Video Upscaler uses a neural network running directly on your GPU (WebGPU) to intelligently reconstruct detail frame by frame. The result is a sharper, cleaner video at up to 2× the original resolution.</p>
    <h3>Why Choose Dayront?</h3>
    <ul>
      <li>No uploads – your videos stay on your device.</li>
      <li>Powered by WebGPU for real-time AI inference.</li>
      <li>Completely free, no registration, no watermarks.</li>
    </ul>
    <h3>Tips for Best Results</h3>
    <ul>
      <li>Use videos that are already reasonably sharp (AI won't fix heavily compressed footage).</li>
      <li>Shorter clips complete faster — try a 5–10 second sample first.</li>
      <li>Close other GPU-heavy tabs (games, other AI tools) for maximum performance.</li>
    </ul>
  `,
  relatedBlogs: [
    { slug: "the-complete-guide-to-converting-video-to-audio", title: "The Complete Guide to Converting Video to Audio: MP4, MOV, MKV to MP3" }
  ]
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>