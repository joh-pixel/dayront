---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "change-fps",
  name: "Change FPS",
  metaTitle: "Change FPS – Adjust Frame Rate Online Free | Dayront",
  metaDescription: "Change FPS of MP4, WebM, MOV videos. No upload, private.",
  icon: "⏱️",
  howTo: [{"title":"Upload video","text":"Select a video."},{"title":"Choose new frame rate","text":"Enter FPS."},{"title":"Download video","text":"Get the video with the new frame rate."}],
  faq: [],
  relatedTools: [{"href":"/tools/video-compressor","icon":"📉","name":"Video Compressor"},{"href":"/tools/speed-changer","icon":"⏩","name":"Speed Changer"}],
  type: "change-fps",
  from: undefined,
  to: undefined,
  outputFormat: "mp4",
  settings: [{"name":"fps","label":"New FPS","type":"number","min":1,"max":60,"default":30}],
  tutorial: "\n    <h2>Using Our Change FPS</h2>\n    <p>Our Change FPS tool is designed to be simple and private. Upload your file, adjust any settings, and download the processed result – all inside your browser. No data ever leaves your device.</p>\n    <h3>Why Choose Dayront?</h3>\n    <ul>\n      <li>No uploads – your files stay on your device.</li>\n      <li>Fast processing using the latest browser technology.</li>\n      <li>Completely free, no registration required.</li>\n    </ul>\n  ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
