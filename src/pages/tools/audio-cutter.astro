---
import ToolLayout from '../../layouts/ToolLayout.astro';

const page = {
  metaTitle: 'Audio Cutter – Trim MP3, WAV Online Free | Dayront',
  metaDescription:
    'Cut audio files online without uploading. Trim MP3, WAV, M4A, and more. 100% private, works in your browser.',
  toolName: 'Audio Cutter',
  toolIcon: '✂️',
  toolConfig: {
    type: 'cut',
    outputFormat: 'mp3',
    label: 'Audio Cutter',
  } as const,
  howTo: [
    {
      title: 'Select your audio file',
      text: 'Click or drag & drop your audio file into the upload area.',
    },
    {
      title: 'Adjust the cut points',
      text: 'Use the sliders to set the start and end of the segment you want to keep.',
    },
    {
      title: 'Download the trimmed audio',
      text: 'Click "Cut Audio" and your trimmed file will be ready to download instantly.',
    },
  ],
  faq: [
    {
      question: 'Is it really free?',
      answer: 'Yes, completely free. No hidden costs.',
    },
    {
      question: 'Do my files leave my device?',
      answer:
        'No. All cutting happens locally in your browser. We never see your files.',
    },
    {
      question: 'What formats are supported?',
      answer: 'MP3, WAV, M4A, OGG, FLAC, and more.',
    },
  ],
  relatedTools: [
    { href: '/tools/audio-merger', icon: '🔗', name: 'Audio Merger' },
    { href: '/tools/audio-compressor', icon: '📦', name: 'Audio Compressor' },
    { href: '/convert/mp3-to-wav', icon: '🎵', name: 'MP3 to WAV' },
  ],
};
---

<ToolLayout {...page} />