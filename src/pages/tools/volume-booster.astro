---
import BaseLayout from '../../layouts/BaseLayout.astro';

import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "volume-booster",
  name: "Volume Booster",
  metaTitle: "Volume Booster – Increase Audio Volume Online Free | Dayront",
  metaDescription: "Make audio files louder instantly. No upload, 100% private.",
  icon: "🔊",
  howTo: [{"title":"Select your audio file","text":"Choose a quiet track."},{"title":"Boost the volume","text":"Safe gain applied."},{"title":"Download louder file","text":"Save boosted audio."}],
  faq: [{"question":"Will it distort?","answer":"No, we prevent clipping."},{"question":"How much louder?","answer":"+6 dB by default."},{"question":"Supported formats?","answer":"MP3, WAV, M4A, OGG, FLAC."}],
  relatedTools: [{"href":"/tools/audio-compressor","icon":"📦","name":"Audio Compressor"},{"href":"/tools/speed-changer","icon":"⏩","name":"Speed Changer"},{"href":"/convert/mp3-to-wav","icon":"🎵","name":"MP3 to WAV"}],
  type: "boost",
  from: undefined,
  to: undefined,
  outputFormat: "mp3",
  settings: [{"name":"gain","label":"Gain (dB)","type":"number","min":1,"max":20,"default":6}],
  tutorial: "\n    <h2>Using Our Volume Booster</h2>\n    <p>Our Volume Booster tool is designed to be simple and private. Upload your file, adjust any settings, and download the processed result – all inside your browser. No data ever leaves your device.</p>\n    <h3>Why Choose Dayront?</h3>\n    <ul>\n      <li>No uploads – your files stay on your device.</li>\n      <li>Fast processing using the latest browser technology.</li>\n      <li>Completely free, no registration required.</li>\n    </ul>\n  ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
