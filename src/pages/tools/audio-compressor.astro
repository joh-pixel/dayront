---
import ToolLayout from '../../layouts/ToolLayout.astro';

const page = {
  metaTitle: 'Audio Compressor – Reduce Audio File Size Online | Dayront',
  metaDescription:
    'Compress MP3, WAV, M4A files directly in your browser. No uploads, 100% private, free.',
  toolName: 'Audio Compressor',
  toolIcon: '📦',
  toolConfig: {
    type: 'compress',
    outputFormat: 'mp3',
    label: 'Audio Compressor',
  } as const,
  howTo: [
    {
      title: 'Upload your audio file',
      text: 'Select the file you want to make smaller.',
    },
    {
      title: 'Choose compression strength',
      text: 'Adjust the quality slider – smaller size or higher quality.',
    },
    {
      title: 'Download the compressed file',
      text: 'Get a lighter file instantly, with no noticeable quality loss.',
    },
  ],
  faq: [
    {
      question: 'Will the quality suffer?',
      answer:
        'Our smart compression keeps the audio clear while reducing file size.',
    },
    {
      question: 'Is my file safe?',
      answer:
        'Yes, everything happens on your device. We don’t see or store your file.',
    },
    {
      question: 'Which formats can I compress?',
      answer: 'MP3, WAV, M4A, OGG, FLAC – all popular audio types.',
    },
  ],
  relatedTools: [
    { href: '/tools/volume-booster', icon: '🔊', name: 'Volume Booster' },
    { href: '/tools/audio-cutter', icon: '✂️', name: 'Audio Cutter' },
    { href: '/convert/mp3-to-wav', icon: '🎵', name: 'MP3 to WAV' },
  ],
};
---

<ToolLayout {...page} />