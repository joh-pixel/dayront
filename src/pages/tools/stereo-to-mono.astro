---
import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "stereo-to-mono",
  name: "Stereo to Mono",
  metaTitle: "Stereo to Mono Converter – Free Online Tool | Dayront",
  metaDescription: "Convert stereo audio to mono instantly. No upload, 100% private.",
  icon: "🔉",
  howTo: [{"title":"Upload stereo file","text":"Select an audio file."},{"title":"Convert automatically","text":"Mixed to mono."},{"title":"Download mono file","text":"Save single-channel audio."}],
  faq: [{"question":"Why convert to mono?","answer":"Smaller files, same audio in both ears."},{"question":"Quality lost?","answer":"Combined signal preserves clarity."},{"question":"All formats?","answer":"MP3, WAV, M4A, FLAC, OGG."}],
  relatedTools: [{"href":"/tools/audio-cutter","icon":"✂️","name":"Audio Cutter"},{"href":"/tools/volume-booster","icon":"🔊","name":"Volume Booster"},{"href":"/convert/mp3-to-wav","icon":"🎵","name":"MP3 to WAV"}],
  type: "stereo-to-mono",
  from: undefined,
  to: undefined,
  outputFormat: "mp3",
  settings: [],
  tutorial: "\n    <h2>Using Our Stereo to Mono</h2>\n    <p>Our Stereo to Mono tool is designed to be simple and private. Upload your file, adjust any settings, and download the processed result – all inside your browser. No data ever leaves your device.</p>\n    <h3>Why Choose Dayront?</h3>\n    <ul>\n      <li>No uploads – your files stay on your device.</li>\n      <li>Fast processing using the latest browser technology.</li>\n      <li>Completely free, no registration required.</li>\n    </ul>\n  ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
