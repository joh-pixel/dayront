---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MockupPlayer from '../../components/music/MockupPlayer.tsx';
---
<BaseLayout title="Spotify Mockup Player Generator | Dayront" description="Create pixel-perfect Spotify cards and iOS lockscreen mockups. Download as transparent PNG for your video thumbnails.">
  <main class="max-w-4xl mx-auto px-4 py-12 text-gray-900 dark:text-gray-100">
    <header class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-sky-100 text-3xl mb-4">📱</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold mb-4">Mockup Player Generator</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">Design clean, viral social media graphics in seconds. No Canva needed.</p>
    </header>
    <MockupPlayer client:load />
  </main>
</BaseLayout>