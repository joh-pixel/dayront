---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "ai-video-captions",
  name: "AI Video Captions",
  metaTitle: "AI Video Captions – Auto Subtitle Generator Free | Dayront",
  metaDescription: "Generate automatic captions and subtitles for videos or audio with AI. No uploads, 100% private, exports .SRT.",
  icon: "📝",
  howTo: [
    { title: "Upload video or audio", text: "Select an MP4, MOV, WebM, MP3, or WAV file." },
    { title: "AI transcribes with Whisper", text: "The Whisper model runs in your browser to convert speech to text." },
    { title: "Download your captions", text: "Copy the transcript or export a standard .SRT subtitle file." }
  ],
  faq: [
    { question: "Which languages are supported?", answer: "The default model supports English. Other languages are coming soon via multilingual Whisper models." },
    { question: "Is my audio uploaded?", answer: "Never. Everything — including the AI model — runs entirely in your browser." },
    { question: "Can I edit the captions?", answer: "Yes, the output is fully editable text. Copy it, tweak it, then export as .SRT." },
    { question: "How accurate is it?", answer: "Whisper is state-of-the-art. Accuracy is typically 90%+ for clear English speech." }
  ],
  relatedTools: [
    { href: "/tools/extract-audio", icon: "🎧", name: "Extract Audio" },
    { href: "/tools/ai-video-upscaler", icon: "✨", name: "AI Video Upscaler" },
    { href: "/tools/mute-video", icon: "🔇", name: "Mute Video" }
  ],
  type: "ai-captions",
  from: undefined,
  to: undefined,
  outputFormat: "mp4",
  settings: [],
  tutorial: `
    <h2>Using Our AI Video Captions</h2>
    <p>Our AI Video Captions tool uses OpenAI's Whisper model, running directly in your browser via Transformers.js and WebGPU. It listens to your video's audio track, converts speech into text with timestamps, and lets you export a standard .SRT subtitle file ready for YouTube, Vimeo, or any editing software.</p>
    <h3>Why Choose Dayront?</h3>
    <ul>
      <li>No uploads – your media stays on your device.</li>
      <li>Powered by OpenAI Whisper — the same model used by professional tools.</li>
      <li>Free, unlimited, and 100% private.</li>
    </ul>
    <h3>What You Get</h3>
    <ul>
      <li>Full transcript with timestamps.</li>
      <li>One-click export to .SRT subtitle format.</li>
      <li>Editable text you can copy anywhere.</li>
    </ul>
  `,
  relatedBlogs: []
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
  }}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>