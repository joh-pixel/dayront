---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromAstroUrl } from '../lib/i18n';
import { tools } from '../lib/tools';

// ★ Page-specific styles — extracted to a separate file
import '../styles/tools.css';

const lang = getLangFromAstroUrl(Astro.url);

// Load translation files
let toolsTrans: Record<string, any> = {};
let commonTrans: Record<string, any> = {};

try {
  const [toolsRes, commonRes] = await Promise.all([
    fetch(new URL(`/locales/${lang}/tools.json`, Astro.url.origin)),
    fetch(new URL(`/locales/${lang}/common.json`, Astro.url.origin)),
  ]);

  if (toolsRes.ok) toolsTrans = await toolsRes.json();
  if (commonRes.ok) commonTrans = await commonRes.json();
} catch {}

/* ------------------------------------------------------------------------
   TRANSLATION HELPERS
------------------------------------------------------------------------ */
const t = (key: string, fallback: string) =>
  commonTrans[key] || fallback;

function translateTool(tool: typeof tools[0]) {
  const tt = toolsTrans[tool.slug] || {};

  return {
    slug: tool.slug,
    name: tt.title || tool.name,
    icon: tt.icon || tool.icon,
    category: tool.category,
    from: tool.from,
    to: tool.to,
    url:
      tool.from && tool.to
        ? `/convert/${tool.slug}`
        : `/tools/${tool.slug}`,
  };
}

const translatedTools = tools.map(translateTool);

/* ------------------------------------------------------------------------
   CATEGORIES
------------------------------------------------------------------------ */
const allCategories = [
  ...new Set(tools.map((tool) => tool.category)),
];

const categoryLabels: Record<string, string> = {};

for (const cat of allCategories) {
  const labelKey = `category_${cat}`.replace(/-/g, '_');

  const fallback = cat
    .split('-')
    .map((word) => word[0].toUpperCase() + word.slice(1))
    .join(' ');

  categoryLabels[cat] =
    commonTrans[labelKey] || fallback;
}

const categoryIcons: Record<string, string> = {
  'audio-utility': '🛠️',
  'audio-conversion': '🎵',
  'video-to-audio': '🎬',
  'video-utility': '🎞️',
  'video-conversion': '🔄',
};

/* ------------------------------------------------------------------------
   CLIENT DATA
------------------------------------------------------------------------ */
const toolsJson = JSON.stringify(translatedTools);
const categoryLabelsJson = JSON.stringify(categoryLabels);
const categoryIconsJson = JSON.stringify(categoryIcons);

const pageTitle = t('tools_page_title', 'All Media Tools – Free & Private | Dayront');
const pageDesc = t('tools_page_desc', 'Browse all free online media tools. Convert, cut, merge, boost, and enhance your audio and video files directly in your browser. 100% private, no sign-up, no uploads required.');
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDesc}
>
  <!-- HERO -->
  <section class="tools-hero relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="hero-glow hero-glow-three"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 pt-14 pb-10 sm:pt-20 sm:pb-14">
      <div class="max-w-3xl">
        <div class="privacy-badge">
          <span class="status-dot"></span>
          <span data-i18n="privacy_first_badge">Privacy-first media processing</span>
        </div>

        <h1 class="hero-title">
          <span data-i18n="tools_hero_heading">All Your Media Tools</span>
          <span>
            <span data-i18n="tools_hero_subheading">In One Place.</span>
          </span>
        </h1>

        <p class="hero-description">
          <span data-i18n="tools_hero_desc">Everything you need to convert, edit, combine, enhance, and process audio and video files directly in your browser.</span>
        </p>

        <div class="feature-pills">
          <div class="feature-pill">
            <span>🔒</span>
            <span data-i18n="no_uploads">No uploads</span>
          </div>

          <div class="feature-pill">
            <span>⚡</span>
            <span data-i18n="fast_processing">Fast processing</span>
          </div>

          <div class="feature-pill">
            <span>🆓</span>
            <span data-i18n="free_to_use">Free to use</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="max-w-7xl mx-auto px-4 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">

      <div class="stat-card reveal">
        <p class="stat-number">{tools.length}+</p>
        <p class="stat-label">
          <span data-i18n="free_tools">Free tools</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">100%</p>
        <p class="stat-label">
          <span data-i18n="browser_based">Browser based</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">0</p>
        <p class="stat-label">
          <span data-i18n="server_uploads">Server uploads</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">24/7</p>
        <p class="stat-label">
          <span data-i18n="available_online">Available online</span>
        </p>
      </div>

    </div>
  </section>

  <!-- SEARCH -->
  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="search-panel reveal">

      <div class="search-header">

        <div>
          <p class="section-kicker">
            <span data-i18n="find_tool">FIND A TOOL</span>
          </p>

          <h2 class="section-title">
            <span data-i18n="what_do_you_want">What do you want to do?</span>
          </h2>

          <p class="section-description">
            <span data-i18n="search_or_browse">Search by tool name or browse by category.</span>
          </p>
        </div>

        <div class="search-controls">

          <div class="search-box">
            <svg
              class="search-icon"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path
                stroke-linecap="round"
                d="m21 21-4.35-4.35"
              ></path>
            </svg>

            <input
              id="tool-search"
              type="text"
              placeholder="Search tools..."
              aria-label="Search tools"
              autocomplete="off"
            />

            <button
              id="clear-search"
              type="button"
              aria-label="Clear search"
            >
              ×
            </button>
          </div>

          <select
            id="tool-filter"
            aria-label="Filter tools by category"
          >
            <option value="all">
              <span data-i18n="all_categories">All Categories</span>
            </option>

            {
              Object.entries(categoryLabels).map(
                ([value, label]) => (
                  <option value={value}>
                    {label}
                  </option>
                )
              )
            }
          </select>

          <div class="view-toggle">
            <button
              id="view-grid"
              type="button"
              class="view-button active"
            >
              <span data-i18n="grid">Grid</span>
            </button>

            <button
              id="view-list"
              type="button"
              class="view-button"
            >
              <span data-i18n="list">List</span>
            </button>
          </div>

        </div>
      </div>

      <!-- CATEGORY PILLS -->
      <div class="category-pills">

        <button
          type="button"
          data-category="all"
          class="category-pill active"
        >
          <span data-i18n="all_tools">All Tools</span>
        </button>

        {
          Object.entries(categoryLabels).map(
            ([value, label]) => (
              <button
                type="button"
                data-category={value}
                class="category-pill"
              >
                {categoryIcons[value] || ''}
                <span>{label}</span>
              </button>
            )
          )
        }

      </div>

      <div class="results-bar">

        <p id="result-count">
          {t(
            'showing_tools',
            'Showing {count} tools'
          ).replace(
            '{count}',
            String(tools.length)
          )}
        </p>

        <span class="browser-status">
          <span></span>
          <span data-i18n="processing_in_browser">Processing stays in your browser</span>
        </span>

      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="max-w-7xl mx-auto px-4 pb-20">

    <div
      id="tool-grid"
      class="tool-grid"
    >
      {
        translatedTools.map((tool, index) => (
          <a
            href={tool.url}
            class="tool-card group"
            data-tool-name={tool.name}
            data-tool-category={tool.category}
            style={`--delay:${Math.min(index * 35, 350)}ms`}
          >
            <div class="card-glow"></div>

            <div class="tool-card-top">

              <div class="tool-icon">
                {tool.icon}
              </div>

              <svg
                class="arrow-icon"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"
                />
              </svg>

            </div>

            <div class="tool-card-content">

              <p class="tool-name">
                {tool.name}
              </p>

              <span class="tool-category">
                {
                  categoryLabels[tool.category] ||
                  tool.category
                }
              </span>

            </div>
          </a>
        ))
      }
    </div>

    <!-- EMPTY -->
    <div
      id="empty-state"
      class="empty-state hidden"
    >
      <div class="empty-icon">
        🔎
      </div>

      <h3>
        <span data-i18n="no_tools_found">No tools found</span>
      </h3>

      <p>
        <span data-i18n="try_another_search">Try another search term or choose a different category.</span>
      </p>

      <button
        id="reset-tools"
        type="button"
      >
        <span data-i18n="show_all_tools">Show all tools</span>
      </button>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="max-w-7xl mx-auto px-4 pb-20">

    <div class="privacy-callout reveal">

      <div class="privacy-glow"></div>

      <div class="relative max-w-3xl">

        <div class="privacy-heading">
          <span>🔒</span>
          <span data-i18n="privacy_first_by_design">PRIVACY-FIRST BY DESIGN</span>
        </div>

        <h2>
          <span data-i18n="files_belong_to_you">Your files belong to you.</span>
        </h2>

        <p>
          {t(
            'privacy_callout_desc',
            'Dayront is designed to process media directly in your browser. Your files don\'t need to be uploaded to a remote server just to perform a simple conversion or edit.'
          )}
        </p>

        <div class="privacy-features">

          <div>
            <strong>
              <span data-i18n="no_account">No account</span>
            </strong>
            <span>
              <span data-i18n="start_immediately">Start immediately</span>
            </span>
          </div>

          <div>
            <strong>
              <span data-i18n="no_upload">No upload</span>
            </strong>
            <span>
              <span data-i18n="local_processing">Local processing</span>
            </span>
          </div>

          <div>
            <strong>
              <span data-i18n="free_tools_callout">Free tools</span>
            </strong>
            <span>
              <span data-i18n="no_hidden_fees">No hidden fees</span>
            </span>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{
  toolsData: toolsJson,
  categoryLabels: categoryLabelsJson,
  categoryIcons: categoryIconsJson
}}>
  const tools = JSON.parse(toolsData);
  const labels = JSON.parse(categoryLabels);
  const icons = JSON.parse(categoryIcons);

  const searchInput =
    document.querySelector('#tool-search');

  const clearButton =
    document.querySelector('#clear-search');

  const categoryFilter =
    document.querySelector('#tool-filter');

  const grid =
    document.querySelector('#tool-grid');

  const emptyState =
    document.querySelector('#empty-state');

  const resultCount =
    document.querySelector('#result-count');

  const resetButton =
    document.querySelector('#reset-tools');

  const gridButton =
    document.querySelector('#view-grid');

  const listButton =
    document.querySelector('#view-list');

  const categoryPills =
    document.querySelectorAll('.category-pill');

  function updateTools() {
    if (!searchInput || !categoryFilter || !grid) return;

    const search =
      searchInput.value.trim().toLowerCase();

    const category =
      categoryFilter.value;

    let visible = 0;

    const cards =
      grid.querySelectorAll('.tool-card');

    cards.forEach((card) => {
      const name =
        card.dataset.toolName?.toLowerCase() || '';

      const cardCategory =
        card.dataset.toolCategory || '';

      const matchesSearch =
        !search ||
        name.includes(search);

      const matchesCategory =
        category === 'all' ||
        cardCategory === category;

      const show =
        matchesSearch &&
        matchesCategory;

      card.style.display =
        show ? '' : 'none';

      if (show) visible++;
    });

    if (resultCount) {
      const template =
        'Showing {count} tools';

      resultCount.textContent =
        template.replace(
          '{count}',
          String(visible)
        );
    }

    if (emptyState) {
      emptyState.classList.toggle(
        'hidden',
        visible !== 0
      );
    }

    if (clearButton) {
      clearButton.classList.toggle(
        'visible',
        searchInput.value.length > 0
      );
    }
  }

  function setCategory(category) {
    if (!categoryFilter) return;

    categoryFilter.value = category;

    categoryPills.forEach((pill) => {
      pill.classList.toggle(
        'active',
        pill.dataset.category === category
      );
    });

    updateTools();
  }

  searchInput?.addEventListener(
    'input',
    updateTools
  );

  categoryFilter?.addEventListener(
    'change',
    () => {
      setCategory(categoryFilter.value);
    }
  );

  clearButton?.addEventListener(
    'click',
    () => {
      if (!searchInput) return;

      searchInput.value = '';
      updateTools();
      searchInput.focus();
    }
  );

  categoryPills.forEach((pill) => {
    pill.addEventListener(
      'click',
      () => {
        setCategory(
          pill.dataset.category || 'all'
        );
      }
    );
  });

  resetButton?.addEventListener(
    'click',
    () => {
      if (searchInput) {
        searchInput.value = '';
      }

      setCategory('all');
    }
  );

  gridButton?.addEventListener(
    'click',
    () => {
      grid?.classList.remove('list-view');

      gridButton.classList.add('active');
      listButton?.classList.remove('active');
    }
  );

  listButton?.addEventListener(
    'click',
    () => {
      grid?.classList.add('list-view');

      listButton.classList.add('active');
      gridButton?.classList.remove('active');
    }
  );

  updateTools();
</script>