---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromAstroUrl } from '../lib/i18n';
import { tools } from '../lib/tools';

const lang = getLangFromAstroUrl(Astro.url);

// Load translation files
let toolsTrans: Record<string, any> = {};
let commonTrans: Record<string, any> = {};

try {
  const [toolsRes, commonRes] = await Promise.all([
    fetch(new URL(`/locales/${lang}/tools.json`, Astro.url.origin)),
    fetch(new URL(`/locales/${lang}/common.json`, Astro.url.origin)),
  ]);

  if (toolsRes.ok) toolsTrans = await toolsRes.json();
  if (commonRes.ok) commonTrans = await commonRes.json();
} catch {}

/* ------------------------------------------------------------------------
   TRANSLATION HELPERS
------------------------------------------------------------------------ */
const t = (key: string, fallback: string) =>
  commonTrans[key] || fallback;

function translateTool(tool: typeof tools[0]) {
  const tt = toolsTrans[tool.slug] || {};

  return {
    slug: tool.slug,
    name: tt.title || tool.name,
    icon: tt.icon || tool.icon,
    category: tool.category,
    from: tool.from,
    to: tool.to,
    // UPDATED: Removed ?lang=${lang} from both URLs
    url:
      tool.from && tool.to
        ? `/convert/${tool.slug}`
        : `/tools/${tool.slug}`,
  };
}

const translatedTools = tools.map(translateTool);

/* ------------------------------------------------------------------------
   CATEGORIES
------------------------------------------------------------------------ */
const allCategories = [
  ...new Set(tools.map((tool) => tool.category)),
];

const categoryLabels: Record<string, string> = {};

for (const cat of allCategories) {
  const labelKey = `category_${cat}`.replace(/-/g, '_');

  const fallback = cat
    .split('-')
    .map((word) => word[0].toUpperCase() + word.slice(1))
    .join(' ');

  categoryLabels[cat] =
    commonTrans[labelKey] || fallback;
}

const categoryIcons: Record<string, string> = {
  'audio-utility': '🛠️',
  'audio-conversion': '🎵',
  'video-to-audio': '🎬',
  'video-utility': '🎞️',
  'video-conversion': '🔄',
};

/* ------------------------------------------------------------------------
   CLIENT DATA
------------------------------------------------------------------------ */
const toolsJson = JSON.stringify(translatedTools);
const categoryLabelsJson = JSON.stringify(categoryLabels);
const categoryIconsJson = JSON.stringify(categoryIcons);

// Get translated strings for props
const pageTitle = t('tools_page_title', 'All Media Tools – Free & Private | Dayront');
const pageDesc = t('tools_page_desc', 'Browse all free online media tools. Convert, cut, merge, boost, and enhance your audio and video files directly in your browser. 100% private, no sign-up, no uploads required.');
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={pageDesc}
>
  <!-- HERO -->
  <section class="tools-hero relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="hero-glow hero-glow-three"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 pt-14 pb-10 sm:pt-20 sm:pb-14">
      <div class="max-w-3xl">
        <div class="privacy-badge">
          <span class="status-dot"></span>
          <span data-i18n="privacy_first_badge">Privacy-first media processing</span>
        </div>

        <h1 class="hero-title">
          <span data-i18n="tools_hero_heading">All Your Media Tools</span>
          <span>
            <span data-i18n="tools_hero_subheading">In One Place.</span>
          </span>
        </h1>

        <p class="hero-description">
          <span data-i18n="tools_hero_desc">Everything you need to convert, edit, combine, enhance, and process audio and video files directly in your browser.</span>
        </p>

        <div class="feature-pills">
          <div class="feature-pill">
            <span>🔒</span>
            <span data-i18n="no_uploads">No uploads</span>
          </div>

          <div class="feature-pill">
            <span>⚡</span>
            <span data-i18n="fast_processing">Fast processing</span>
          </div>

          <div class="feature-pill">
            <span>🆓</span>
            <span data-i18n="free_to_use">Free to use</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="max-w-7xl mx-auto px-4 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">

      <div class="stat-card reveal">
        <p class="stat-number">{tools.length}+</p>
        <p class="stat-label">
          <span data-i18n="free_tools">Free tools</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">100%</p>
        <p class="stat-label">
          <span data-i18n="browser_based">Browser based</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">0</p>
        <p class="stat-label">
          <span data-i18n="server_uploads">Server uploads</span>
        </p>
      </div>

      <div class="stat-card reveal">
        <p class="stat-number">24/7</p>
        <p class="stat-label">
          <span data-i18n="available_online">Available online</span>
        </p>
      </div>

    </div>
  </section>

  <!-- SEARCH -->
  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="search-panel reveal">

      <div class="search-header">

        <div>
          <p class="section-kicker">
            <span data-i18n="find_tool">FIND A TOOL</span>
          </p>

          <h2 class="section-title">
            <span data-i18n="what_do_you_want">What do you want to do?</span>
          </h2>

          <p class="section-description">
            <span data-i18n="search_or_browse">Search by tool name or browse by category.</span>
          </p>
        </div>

        <div class="search-controls">

          <div class="search-box">
            <svg
              class="search-icon"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path
                stroke-linecap="round"
                d="m21 21-4.35-4.35"
              ></path>
            </svg>

            <input
              id="tool-search"
              type="text"
              placeholder="Search tools..."
              aria-label="Search tools"
              autocomplete="off"
            />

            <button
              id="clear-search"
              type="button"
              aria-label="Clear search"
            >
              ×
            </button>
          </div>

          <select
            id="tool-filter"
            aria-label="Filter tools by category"
          >
            <option value="all">
              <span data-i18n="all_categories">All Categories</span>
            </option>

            {
              Object.entries(categoryLabels).map(
                ([value, label]) => (
                  <option value={value}>
                    {label}
                  </option>
                )
              )
            }
          </select>

          <div class="view-toggle">
            <button
              id="view-grid"
              type="button"
              class="view-button active"
            >
              <span data-i18n="grid">Grid</span>
            </button>

            <button
              id="view-list"
              type="button"
              class="view-button"
            >
              <span data-i18n="list">List</span>
            </button>
          </div>

        </div>
      </div>

      <!-- CATEGORY PILLS -->
      <div class="category-pills">

        <button
          type="button"
          data-category="all"
          class="category-pill active"
        >
          <span data-i18n="all_tools">All Tools</span>
        </button>

        {
          Object.entries(categoryLabels).map(
            ([value, label]) => (
              <button
                type="button"
                data-category={value}
                class="category-pill"
              >
                {categoryIcons[value] || ''}
                <span>{label}</span>
              </button>
            )
          )
        }

      </div>

      <div class="results-bar">

        <p id="result-count">
          {t(
            'showing_tools',
            'Showing {count} tools'
          ).replace(
            '{count}',
            String(tools.length)
          )}
        </p>

        <span class="browser-status">
          <span></span>
          <span data-i18n="processing_in_browser">Processing stays in your browser</span>
        </span>

      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="max-w-7xl mx-auto px-4 pb-20">

    <div
      id="tool-grid"
      class="tool-grid"
    >
      {
        translatedTools.map((tool, index) => (
          <a
            href={tool.url}
            class="tool-card group"
            data-tool-name={tool.name}
            data-tool-category={tool.category}
            style={`--delay:${Math.min(index * 35, 350)}ms`}
          >
            <div class="card-glow"></div>

            <div class="tool-card-top">

              <div class="tool-icon">
                {tool.icon}
              </div>

              <svg
                class="arrow-icon"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"
                />
              </svg>

            </div>

            <div class="tool-card-content">

              <p class="tool-name">
                {tool.name}
              </p>

              <span class="tool-category">
                {
                  categoryLabels[tool.category] ||
                  tool.category
                }
              </span>

            </div>
          </a>
        ))
      }
    </div>

    <!-- EMPTY -->
    <div
      id="empty-state"
      class="empty-state hidden"
    >
      <div class="empty-icon">
        🔎
      </div>

      <h3>
        <span data-i18n="no_tools_found">No tools found</span>
      </h3>

      <p>
        <span data-i18n="try_another_search">Try another search term or choose a different category.</span>
      </p>

      <button
        id="reset-tools"
        type="button"
      >
        <span data-i18n="show_all_tools">Show all tools</span>
      </button>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="max-w-7xl mx-auto px-4 pb-20">

    <div class="privacy-callout reveal">

      <div class="privacy-glow"></div>

      <div class="relative max-w-3xl">

        <div class="privacy-heading">
          <span>🔒</span>
          <span data-i18n="privacy_first_by_design">PRIVACY-FIRST BY DESIGN</span>
        </div>

        <h2>
          <span data-i18n="files_belong_to_you">Your files belong to you.</span>
        </h2>

        <p>
          {t(
            'privacy_callout_desc',
            'Dayront is designed to process media directly in your browser. Your files don\'t need to be uploaded to a remote server just to perform a simple conversion or edit.'
          )}
        </p>

        <div class="privacy-features">

          <div>
            <strong>
              <span data-i18n="no_account">No account</span>
            </strong>
            <span>
              <span data-i18n="start_immediately">Start immediately</span>
            </span>
          </div>

          <div>
            <strong>
              <span data-i18n="no_upload">No upload</span>
            </strong>
            <span>
              <span data-i18n="local_processing">Local processing</span>
            </span>
          </div>

          <div>
            <strong>
              <span data-i18n="free_tools_callout">Free tools</span>
            </strong>
            <span>
              <span data-i18n="no_hidden_fees">No hidden fees</span>
            </span>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================
     HERO
  ========================================================= */

  .tools-hero {
    isolation: isolate;
  }

  .hero-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(70px);
    pointer-events: none;
  }

  .hero-glow-one {
    width: 380px;
    height: 380px;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    background: rgb(14 165 233 / 0.10);
  }

  .hero-glow-two {
    width: 280px;
    height: 280px;
    top: 60px;
    left: -120px;
    background: rgb(250 204 21 / 0.08);
  }

  .hero-glow-three {
    width: 280px;
    height: 280px;
    top: 100px;
    right: -120px;
    background: rgb(14 165 233 / 0.08);
  }

  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: 1px solid rgb(229 231 235);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(12px);
    font-size: 12px;
    font-weight: 700;
    color: rgb(75 85 99);
    margin-bottom: 20px;
  }

  .dark .privacy-badge {
    border-color: rgb(31 41 55);
    background: rgb(17 24 39 / 0.8);
    color: rgb(209 213 219);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgb(34 197 94 / 0.12);
    animation: pulse 2s infinite;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    font-weight: 900;
    letter-spacing: -0.045em;
    color: #000;
  }

  .dark .hero-title {
    color: #fff;
  }

  .hero-title span {
    display: block;
    color: rgb(14 165 233);
  }

  .hero-description {
    max-width: 680px;
    margin-top: 20px;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: rgb(75 85 99);
  }

  .dark .hero-description {
    color: rgb(209 213 219);
  }

  .feature-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .feature-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border: 1px solid rgb(229 231 235);
    border-radius: 12px;
    background: #fff;
    color: rgb(55 65 81);
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.03);
  }

  .dark .feature-pill {
    border-color: rgb(31 41 55);
    background: rgb(17 24 39);
    color: rgb(209 213 219);
  }

  /* =========================================================
     STATS
  ========================================================= */

  .stat-card {
    border: 1px solid rgb(229 231 235);
    border-radius: 18px;
    background: #fff;
    padding: 20px;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .dark .stat-card {
    border-color: rgb(31 41 55);
    background: rgb(17 24 39);
  }

  .stat-card:hover {
    transform: translateY(-3px);
    border-color: rgb(14 165 233 / 0.4);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.06);
  }

  .stat-number {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 900;
    color: rgb(14 165 233);
  }

  .stat-label {
    margin-top: 4px;
    font-size: 13px;
    color: rgb(107 114 128);
  }

  /* =========================================================
     SEARCH
  ========================================================= */

  .search-panel {
    padding: 22px;
    border: 1px solid rgb(229 231 235);
    border-radius: 24px;
    background: rgb(249 250 251);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.025);
  }

  .dark .search-panel {
    border-color: rgb(31 41 55);
    background: rgb(17 24 39 / 0.7);
  }

  .search-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .section-kicker {
    margin: 0 0 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: rgb(14 165 233);
  }

  .section-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 900;
    color: #000;
  }

  .dark .section-title {
    color: #fff;
  }

  .section-description {
    margin-top: 4px;
    font-size: 13px;
    color: rgb(107 114 128);
  }

  .search-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 650px;
  }

  .search-box {
    position: relative;
    flex: 1;
    min-width: 200px;
  }

  .search-box input,
  #tool-filter {
    width: 100%;
    height: 46px;
    border: 1px solid rgb(209 213 219);
    border-radius: 12px;
    background: #fff;
    color: #111827;
    font-size: 13px;
    outline: none;
    transition: 0.2s ease;
  }

  .search-box input {
    padding: 0 40px 0 42px;
  }

  .dark .search-box input,
  .dark #tool-filter {
    border-color: rgb(55 65 81);
    background: rgb(3 7 18);
    color: #fff;
  }

  .search-box input:focus,
  #tool-filter:focus {
    border-color: rgb(14 165 233);
    box-shadow: 0 0 0 3px rgb(14 165 233 / 0.12);
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 18px;
    height: 18px;
    transform: translateY(-50%);
    color: rgb(156 163 175);
  }

  #clear-search {
    display: none;
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: rgb(156 163 175);
    font-size: 22px;
    cursor: pointer;
  }

  #clear-search.visible {
    display: block;
  }

  #tool-filter {
    width: auto;
    min-width: 160px;
    padding: 0 12px;
  }

  .view-toggle {
    display: flex;
    gap: 4px;
  }

  .view-button {
    height: 46px;
    padding: 0 13px;
    border: 1px solid rgb(209 213 219);
    border-radius: 10px;
    background: #fff;
    color: rgb(107 114 128);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .dark .view-button {
    border-color: rgb(55 65 81);
    background: rgb(31 41 55);
  }

  .view-button.active {
    background: rgb(14 165 233);
    border-color: rgb(14 165 233);
    color: #fff;
  }

  /* =========================================================
     CATEGORY
  ========================================================= */

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px 13px;
    border: 1px solid rgb(229 231 235);
    border-radius: 999px;
    background: #fff;
    color: rgb(75 85 99);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s ease;
  }

  .dark .category-pill {
    border-color: rgb(55 65 81);
    background: rgb(3 7 18);
    color: rgb(156 163 175);
  }

  .category-pill:hover,
  .category-pill.active {
    border-color: rgb(14 165 233);
    background: rgb(14 165 233 / 0.08);
    color: rgb(14 165 233);
  }

  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 17px;
    border-top: 1px solid rgb(229 231 235);
  }

  .dark .results-bar {
    border-color: rgb(31 41 55);
  }

  .results-bar p {
    margin: 0;
    font-size: 13px;
    color: rgb(107 114 128);
  }

  .browser-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: rgb(156 163 175);
  }

  .browser-status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
  }

  /* =========================================================
     TOOL GRID
  ========================================================= */

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  @media (min-width: 640px) {
    .tool-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .tool-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 180px;
    overflow: hidden;
    padding: 20px;
    border: 1px solid rgb(229 231 235);
    border-radius: 18px;
    background: #fff;
    text-decoration: none;
    transform: translateY(0);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .dark .tool-card {
    border-color: rgb(31 41 55);
    background: rgb(17 24 39);
  }

  .tool-card:hover {
    transform: translateY(-6px);
    border-color: rgb(14 165 233);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.08);
  }

  .dark .tool-card:hover {
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.3);
  }

  .card-glow {
    position: absolute;
    right: -35px;
    top: -35px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgb(14 165 233 / 0.06);
    transition: transform 0.5s ease;
  }

  .tool-card:hover .card-glow {
    transform: scale(1.7);
  }

  .tool-card-top {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .tool-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(243 244 246);
    border-radius: 13px;
    background: rgb(249 250 251);
    font-size: 23px;
    transition: 0.3s ease;
  }

  .dark .tool-icon {
    border-color: rgb(55 65 81);
    background: rgb(31 41 55);
  }

  .tool-card:hover .tool-icon {
    transform: scale(1.08) rotate(-2deg);
    border-color: rgb(14 165 233 / 0.2);
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    color: rgb(209 213 219);
    transition: 0.25s ease;
  }

  .tool-card:hover .arrow-icon {
    color: rgb(14 165 233);
    transform: translateX(4px);
  }

  .tool-card-content {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }

  .tool-name {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
    color: #111827;
    transition: color 0.2s ease;
  }

  .dark .tool-name {
    color: #fff;
  }

  .tool-card:hover .tool-name {
    color: rgb(14 165 233);
  }

  .tool-category {
    display: inline-flex;
