<script define:vars={{
  toolsData: toolsJson,
  categoryLabels: categoryLabelsJson,
  categoryIcons: categoryIconsJson
}}>
  const tools = JSON.parse(toolsData);
  const labels = JSON.parse(categoryLabels);
  const icons = JSON.parse(categoryIcons);

  const searchInput =
    document.querySelector('#tool-search');

  const clearButton =
    document.querySelector('#clear-search');

  const categoryFilter =
    document.querySelector('#tool-filter');

  const grid =
    document.querySelector('#tool-grid');

  const emptyState =
    document.querySelector('#empty-state');

  const resultCount =
    document.querySelector('#result-count');

  const resetButton =
    document.querySelector('#reset-tools');

  const gridButton =
    document.querySelector('#view-grid');

  const listButton =
    document.querySelector('#view-list');

  const categoryPills =
    document.querySelectorAll('.category-pill');

  function updateTools() {
    if (!searchInput || !categoryFilter || !grid) return;

    const search =
      searchInput.value.trim().toLowerCase();

    const category =
      categoryFilter.value;

    let visible = 0;

    const cards =
      grid.querySelectorAll('.tool-card');

    cards.forEach((card) => {
      const name =
        card.dataset.toolName?.toLowerCase() || '';

      const cardCategory =
        card.dataset.toolCategory || '';

      const matchesSearch =
        !search ||
        name.includes(search);

      const matchesCategory =
        category === 'all' ||
        cardCategory === category;

      const show =
        matchesSearch &&
        matchesCategory;

      card.style.display =
        show ? '' : 'none';

      if (show) visible++;
    });

    if (resultCount) {
      const template =
        'Showing {count} tools';

      resultCount.textContent =
        template.replace(
          '{count}',
          String(visible)
        );
    }

    if (emptyState) {
      emptyState.classList.toggle(
        'hidden',
        visible !== 0
      );
    }

    if (clearButton) {
      clearButton.classList.toggle(
        'visible',
        searchInput.value.length > 0
      );
    }
  }

  function setCategory(category) {
    if (!categoryFilter) return;

    categoryFilter.value = category;

    categoryPills.forEach((pill) => {
      pill.classList.toggle(
        'active',
        pill.dataset.category === category
      );
    });

    updateTools();
  }

  searchInput?.addEventListener(
    'input',
    updateTools
  );

  categoryFilter?.addEventListener(
    'change',
    () => {
      setCategory(categoryFilter.value);
    }
  );

  clearButton?.addEventListener(
    'click',
    () => {
      if (!searchInput) return;

      searchInput.value = '';
      updateTools();
      searchInput.focus();
    }
  );

  categoryPills.forEach((pill) => {
    pill.addEventListener(
      'click',
      () => {
        setCategory(
          pill.dataset.category || 'all'
        );
      }
    );
  });

  resetButton?.addEventListener(
    'click',
    () => {
      if (searchInput) {
        searchInput.value = '';
      }

      setCategory('all');
    }
  );

  gridButton?.addEventListener(
    'click',
    () => {
      grid?.classList.remove('list-view');

      gridButton.classList.add('active');
      listButton?.classList.remove('active');
    }
  );

  listButton?.addEventListener(
    'click',
    () => {
      grid?.classList.add('list-view');

      listButton.classList.add('active');
      gridButton?.classList.remove('active');
    }
  );

  updateTools();
</script>