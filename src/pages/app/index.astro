---
// src/pages/app/index.astro
import { tools } from '../../core/tools';
import MobileLayout from '../../ui/mobile/layouts/MobileLayout';
import HomeScreen from '../../ui/mobile/screens/HomeScreen';
import '../../ui/mobile/mobile.css';

const appTools = tools.map((t) => ({
  slug: t.slug,
  name: t.name,
  description: t.description,
  icon: t.icon,
  from: t.from,
  to: t.to,
  category: t.category,
}));
---

<!doctype html>
<html lang="en" style="color-scheme: light dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#2CB5F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C4A6E" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Dayront App</title>
  </head>
  <body>
    <MobileLayout client:load current="home">
      <HomeScreen client:load tools={appTools} />
    </MobileLayout>
  </body>
</html>