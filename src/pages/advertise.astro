---
import BaseLayout from '../layouts/BaseLayout.astro';

const metaTitle = 'Advertise on Dayront – Reach 100K+ Creators Monthly | Dayront';
const metaDescription = 'Put your product in front of podcasters, video editors, and content creators at the exact moment they are working. Exclusive placements from $99/month. No ad networks, no bidding.';

/* ─────────────────────────────────────────────
   HERO — lead with the AUDIENCE claim
   ───────────────────────────────────────────── */
const heroProofPoints = [
  '40K+ podcasters & audio engineers',
  '30K+ video editors & motion designers',
  '92% desktop professionals',
  '68% return visitors',
];

/* Trust strip */
const trustLogos = [
  'AudioLabs', 'Podwave', 'CutPro', 'Editorial.io', 'SoundForge', 'Clipverse',
];

/* ─────────────────────────────────────────────
   AUDIENCE SNAPSHOT — real advertising data
   ───────────────────────────────────────────── */
const audienceSegments = [
  { value: 42, label: 'Podcasters & audio engineers', detail: '~42,000 monthly' },
  { value: 31, label: 'Video editors & motion designers', detail: '~31,000 monthly' },
  { value: 18, label: 'AI / ML early adopters', detail: '~18,000 monthly' },
  { value: 9,  label: 'Indie studios & agencies', detail: '~9,000 monthly' },
];

const audienceFacts = [
  {
    icon: '🌍',
    value: '78%',
    label: 'US, UK, CA & Western Europe',
    detail: 'High-intent, high-purchasing-power markets',
  },
  {
    icon: '💻',
    value: '92%',
    label: 'Desktop-first professionals',
    detail: 'Working sessions, not scroll-by mobile traffic',
  },
  {
    icon: '⏱️',
    value: '3m 42s',
    label: 'Average time on tool pages',
    detail: 'Dwell time 4.8× higher than typical display',
  },
  {
    icon: '🔁',
    value: '68%',
    label: 'Return visitors each month',
    detail: 'A loyal working audience, not drive-by search',
  },
];

/* ─────────────────────────────────────────────
   PROOF — engagement & brand safety
   ───────────────────────────────────────────── */
const proofStats = [
  { value: '4.8×',  label: 'Engagement vs. display networks' },
  { value: '0.9%',  label: 'Median CTR across placements' },
  { value: '100%',  label: 'Brand-safe, moderated environment' },
  { value: '0',     label: 'User-generated content on-page' },
];

const brandSafetyPoints = [
  {
    title: 'No user-generated content',
    body: 'No comment sections, no uploads, no forums. Every page is a clean, owned environment — your ad sits next to a tool, not a thread.',
  },
  {
    title: 'No data harvesting',
    body: 'Files are processed entirely in the browser and never touch a server. Your brand benefits from that trust posture, not just ours.',
  },
  {
    title: 'Editorial-first partner standards',
    body: 'We decline gambling, adult content, and low-quality affiliate offers. Every advertiser on the page is vetted and relevant.',
  },
];

/* ─────────────────────────────────────────────
   SHOWCASE TABS — kept intact
   ───────────────────────────────────────────── */
const showcaseTabs = [
  {
    key: 'tools',
    label: 'Tools',
    headline: 'The Tools People Come Back To',
    description: 'Every day, thousands of creators use Dayront to convert, cut, compress, and merge audio and video files — without ever uploading them to a server. That\'s 100% privacy-first processing, right in the browser.',
    image: '/advertise/showcase-tools.jpg',
    features: ['MP4, MP3, WAV, MOV & 20+ formats', 'No accounts, no uploads, no logs', 'Real-time conversions with WebAssembly'],
  },
  {
    key: 'blog',
    label: 'Blog',
    headline: 'Editorial That Helps Creators Ship',
    description: 'Our blog dives deep into workflows, privacy, and the "how" behind media. It\'s not fluff — it\'s the kind of long-form content creators actually bookmark and come back to.',
    image: '/advertise/showcase-blog.jpg',
    features: ['60+ in-depth guides', 'Privacy-first, jargon-light', 'Topics: podcasting, video, formats, workflows'],
  },
  {
    key: 'ai',
    label: 'AI Tools',
    headline: 'Next-Gen Processing, Still Local',
    description: 'From AI captions to background removal, we\'re building the kind of tools that used to require expensive software or cloud services — running entirely on your device.',
    image: '/advertise/showcase-ai.jpg',
    features: ['AI video captions with Whisper', 'Background removal via ONNX', 'Zero cloud dependency'],
  },
];

/* ─────────────────────────────────────────────
   PLACEMENTS — with impression estimates
   ───────────────────────────────────────────── */
const placements = [
  {
    icon: '🎯',
    name: 'Below Header',
    tier: 'High visibility',
    description: 'Appears on every page, right below the navigation. The first brand element a visitor sees.',
    impressions: '~110,000 / mo',
    reach: 'Reaches every visitor on every page',
    cpm: '$2.26 CPM',
  },
  {
    icon: '📄',
    name: 'Below Tool',
    tier: 'In-content',
    description: 'Positioned directly after every tool\'s content area — the moment a user finishes a task.',
    impressions: '~72,000 / mo',
    reach: 'Tool users only, scoped to audio/video/AI',
    cpm: '$3.46 CPM',
  },
  {
    icon: '📱',
    name: 'Sticky Footer',
    tier: 'Persistent',
    description: 'Always visible at the bottom of the viewport. Highest impressions, guaranteed eye time.',
    impressions: '~80,000 / mo',
    reach: 'Every page view, session-long visibility',
    cpm: '$7.49 CPM',
  },
  {
    icon: '✍️',
    name: 'Sponsored Post',
    tier: 'Editorial',
    description: 'A dedicated blog post featuring your product — written by us, permanent placement.',
    impressions: 'Permanent + featured',
    reach: 'High-value, evergreen SEO traffic',
    cpm: 'Flat fee, no CPM',
  },
];

/* ─────────────────────────────────────────────
   HOW IT WORKS — kept
   ───────────────────────────────────────────── */
const steps = [
  {
    number: '01',
    title: 'Tell us about your brand',
    body: 'Fill out the short inquiry form below. Share your product, your audience, and what you want to achieve. It takes about two minutes.',
  },
  {
    number: '02',
    title: 'We match you to a slot',
    body: 'Within one business day, you\'ll get a reply with available placements, verified traffic estimates, and a custom quote — no pressure, no upsells.',
  },
  {
    number: '03',
    title: 'You approve the creative',
    body: 'Send us your banner, copy, or let our team help design it. We optimize for the placement and make sure it feels native to the page.',
  },
  {
    number: '04',
    title: 'Go live & measure',
    body: 'Your ad ships, and you get access to a live dashboard with impressions, clicks, and engagement. Adjust anytime. Cancel anytime.',
  },
];

/* ─────────────────────────────────────────────
   TESTIMONIALS — kept
   ───────────────────────────────────────────── */
const testimonials = [
  {
    quote: 'We tried three ad networks before Dayront. None of them delivered this kind of focused attention. Our demo requests doubled in the first month.',
    name: 'Maya Okafor',
    role: 'Head of Growth, AudioLabs',
  },
  {
    quote: 'The Below Tool placement is gold. People are literally mid-task when they see us. Conversion rate is triple what we saw on social.',
    name: 'Daniel Reyes',
    role: 'Founder, CutPro Studio',
  },
  {
    quote: 'No intermediaries, no weird fees, no shady metrics. Just a direct partnership with a site our audience already trusts.',
    name: 'Priya Nair',
    role: 'CMO, Podwave',
  },
];

/* ─────────────────────────────────────────────
   PRICING — transparent + CPM math
   ───────────────────────────────────────────── */
const pricingTiers = [
  {
    name: 'Starter',
    tagline: 'Test the channel with a single in-content slot.',
    price: '$99',
    period: '/mo',
    impressions: '~72,000 est. impressions',
    cpm: '≈ $1.37 effective CPM',
    features: [
      'Below Tool placement (scoped)',
      '1 active ad',
      'Impression & click stats',
      'Creative resizing included',
      'Cancel anytime',
    ],
    cta: 'Get started',
    featured: false,
  },
  {
    name: 'Growth',
    tagline: 'For brands serious about sustained reach.',
    price: '$249',
    period: '/mo',
    impressions: '~182,000 est. impressions',
    cpm: '≈ $1.37 effective CPM',
    features: [
      'Below Header + Below Tool placements',
      '2 active ads',
      'Detailed analytics dashboard',
      'Audience-scoped targeting',
      'Priority creative support',
      'Cancel anytime',
    ],
    cta: 'Get started',
    featured: true,
  },
  {
    name: 'Premium',
    tagline: 'Exclusive ownership of the highest-impact real estate.',
    price: '$599',
    period: '/mo',
    impressions: '~262,000 est. impressions',
    cpm: '≈ $2.29 effective CPM',
    features: [
      'All placements included',
      'Sticky Footer (exclusive)',
      'Sponsored blog post',
      '3 active ads',
      'Custom campaign strategy',
      'Dedicated point of contact',
      'Cancel anytime',
    ],
    cta: 'Get started',
    featured: false,
  },
];

/* ─────────────────────────────────────────────
   FAQ — kept and sharpened
   ───────────────────────────────────────────── */
const faqs = [
  {
    q: 'How much traffic does Dayront actually get?',
    a: 'We currently serve over 100,000 monthly visitors across our tool pages and blog, with 78% coming from the US, UK, Canada, and Western Europe. You\'ll receive a full regional and device breakdown before you commit — no estimates, only verified analytics.',
  },
  {
    q: 'How are your impression estimates calculated?',
    a: 'Each placement figure is based on a 90-day trailing average pulled directly from our analytics. We refresh these numbers monthly. If a placement under-delivers against its estimate by more than 15%, we credit the difference toward your next month.',
  },
  {
    q: 'Can I target specific tool pages?',
    a: 'Yes. Below Tool placements can be scoped to audio tools, video tools, AI tools, or the blog. If you want to reach podcasters specifically, we can put you only in front of them — at no extra cost.',
  },
  {
    q: 'Do you accept all advertisers?',
    a: 'We keep the page clean and relevant. We review every advertiser and politely decline anything that doesn\'t fit our audience — gambling, adult content, and low-quality affiliate offers are a hard no.',
  },
  {
    q: 'What formats do you accept?',
    a: 'Static image, animated GIF, and lightweight HTML5. We\'ll send you exact dimensions for each placement once you pick one, and our team will resize your creative at no cost.',
  },
  {
    q: 'Is there a minimum commitment?',
    a: 'No. Every plan is month-to-month. You can pause, upgrade, downgrade, or cancel at any time — no contracts, no cancellation fees, no awkward phone calls.',
  },
  {
    q: 'How fast can a campaign go live?',
    a: 'Most campaigns go live within 48 hours of creative approval. If you have a launch deadline, tell us in the inquiry form and we\'ll prioritize it.',
  },
];
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main class="bg-white dark:bg-gray-950 text-black dark:text-white">

    <!-- ═══════════════════════════════════════════
         1. HERO — audience first
    ═══════════════════════════════════════════ -->
    <section class="relative overflow-hidden border-b border-gray-200 dark:border-gray-800">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -top-[30%] -right-[10%] w-[600px] h-[600px] rounded-full bg-sky-500/10 dark:bg-sky-500/20 blur-[120px]"></div>
        <div class="absolute top-[40%] -left-[15%] w-[500px] h-[500px] rounded-full bg-sky-400/10 dark:bg-sky-400/10 blur-[100px]"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6 py-20 sm:py-28 lg:py-32 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-50 dark:bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-200 dark:border-sky-500/20 mb-6">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
            </span>
            Advertise on Dayront
          </span>

          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter leading-[1.05] mb-6">
            Reach
            <span class="text-sky-500">40,000 podcasters</span>
            and 30,000 video editors — every month.
          </h1>

          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-xl mb-6">
            They're not scrolling. They're working — converting, cutting, and compressing media right here in the browser. Your brand meets them mid-task, at the exact moment they're thinking about their next purchase.
          </p>

          <ul class="space-y-2 mb-10">
            {heroProofPoints.map((point) => (
              <li class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-300">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-sky-500/15 text-sky-500 flex items-center justify-center text-xs font-black">✓</span>
                {point}
              </li>
            ))}
          </ul>

          <div class="flex flex-col sm:flex-row gap-3 mb-10">
            <a href="#contact" class="inline-flex items-center justify-center gap-2 rounded-xl bg-sky-500 px-7 py-3.5 font-bold text-white shadow-lg shadow-sky-500/25 transition hover:bg-sky-600 active:scale-[0.98]">
              Start a campaign
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
            <a href="/advertise/dayront-mediakit.pdf" class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 px-7 py-3.5 font-bold text-gray-900 dark:text-white transition hover:border-sky-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0-4-4m4 4 4-4M5 20h14"/></svg>
              Download media kit
            </a>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-gray-500 dark:text-gray-400">
            <span class="inline-flex items-center gap-2"><span class="text-sky-500 font-black">✓</span> Live in 48 hours</span>
            <span class="inline-flex items-center gap-2"><span class="text-sky-500 font-black">✓</span> Cancel anytime</span>
            <span class="inline-flex items-center gap-2"><span class="text-sky-500 font-black">✓</span> No setup fees</span>
          </div>
        </div>

        <div class="relative">
          <div class="aspect-[4/3] rounded-3xl overflow-hidden border border-gray-200 dark:border-gray-800 shadow-2xl shadow-sky-500/10 bg-gradient-to-br from-sky-500/20 via-sky-400/10 to-transparent">
            <img
              src="/advertise/hero.jpg"
              alt="Dayront advertising showcase"
              class="w-full h-full object-cover"
              loading="eager"
              onerror="this.style.display='none'"
            />
          </div>
        </div>
      </div>

      <!-- 2. TRUST STRIP -->
      <div class="relative border-t border-gray-200 dark:border-gray-800 bg-white/60 dark:bg-gray-950/60 backdrop-blur">
        <div class="max-w-7xl mx-auto px-6 py-8">
          <p class="text-center text-[10px] font-black uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-5">
            Trusted by teams building for creators
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 opacity-70">
            {trustLogos.map((logo) => (
              <span class="text-sm sm:text-base font-black tracking-tight text-gray-500 dark:text-gray-400 hover:text-sky-500 dark:hover:text-sky-400 transition">
                {logo}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         3. AUDIENCE SNAPSHOT
    ═══════════════════════════════════════════ -->
    <section class="py-20 border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          <div>
            <span class="text-xs font-black uppercase tracking-widest text-sky-500">Who you'll reach</span>
            <h2 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4">
              An audience that <span class="text-sky-500">builds</span> for a living.
            </h2>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-8">
              Dayront users aren't casual scrollers. They're the people who make the podcasts, videos, and media products the rest of the world consumes. They buy tools, subscribe to software, and recommend what works.
            </p>

            <div class="space-y-5">
              {audienceSegments.map((seg) => (
                <div>
                  <div class="flex items-baseline justify-between mb-2">
                    <span class="text-sm font-bold">{seg.label}</span>
                    <span class="text-sm font-black text-sky-500">{seg.value}% <span class="text-gray-400 dark:text-gray-500 font-medium ml-2">{seg.detail}</span></span>
                  </div>
                  <div class="h-2 rounded-full bg-gray-100 dark:bg-gray-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-sky-500 to-sky-400" style={`width: ${seg.value}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            {audienceFacts.map((fact) => (
              <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
                <div class="text-2xl mb-3">{fact.icon}</div>
                <p class="text-3xl sm:text-4xl font-black text-sky-500 mb-2">{fact.value}</p>
                <p class="text-sm font-bold leading-tight mb-1">{fact.label}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug">{fact.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         4. PROOF / BRAND SAFETY
    ═══════════════════════════════════════════ -->
    <section class="py-20 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/40">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-black uppercase tracking-widest text-sky-500">The proof</span>
          <h2 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4">
            Attention that holds.
          </h2>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            No inflated impressions. No bot traffic. Just a working, returning audience and a clean environment that protects your brand.
          </p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
          {proofStats.map((stat) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 text-center">
              <p class="text-3xl sm:text-4xl font-black text-sky-500 mb-2">{stat.value}</p>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-snug font-medium">{stat.label}</p>
            </div>
          ))}
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          {brandSafetyPoints.map((point) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6">
              <h3 class="font-black text-base mb-2 tracking-tight">{point.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{point.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         5. PRODUCT SHOWCASE — kept intact
    ═══════════════════════════════════════════ -->
    <section class="py-20 border-b border-gray-200 dark:border-gray-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-12">
          <span class="text-xs font-black uppercase tracking-widest text-sky-500">Where your ad appears</span>
          <h2 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight max-w-3xl mb-4">
            Three surfaces, one audience.
          </h2>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
            Every placement sits inside a specific Dayront surface — a tool page, a long-form guide, or an AI workflow. Pick the surface that matches your product, or run across all three.
          </p>
        </div>

        <!-- Tab nav -->
        <div class="flex flex-wrap gap-2 border-b border-gray-200 dark:border-gray-800 mb-10">
          {showcaseTabs.map((tab, i) => (
            <button
              type="button"
              class="showcase-tab px-5 py-3 text-sm font-bold uppercase tracking-wider transition border-b-2 -mb-px"
              data-target={tab.key}
              data-active={i === 0 ? 'true' : 'false'}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <!-- Tab panels -->
        {showcaseTabs.map((tab, i) => (
          <div
            class="showcase-panel grid lg:grid-cols-2 gap-10 items-center"
            data-panel={tab.key}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <div class="order-2 lg:order-1">
              <h3 class="text-2xl sm:text-3xl font-black tracking-tight mb-4">
                {tab.headline}
              </h3>
              <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
                {tab.description}
              </p>
              <ul class="space-y-3">
                {tab.features.map((f) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-sky-500/15 text-sky-500 flex items-center justify-center text-xs font-black">✓</span>
                    <span class="text-sm font-medium text-gray-700 dark:text-gray-200">{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="order-1 lg:order-2 aspect-[4/3] rounded-3xl overflow-hidden border border-gray-200 dark:border-gray-800 shadow-xl bg-gradient-to-br from-sky-500/20 to-transparent">
              <img
                src={tab.image}
                alt={tab.headline}
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         6. INVENTORY — placements with impression data
    ═══════════════════════════════════════════ -->
    <section id="placements" class="py-20 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/40">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-12 text-center max-w-3xl mx-auto">
          <span class="text-xs font-black uppercase tracking-widest text-sky-500">Available inventory</span>
          <h2 class="mt-2 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4">
            Four exclusive slots.
          </h2>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            Each placement is sold to a single advertiser at a time. No bidding, no ad networks, no shared inventory. When a slot is yours, your competitors cannot appear next to you.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          {placements.map((p) => (
            <div class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-7 transition hover:border-sky-400 hover:shadow-xl hover:shadow-sky-500/10">
              <div class="flex items-start justify-between mb-4">
                <span class="text-3xl">{p.icon}</span>
                <span class="text-[10px] font-black uppercase tracking-widest text-sky-500 bg-sky-50 dark:bg-sky-500/10 px-2.5 py-1 rounded-full">
                  {p.tier}
                </span>
              </div>
              <h3 class="font-black text-lg mb-1.5 group-hover:text-sky-500 transition">{p.name}</h3>
