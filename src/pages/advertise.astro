<style>
  /* Showcase tabs */
  .showcase-tab {
    color: rgb(107 114 128);
    border-color: transparent;
  }
  .showcase-tab:hover {
    color: rgb(14 165 233);
  }
  .showcase-tab[data-active='true'] {
    color: rgb(14 165 233);
    border-color: rgb(14 165 233);
  }

  .showcase-panel[data-active='false'] {
    display: none;
  }

  /* FAQ summary marker removal */
  summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Showcase tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('.showcase-tab');
  const panels = document.querySelectorAll<HTMLElement>('.showcase-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;

      tabs.forEach((t) => t.setAttribute('data-active', t.dataset.target === target ? 'true' : 'false'));
      panels.forEach((p) => p.setAttribute('data-active', p.dataset.panel === target ? 'true' : 'false'));
    });
  });
</script>