---
// src/pages/download.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import NotifyForm from '../components/ui/NotifyForm.tsx';
import { getTierCounts, getAppRecommendedTools } from '../lib/tools';

// Import the page-specific stylesheet — Astro bundles & hashes it
import '../styles/download.css';

const tierCounts = getTierCounts();
const appTools = getAppRecommendedTools();

// ── Installer metadata ────────────────────────────────────
// Flip `status` from 'coming-soon' → 'available' when the build is live.
type ReleaseStatus = 'available' | 'coming-soon' | 'beta';

interface Release {
  label: string;
  /** Inline SVG markup for the OS / store brand icon */
  svg: string;
  url: string;
  store: string;
  note: string;
  status: ReleaseStatus;
}

const RELEASES: Record<string, Release> = {
  android: {
    label: 'Android',
    // Full-body Android robot — fills the icon tile properly
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#34A853" d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zm-4.97-5.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 7h12a5.98 5.98 0 0 0-2.47-4.84zM9.5 5.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zm5 0c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5z"/></svg>`,
    url: '',
    store: 'Play Store + Direct APK',
    note: 'Play Store listing in review. Direct APK on request.',
    status: 'coming-soon',
  },
  ios: {
    label: 'iOS',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="#0F172A"/></svg>`,
    url: '',
    store: 'App Store',
    note: 'Currently in TestFlight. Public release soon.',
    status: 'coming-soon',
  },
  windows: {
    label: 'Windows',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M3 5.548L10.03 4.575V11.536H3V5.548zM11.045 4.43L21 3V11.536H11.045V4.43zM3 12.464h7.03v6.961L3 18.452V12.464zM11.045 12.464H21V21L11.045 19.57v-7.106z" fill="#0078D4"/></svg>`,
    url: '',
    store: 'Windows 10/11 · x64',
    note: 'Signed installer with bundled native FFmpeg.',
    status: 'coming-soon',
  },
  macos: {
    label: 'macOS',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="#6E6E73"/></svg>`,
    url: '',
    store: 'Universal · Intel + Apple Silicon',
    note: 'Signed and notarized.',
    status: 'coming-soon',
  },
  linux: {
    label: 'Linux',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2a4 4 0 0 0-4 4v3.08c0 .55-.45 1-1 1s-1-.45-1-1V6c0-2.76 2.24-5 5-5h2c2.76 0 5 2.24 5 5v3.08c0 .55-.45 1-1 1s-1-.45-1-1V6a4 4 0 0 0-4-4zm6 10.08V11c0-1.66-1.34-3-3-3H9c-1.66 0-3 1.34-3 3v1.08C4.24 12.82 3 14.31 3 17c0 3.87 4.03 7 9 7s9-3.13 9-7c0-2.69-1.24-4.18-3-4.92z" fill="#0F172A"/></svg>`,
    url: '',
    store: 'AppImage · x86_64',
    note: 'Also available as .deb and .rpm.',
    status: 'coming-soon',
  },
};

/** Build the correct URL for a tool (mirrors BaseLayout logic) */
function toolUrl(tool: { slug: string; from?: string; to?: string }): string {
  return tool.from && tool.to ? `/convert/${tool.slug}` : `/tools/${tool.slug}`;
}
---

<BaseLayout
  title="Download Dayront — Desktop & Mobile Apps"
  description="Get Dayront for Windows, macOS, Linux, Android, or iOS. Process 5GB+ files directly on your device. No memory limits, no uploads."
>
  <main class="download-page">
    <header class="download-hero">
      <div class="hero-brand">
        <div class="hero-logo">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="#2CB5F0"/>
            <rect x="12" y="16" width="16" height="8" rx="1" fill="white"/>
            <circle cx="20" cy="20" r="3" fill="#2CB5F0"/>
          </svg>
        </div>
        <h1>Get the Dayront App</h1>
      </div>
      <p class="lead">
        Process files up to <strong>5 GB</strong> directly on your device.
        No memory limits, no uploads, no waiting.
      </p>
      <div class="hero-badges">
        <span class="badge badge--primary">⚡ 10× faster</span>
        <span class="badge">📁 5 GB file limit</span>
        <span class="badge">🔒 100% offline</span>
      </div>
    </header>

    <!-- NOTIFY HERO -->
    <section class="notify-hero">
      <div class="notify-hero__inner">
        <div class="notify-hero__badge">
          <span class="notify-hero__dot" aria-hidden="true"></span>
          Launching soon
        </div>

        <h2 class="notify-hero__title">Be first to get the app</h2>
        <p class="notify-hero__sub">
          Enter your email and we'll let you know the moment Dayront is available.
        </p>

        <NotifyForm
          client:load
          platform="web"
          source="download-hero"
          ctaLabel="Notify me"
        />
      </div>
    </section>

    <!-- DOWNLOAD GRID -->
    <section class="section">
      <h2>Choose your platform</h2>
      <div class="download-grid">
        {Object.entries(RELEASES).map(([key, info]) => {
          const isAvailable = info.status === 'available' || info.status === 'beta';
          const Tag = isAvailable ? 'a' : 'div';
          return (
            <Tag
              {...(isAvailable ? { href: info.url, rel: 'noopener' } : {})}
              class={`download-card ${!isAvailable ? 'download-card--soon' : ''}`}
              data-platform={key}
              data-status={info.status}
            >
              <div class="download-card__icon" aria-hidden="true" set:html={info.svg} />
              <div class="download-card__body">
                <div class="download-card__title">
                  {info.label}
                  {info.status === 'coming-soon' && (
                    <span class="status-pill status-pill--soon">Coming soon</span>
                  )}
                  {info.status === 'beta' && (
                    <span class="status-pill status-pill--beta">Beta</span>
                  )}
                </div>
                <div class="download-card__meta">{info.store}</div>
                <div class="download-card__note">{info.note}</div>
              </div>
              <div class="download-card__arrow" aria-hidden="true">
                {isAvailable ? '↓' : '⏳'}
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <!-- PWA fallback -->
    <section class="section">
      <div class="pwa-card">
        <div class="pwa-card__icon">🌐</div>
        <div class="pwa-card__body">
          <h3>Can't install? Use the PWA</h3>
          <p>
            Dayront works as a Progressive Web App — install it from your
            browser and get an app-like experience with offline support.
            No app store needed.
          </p>
          <button type="button" class="btn btn--secondary" id="pwa-install-btn" hidden>
            Install PWA
          </button>
          <details class="pwa-instructions">
            <summary>Manual install instructions</summary>
            <div class="pwa-steps">
              <div class="pwa-step">
                <strong>iOS Safari</strong>
                <span>Share → Add to Home Screen</span>
              </div>
              <div class="pwa-step">
                <strong>Android Chrome</strong>
                <span>Menu (⋮) → Install app</span>
              </div>
              <div class="pwa-step">
                <strong>Desktop Chrome / Edge</strong>
                <span>Install icon in the address bar</span>
              </div>
              <div class="pwa-step">
                <strong>Desktop Safari</strong>
                <span>File → Add to Dock</span>
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="section">
      <h2>Web vs App</h2>
      <div class="comparison-wrap">
        <table class="comparison">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Web</th>
              <th class="comparison__highlight">App</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Max file size</td>
              <td>100–350 MB</td>
              <td class="comparison__highlight"><strong>5 GB</strong></td>
            </tr>
            <tr>
              <td>Processing speed</td>
              <td>1×</td>
              <td class="comparison__highlight"><strong>Up to 10× faster</strong></td>
            </tr>
            <tr>
              <td>Works offline</td>
              <td>Partial (after first load)</td>
              <td class="comparison__highlight"><strong>Fully offline</strong></td>
            </tr>
            <tr>
              <td>8K conversions</td>
              <td>❌ Not recommended</td>
              <td class="comparison__highlight"><strong>✅ Supported</strong></td>
            </tr>
            <tr>
              <td>AI tools (captions, background removal)</td>
              <td>⚠️ Small files only</td>
              <td class="comparison__highlight"><strong>✅ Full-size</strong></td>
            </tr>
            <tr>
              <td>Batch processing</td>
              <td>❌</td>
              <td class="comparison__highlight"><strong>✅ Coming soon</strong></td>
            </tr>
            <tr>
              <td>Ads</td>
              <td>Small banner</td>
              <td class="comparison__highlight"><strong>None</strong></td>
            </tr>
            <tr>
              <td>Data collection</td>
              <td>None</td>
              <td class="comparison__highlight"><strong>None</strong></td>
            </tr>
            <tr>
              <td>Price</td>
              <td>Free</td>
              <td class="comparison__highlight"><strong>Free</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tools benefit list -->
    <section class="section">
      <h2>What you unlock with the app</h2>
      <p class="section__lead">
        These {appTools.length} tools run best in the app — some require it.
      </p>
      <ul class="tools-list">
        {appTools.map((tool) => (
          <li class="tools-list__item">
            <span class="tools-list__icon">{tool.icon}</span>
            <div class="tools-list__body">
              <a href={toolUrl(tool)} class="tools-list__link">{tool.name}</a>
              {tool.webNote && (
                <span class="tools-list__note">{tool.webNote}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section class="section">
      <h2>Frequently asked questions</h2>
      <div class="faq">
        <details>
          <summary>Is the app really free?</summary>
          <p>Yes. The app is free, with no ads and no sign-up. It's built on the same privacy-first promise as the web version.</p>
        </details>
        <details>
          <summary>Why is the app faster than the browser?</summary>
          <p>The browser version has stricter memory limits per tab. The app processes files directly on your device — 10× faster and no memory limit.</p>
        </details>
        <details>
          <summary>Does the app upload my files?</summary>
          <p>No. Everything happens locally on your device, exactly like the web version. The app never connects to a server for processing.</p>
        </details>
        <details>
          <summary>Will my settings and preferences carry over?</summary>
          <p>Yes. Your theme, language, and recent tool history sync between web and app (stored locally — no accounts required).</p>
        </details>
        <details>
          <summary>When is the Play Store / App Store release?</summary>
          <p>Android APK and iOS TestFlight are coming first. Store listings are in review and will go live soon. Leave your email in the "Notify me" box to be the first to know.</p>
        </details>
      </div>
    </section>

    <footer class="download-footer">
      <p>
        Built for your device, with <strong>zero telemetry</strong>.
        Your files never leave your device.
      </p>
      <a href="/tools" class="btn btn--ghost">Browse all tools →</a>
    </footer>
  </main>
</BaseLayout>

<script>
  (() => {
    /* PWA install prompt — no OS detection */
    let deferredPrompt: any = null;
    const pwaBtn = document.getElementById('pwa-install-btn') as HTMLButtonElement | null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (pwaBtn) pwaBtn.hidden = false;
    });

    pwaBtn?.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      console.log('[PWA] Install outcome:', outcome);
      deferredPrompt = null;
      pwaBtn.hidden = true;
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      if (pwaBtn) pwaBtn.hidden = true;
    });
  })();
</script>