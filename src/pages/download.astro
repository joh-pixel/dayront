<script>
  (() => {
    /* ── 1. Detect OS and highlight matching download card ── */
    type PlatformKey = 'android' | 'ios' | 'windows' | 'macos' | 'linux';

    function detectOS(): { key: PlatformKey; name: string } | null {
      const ua = navigator.userAgent || '';
      const platform = (navigator as any).userAgentData?.platform || navigator.platform || '';
      const s = (ua + ' ' + platform).toLowerCase();

      if (/android/.test(s))            return { key: 'android', name: 'Android' };
      if (/iphone|ipad|ipod/.test(s))   return { key: 'ios',     name: 'iPhone' };
      if (/mac os x|macintosh/.test(s)) return { key: 'macos',   name: 'macOS' };
      if (/windows/.test(s))            return { key: 'windows', name: 'Windows' };
      if (/linux|x11|cros/.test(s))     return { key: 'linux',   name: 'Linux' };
      return null;
    }

    const os = detectOS();
    if (os) {
      const subEl = document.getElementById('notify-hero-sub');
      if (subEl) {
        subEl.textContent = `We detected you're on ${os.name}. Enter your email and we'll let you know when it's ready.`;
      }

      const card = document.querySelector<HTMLElement>(`[data-platform="${os.key}"]`);
      if (card) {
        card.classList.add('download-card--recommended');
      }
    }

    /* ── 2. PWA install prompt ─────────────────────────── */
    let deferredPrompt: any = null;
    const pwaBtn = document.getElementById('pwa-install-btn') as HTMLButtonElement | null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (pwaBtn) pwaBtn.hidden = false;
    });

    pwaBtn?.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      console.log('[PWA] Install outcome:', outcome);
      deferredPrompt = null;
      pwaBtn.hidden = true;
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      if (pwaBtn) pwaBtn.hidden = true;
    });
  })();
</script>