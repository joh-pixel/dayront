---
// src/pages/download.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import NotifyForm from '../components/ui/NotifyForm.tsx';
import { getTierCounts, getAppRecommendedTools } from '../lib/tools';

const tierCounts = getTierCounts();
const appTools = getAppRecommendedTools();

// ── Installer metadata ────────────────────────────────────
// Flip `status` from 'coming-soon' → 'available' when the build is live.
type ReleaseStatus = 'available' | 'coming-soon' | 'beta';

interface Release {
  label: string;
  /** Inline SVG markup for the OS / store brand icon */
  svg: string;
  url: string;
  store: string;
  note: string;
  status: ReleaseStatus;
}

const RELEASES: Record<string, Release> = {
  android: {
    label: 'Android',
    svg: `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.6 9.48l1.84-3.18a.4.4 0 0 0-.15-.55.4.4 0 0 0-.55.15L16.9 9.15A11.14 11.14 0 0 0 12 8c-1.78 0-3.44.4-4.9 1.05L5.26 5.9a.4.4 0 0 0-.55-.15.4.4 0 0 0-.15.55l1.84 3.18A10.56 10.56 0 0 0 1 17h22a10.56 10.56 0 0 0-5.4-7.52zM7 14.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm10 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" fill="#34A853"/></svg>`,
    url: '',
    store: 'Play Store + Direct APK',
    note: 'Play Store listing in review. Direct APK on request.',
    status: 'coming-soon',
  },
  ios: {
    label: 'iOS',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="#0F172A"/></svg>`,
    url: '',
    store: 'App Store',
    note: 'Currently in TestFlight. Public release soon.',
    status: 'coming-soon',
  },
  windows: {
    label: 'Windows',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M3 5.548L10.03 4.575V11.536H3V5.548zM11.045 4.43L21 3V11.536H11.045V4.43zM3 12.464h7.03v6.961L3 18.452V12.464zM11.045 12.464H21V21L11.045 19.57v-7.106z" fill="#0078D4"/></svg>`,
    url: '',
    store: 'Windows 10/11 · x64',
    note: 'Signed installer with bundled native FFmpeg.',
    status: 'coming-soon',
  },
  macos: {
    label: 'macOS',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="#6E6E73"/></svg>`,
    url: '',
    store: 'Universal · Intel + Apple Silicon',
    note: 'Signed and notarized.',
    status: 'coming-soon',
  },
  linux: {
    label: 'Linux',
    svg: `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2a4 4 0 0 0-4 4v3.08c0 .55-.45 1-1 1s-1-.45-1-1V6c0-2.76 2.24-5 5-5h2c2.76 0 5 2.24 5 5v3.08c0 .55-.45 1-1 1s-1-.45-1-1V6a4 4 0 0 0-4-4zm6 10.08V11c0-1.66-1.34-3-3-3H9c-1.66 0-3 1.34-3 3v1.08C4.24 12.82 3 14.31 3 17c0 3.87 4.03 7 9 7s9-3.13 9-7c0-2.69-1.24-4.18-3-4.92z" fill="#0F172A"/></svg>`,
    url: '',
    store: 'AppImage · x86_64',
    note: 'Also available as .deb and .rpm.',
    status: 'coming-soon',
  },
};

/** Build the correct URL for a tool (mirrors BaseLayout logic) */
function toolUrl(tool: { slug: string; from?: string; to?: string }): string {
  return tool.from && tool.to ? `/convert/${tool.slug}` : `/tools/${tool.slug}`;
}
---

<BaseLayout
  title="Download Dayront — Desktop & Mobile Apps"
  description="Get Dayront for Windows, macOS, Linux, Android, or iOS. Process 5GB+ files with native FFmpeg, no memory limits, no uploads."
>
  <main class="download-page">
    <header class="download-hero">
      <div class="hero-brand">
        <div class="hero-logo">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="#2CB5F0"/>
            <rect x="12" y="16" width="16" height="8" rx="1" fill="white"/>
            <circle cx="20" cy="20" r="3" fill="#2CB5F0"/>
          </svg>
        </div>
        <h1>Get the Dayront App</h1>
      </div>
      <p class="lead">
        Process files up to <strong>5 GB</strong> with native FFmpeg.
        No memory limits, no uploads, no waiting.
      </p>
      <div class="hero-badges">
        <span class="badge badge--primary">⚡ 10× faster</span>
        <span class="badge">📁 5 GB file limit</span>
        <span class="badge">🔒 100% offline</span>
      </div>
    </header>

    <!-- NOTIFY HERO -->
    <section class="notify-hero">
      <div class="notify-hero__inner">
        <div class="notify-hero__badge">
          <span class="notify-hero__dot" aria-hidden="true"></span>
          Launching soon
        </div>

        <h2 class="notify-hero__title">Be first to get the app</h2>
        <p class="notify-hero__sub" id="notify-hero-sub">
          Enter your email and we'll let you know the moment Dayront is available.
        </p>

        <NotifyForm
          client:load
          platform="web"
          source="download-hero"
          ctaLabel="Notify me"
        />
      </div>
    </section>

    <!-- DOWNLOAD GRID -->
    <section class="section">
      <h2>Choose your platform</h2>
      <div class="download-grid">
        {Object.entries(RELEASES).map(([key, info]) => {
          const isAvailable = info.status === 'available' || info.status === 'beta';
          const Tag = isAvailable ? 'a' : 'div';
          return (
            <Tag
              {...(isAvailable ? { href: info.url, rel: 'noopener' } : {})}
              class={`download-card ${!isAvailable ? 'download-card--soon' : ''}`}
              data-platform={key}
              data-status={info.status}
            >
              <div class="download-card__icon" aria-hidden="true" set:html={info.svg} />
              <div class="download-card__body">
                <div class="download-card__title">
                  {info.label}
                  {info.status === 'coming-soon' && (
                    <span class="status-pill status-pill--soon">Coming soon</span>
                  )}
                  {info.status === 'beta' && (
                    <span class="status-pill status-pill--beta">Beta</span>
                  )}
                </div>
                <div class="download-card__meta">{info.store}</div>
                <div class="download-card__note">{info.note}</div>
              </div>
              <div class="download-card__arrow" aria-hidden="true">
                {isAvailable ? '↓' : '⏳'}
              </div>
            </Tag>
          );
        })}
      </div>
    </section>

    <!-- PWA fallback -->
    <section class="section">
      <div class="pwa-card">
        <div class="pwa-card__icon">🌐</div>
        <div class="pwa-card__body">
          <h3>Can't install? Use the PWA</h3>
          <p>
            Dayront works as a Progressive Web App — install it from your
            browser and get an app-like experience with offline support.
            No app store needed.
          </p>
          <button type="button" class="btn btn--secondary" id="pwa-install-btn" hidden>
            Install PWA
          </button>
          <details class="pwa-instructions">
            <summary>Manual install instructions</summary>
            <div class="pwa-steps">
              <div class="pwa-step">
                <strong>iOS Safari</strong>
                <span>Share → Add to Home Screen</span>
              </div>
              <div class="pwa-step">
                <strong>Android Chrome</strong>
                <span>Menu (⋮) → Install app</span>
              </div>
              <div class="pwa-step">
                <strong>Desktop Chrome / Edge</strong>
                <span>Install icon in the address bar</span>
              </div>
              <div class="pwa-step">
                <strong>Desktop Safari</strong>
                <span>File → Add to Dock</span>
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Comparison table -->
    <section class="section">
      <h2>Web vs App</h2>
      <div class="comparison-wrap">
        <table class="comparison">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Web</th>
              <th class="comparison__highlight">App</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Max file size</td>
              <td>100–350 MB</td>
              <td class="comparison__highlight"><strong>5 GB</strong></td>
            </tr>
            <tr>
              <td>Processing speed</td>
              <td>1×</td>
              <td class="comparison__highlight"><strong>Up to 10× faster</strong></td>
            </tr>
            <tr>
              <td>Works offline</td>
              <td>Partial (after first load)</td>
              <td class="comparison__highlight"><strong>Fully offline</strong></td>
            </tr>
            <tr>
              <td>8K conversions</td>
              <td>❌ Not recommended</td>
              <td class="comparison__highlight"><strong>✅ Supported</strong></td>
            </tr>
            <tr>
              <td>AI tools (captions, background removal)</td>
              <td>⚠️ Small files only</td>
              <td class="comparison__highlight"><strong>✅ Full-size</strong></td>
            </tr>
            <tr>
              <td>Batch processing</td>
              <td>❌</td>
              <td class="comparison__highlight"><strong>✅ Coming soon</strong></td>
            </tr>
            <tr>
              <td>Ads</td>
              <td>Small banner</td>
              <td class="comparison__highlight"><strong>None</strong></td>
            </tr>
            <tr>
              <td>Data collection</td>
              <td>None</td>
              <td class="comparison__highlight"><strong>None</strong></td>
            </tr>
            <tr>
              <td>Price</td>
              <td>Free</td>
              <td class="comparison__highlight"><strong>Free</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tools benefit list -->
    <section class="section">
      <h2>What you unlock with the app</h2>
      <p class="section__lead">
        These {appTools.length} tools run best in the app — some require it.
      </p>
      <ul class="tools-list">
        {appTools.map((tool) => (
          <li class="tools-list__item">
            <span class="tools-list__icon">{tool.icon}</span>
            <div class="tools-list__body">
              <a href={toolUrl(tool)} class="tools-list__link">{tool.name}</a>
              {tool.webNote && (
                <span class="tools-list__note">{tool.webNote}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section class="section">
      <h2>Frequently asked questions</h2>
      <div class="faq">
        <details>
          <summary>Is the app really free?</summary>
          <p>Yes. The app is free, with no ads and no sign-up. It's built on the same privacy-first promise as the web version.</p>
        </details>
        <details>
          <summary>Why is the app faster than the browser?</summary>
          <p>The browser version runs FFmpeg compiled to WebAssembly, which is limited to about 300 MB of memory per tab. The app runs native FFmpeg directly on your device — 10× faster and no memory limit.</p>
        </details>
        <details>
          <summary>Does the app upload my files?</summary>
          <p>No. Everything happens locally on your device, exactly like the web version. The app never connects to a server for processing.</p>
        </details>
        <details>
          <summary>Will my settings and preferences carry over?</summary>
          <p>Yes. Your theme, language, and recent tool history sync between web and app (stored locally — no accounts required).</p>
        </details>
        <details>
          <summary>When is the Play Store / App Store release?</summary>
          <p>Android APK and iOS TestFlight are coming first. Store listings are in review and will go live soon. Leave your email in the "Notify me" box to be the first to know.</p>
        </details>
      </div>
    </section>

    <footer class="download-footer">
      <p>
        Built with <strong>native FFmpeg</strong> and <strong>zero telemetry</strong>.
        Your files never leave your device.
      </p>
      <a href="/tools" class="btn btn--ghost">Browse all tools →</a>
    </footer>
  </main>
</BaseLayout>

<style>
  /* ── Layout ──────────────────────────────────────────── */
  .download-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  /* ── Hero ────────────────────────────────────────────── */
  .download-hero {
    text-align: center;
    padding: 2rem 0 1.5rem;
  }
  .hero-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .hero-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 16px rgba(44, 181, 240, 0.35));
  }
  .download-hero h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 800;
    margin: 0;
    line-height: 1.15;
    background: linear-gradient(135deg, #2CB5F0, #0EA5E9);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lead {
    font-size: 1.05rem;
    opacity: 0.8;
    max-width: 34rem;
    margin: 0 auto 1.25rem;
    line-height: 1.55;
  }
  .hero-badges {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    background: #F1F5F9;
    color: #334155;
    border: 1px solid #E2E8F0;
  }
  .badge--primary {
    background: linear-gradient(135deg, #E5F7FE, #C7EBFC);
    color: #0369A1;
    border-color: #8FD6F8;
  }

  /* ── Notify Hero ─────────────────────────────────────── */
  .notify-hero {
    margin: 1rem 0 2.5rem;
    border-radius: 18px;
    background: linear-gradient(135deg, #E5F7FE 0%, #C7EBFC 100%);
    border: 1px solid #8FD6F8;
    padding: 2rem 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .notify-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 4px;
    background: linear-gradient(90deg, #2CB5F0, #0EA5E9);
  }
  .notify-hero__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .notify-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: #ffffff;
    color: #0369A1;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid #8FD6F8;
    margin-bottom: 1rem;
  }
  .notify-hero__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #2CB5F0;
    box-shadow: 0 0 0 4px rgba(44, 181, 240, 0.25);
    animation: notify-pulse 2s ease-in-out infinite;
  }
  @keyframes notify-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.6; transform: scale(0.85); }
  }
  .notify-hero__title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0C4A6E;
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }
  .notify-hero__sub {
    font-size: 0.95rem;
    color: #0C4A6E;
    opacity: 0.85;
    margin: 0 0 1.5rem;
    line-height: 1.55;
  }

  /* ── Sections ────────────────────────────────────────── */
  .section { margin-top: 3rem; }
  .section h2 {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .section__lead {
    font-size: 0.95rem;
    opacity: 0.7;
    margin: -0.5rem 0 1rem;
  }

  /* ── Download grid ───────────────────────────────────── */
  .download-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .download-grid { grid-template-columns: 1fr 1fr; }
  }

  .download-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    text-decoration: none;
    color: inherit;
    transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
  }
  .download-card:hover,
  .download-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(44, 181, 240, 0.15);
    border-color: #57C0F3;
    outline: none;
  }
  .download-card--recommended {
    border-color: #2CB5F0;
    background: linear-gradient(135deg, #E5F7FE, #C7EBFC);
    box-shadow: 0 8px 24px rgba(44, 181, 240, 0.2);
    transform: translateY(-2px);
  }
  .download-card__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    border-radius: 10px;
    padding: 6px;
  }
  .download-card__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .download-card__body { flex: 1; min-width: 0; }
  .download-card__title {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.15rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .download-card__meta {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-bottom: 0.15rem;
  }
  .download-card__note {
    font-size: 0.75rem;
    opacity: 0.6;
  }
  .download-card__arrow {
    font-size: 1.25rem;
    opacity: 0.4;
    flex-shrink: 0;
  }

  .status-pill {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    vertical-align: middle;
  }
  .status-pill--soon {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FCD34D;
  }
  .status-pill--beta {
    background: #E5F7FE;
    color: #0369A1;
    border: 1px solid #8FD6F8;
  }

  .download-card--soon {
    opacity: 0.85;
    cursor: not-allowed;
    pointer-events: none;
  }
  .download-card--soon .download-card__arrow { opacity: 0.4; }
  .download-card--soon .download-card__icon { opacity: 0.7; }

  /* ── PWA card ────────────────────────────────────────── */
  .pwa-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }
  .pwa-card__icon { font-size: 1.75rem; flex-shrink: 0; }
  .pwa-card__body { flex: 1; }
  .pwa-card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .pwa-card p {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    opacity: 0.8;
    line-height: 1.55;
  }
  .pwa-instructions {
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }
  .pwa-instructions summary {
    cursor: pointer;
    padding: 0.35rem 0;
    font-weight: 600;
    opacity: 0.75;
  }
  .pwa-steps {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0 0;
  }
  .pwa-step {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .pwa-step strong { font-size: 0.85rem; }
  .pwa-step span { font-size: 0.8rem; opacity: 0.7; }

  /* ── Comparison table ────────────────────────────────── */
  .comparison-wrap {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
  }
  .comparison {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .comparison th,
  .comparison td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid #E2E8F0;
  }
  .comparison thead th {
    background: #F8FAFC;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #475569;
  }
  .comparison tbody tr:last-child td { border-bottom: none; }
  .comparison__highlight {
    background: linear-gradient(135deg, #E5F7FE, #C7EBFC);
  }
  .comparison thead .comparison__highlight {
    background: linear-gradient(135deg, #2CB5F0, #0EA5E9);
    color: white;
  }

  /* ── Tools list ──────────────────────────────────────── */
  .tools-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .tools-list__item {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    transition: border-color 0.15s ease;
  }
  .tools-list__item:hover { border-color: #8FD6F8; }
  .tools-list__icon { font-size: 1.25rem; flex-shrink: 0; }
  .tools-list__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
