---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "2k-to-720p",
  name: "2K QHD to 720p HD Downscaleer",
  metaTitle: "2K QHD to 720p HD Converter – Free Online | Dayront",
  metaDescription: "Downscale 2K QHD videos to 720p HD in your browser. Free, private, no uploads. 100% local processing.",
  icon: "🎬",
  howTo: [
    { title: "Upload video", text: "Select a 2K QHD video file from your device." },
    { title: "Convert", text: "Click convert to downscale to 720p HD." },
    { title: "Download", text: "Save your 720p HD video." }
  ],
  faq: [{"question":"Does downscaling reduce file size?","answer":"Yes, significantly. A 4K to 720p downscale can reduce file size by 80-90%."},{"question":"Will I lose quality?","answer":"The output matches the target resolution exactly. Detail is preserved as well as possible at the lower resolution."}],
  relatedTools: [
    { href: '/convert/720p-to-480p', icon: '⬇️', name: '720p HD to 480p SD' },
    { href: '/convert/720p-to-2k', icon: '⬆️', name: '720p HD to 2K QHD' },
    { href: '/tools/resize-video', icon: '↔️', name: 'Custom Resize Video' },
    { href: '/tools/video-compressor', icon: '📉', name: 'Video Compressor' }
  ],
  type: "resolution-convert",
  from: "2k",
  to: "720p",
  outputFormat: "mp4",
  presetWidth: 1280,
  presetHeight: 720,
  requiresDesktop: false,
  warningMessage: "",
  settings: [],
  tutorial: "\n      <h2>Why Downscale 2K QHD to 720p HD?</h2>\n      <p>Downscaling to 720p HD reduces file size, improves playback on older devices, and meets upload limits on social platforms.</p>\n      <h3>Resolution Comparison</h3>\n      <table>\n        <thead><tr><th>Format</th><th>Dimensions</th><th>Total Pixels</th></tr></thead>\n        <tbody>\n          <tr><td>Source (2K QHD)</td><td>2560 × 1440 (3.69 MP)</td></tr>\n          <tr><td>Output (720p HD)</td><td>1280 × 720 (0.92 MP)</td></tr>\n        </tbody>\n      </table>\n      <h3>Key Benefits</h3>\n      <ul>\n        <li><strong>100% Private</strong> – Your files never leave your device.</li>\n        <li><strong>No Software Install</strong> – Works directly in your browser.</li>\n        <li><strong>Free & Unlimited</strong> – Use it as many times as you need.</li>\n      </ul>\n    ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
    presetWidth: tool.presetWidth,
    presetHeight: tool.presetHeight,
    requiresDesktop: tool.requiresDesktop,
  }}
  relatedTools={tool.relatedTools}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
