---
import ToolLayout from '../../layouts/ToolLayout.astro';

const page = {
  metaTitle: 'MP3 to WAV Converter – Free Online, No Upload | Dayront',
  metaDescription:
    'Convert MP3 to lossless WAV format in your browser. No upload, 100% private. Perfect for editing or archiving.',
  toolName: 'MP3 to WAV Converter',
  toolIcon: '🎵',
  toolConfig: {
    type: 'convert',
    from: 'mp3',
    to: 'wav',
    label: 'MP3 to WAV',
  } as const,
  howTo: [
    {
      title: 'Upload your MP3 file',
      text: 'Drag & drop or click to select an MP3 audio file.',
    },
    {
      title: 'Convert to WAV',
