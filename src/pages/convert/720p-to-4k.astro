---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';

const tool = {
  slug: "720p-to-4k",
  name: "720p HD to 4K UHD Upscaleer",
  metaTitle: "720p HD to 4K UHD Converter – Free Online | Dayront",
  metaDescription: "Upscale 720p HD videos to 4K UHD in your browser. Free, private, no uploads. 100% local processing.",
  icon: "🎬",
  howTo: [
    { title: "Upload video", text: "Select a 720p HD video file from your device." },
    { title: "Convert", text: "Click convert to upscale to 4K UHD." },
    { title: "Download", text: "Save your 4K UHD video." }
  ],
  faq: [{"question":"Will upscaling add detail?","answer":"No. Upscaling interpolates pixels but cannot recover detail that wasn't in the source. It standardizes resolution across your library."},{"question":"Is it free?","answer":"Yes, completely free with no signup."}],
  relatedTools: [
    { href: '/convert/4k-to-8k', icon: '⬆️', name: '4K UHD to 8K UHD' },
    { href: '/convert/4k-to-720p', icon: '⬇️', name: '4K UHD to 720p HD' },
    { href: '/tools/resize-video', icon: '↔️', name: 'Custom Resize Video' },
    { href: '/tools/video-compressor', icon: '📉', name: 'Video Compressor' }
  ],
  type: "resolution-convert",
  from: "720p",
  to: "4k",
  outputFormat: "mp4",
  presetWidth: 3840,
  presetHeight: 2160,
  requiresDesktop: true,
  warningMessage: "This conversion is CPU-intensive. Keep the tab open and avoid running other heavy apps.",
  settings: [],
  tutorial: "\n      <h2>Why Upscale 720p HD to 4K UHD?</h2>\n      <p>Upscaling to 4K UHD prepares your footage for large displays, projectors, or platforms that require higher resolutions.</p>\n      <h3>Resolution Comparison</h3>\n      <table>\n        <thead><tr><th>Format</th><th>Dimensions</th><th>Total Pixels</th></tr></thead>\n        <tbody>\n          <tr><td>Source (720p HD)</td><td>1280 × 720 (0.92 MP)</td></tr>\n          <tr><td>Output (4K UHD)</td><td>3840 × 2160 (8.29 MP)</td></tr>\n        </tbody>\n      </table>\n      <h3>Key Benefits</h3>\n      <ul>\n        <li><strong>100% Private</strong> – Your files never leave your device.</li>\n        <li><strong>No Software Install</strong> – Works directly in your browser.</li>\n        <li><strong>Free & Unlimited</strong> – Use it as many times as you need.</li>\n      </ul>\n    ",
  relatedBlogs: [],
};
---

<ToolLayout
  toolKey={tool.slug}
  toolConfig={{
    type: tool.type,
    from: tool.from,
    to: tool.to,
    outputFormat: tool.outputFormat,
    label: tool.name,
    settings: tool.settings,
    presetWidth: tool.presetWidth,
    presetHeight: tool.presetHeight,
    requiresDesktop: tool.requiresDesktop,
  }}
  relatedTools={tool.relatedTools}
  extraContent={{
    tutorial: tool.tutorial,
    relatedBlogs: tool.relatedBlogs,
  }}
/>
