  metaDescription:
    'Convert WebM video to MP3 audio in your browser. No upload, private, and free. Perfect for saving soundtracks.',
  toolName: 'WebM to MP3 Converter',
  toolIcon: '🎬',
  toolConfig: {
    type: 'convert',
    from: 'webm',
    to: 'mp3',
    label: 'WebM to MP3',
  } as const,
  howTo: [
    {
      title: 'Upload your WebM file',
