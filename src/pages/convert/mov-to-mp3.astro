---
import ToolLayout from '../../layouts/ToolLayout.astro';

const page = {
  metaTitle: 'MOV to MP3 Converter – Extract Audio Free Online | Dayront',
  metaDescription:
    'Convert MOV video to MP3 audio directly in your browser. No upload, 100% private. Works on all devices.',
  toolName: 'MOV to MP3 Converter',
  toolIcon: '🎬',
  toolConfig: {
    type: 'convert',
    from: 'mov',
    to: 'mp3',
    label: 'MOV to MP3',
  } as const,
  howTo: [
    {
      title: 'Choose your MOV file',
      text: 'Select a QuickTime MOV video from your device.',
    },
    {
      title: 'Extract audio as MP3',
      text: 'Our tool pulls the audio track and encodes it to MP3.',
    },
    {
      title: 'Download the MP3',
      text: 'Save the audio for use on any music player or phone.',
    },
  ],
  faq: [
    {
      question: 'Are iPhone videos supported?',
      answer: 'Yes, MOV files recorded on iPhones are fully compatible.',
    },
    {
      question: 'Will it lose quality?',
      answer: 'We use a high‑quality MP3 encoder to preserve the original sound as much as possible.',
    },
    {
      question: 'Is it really free?',
      answer: 'Yes, unlimited conversions with no hidden fees.',
    },
  ],
  relatedTools: [
    { href: '/convert/mp4-to-mp3', icon: '🎬', name: 'MP4 to MP3' },
    { href: '/convert/avi-to-mp3', icon: '🎬', name: 'AVI to MP3' },
    { href: '/tools/speed-changer', icon: '⏩', name: 'Speed Changer' },
  ],
};
---

<ToolLayout {...page} />