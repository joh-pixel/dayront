---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../lib/tools';

// Popular tools to suggest
const popularSlugs = [
  'mp4-to-mp3',
  'video-compressor',
  'video-merger',
  'audio-cutter',
  'mp3-to-wav',
  'extract-audio',
];
const popularTools = popularSlugs
  .map((slug) => tools.find((t) => t.slug === slug))
  .filter(Boolean);

// Suggested pages
const suggestedPages = [
  { title: 'All Tools', url: '/tools', icon: '🧰', desc: 'Browse every tool' },
  { title: 'Download App', url: '/download', icon: '⬇️', desc: 'Get the Dayront app' },
  { title: 'Blog', url: '/blog/en', icon: '📝', desc: 'Guides and how-tos' },
  { title: 'Search', url: '/search', icon: '🔍', desc: 'Find anything' },
];
---

<BaseLayout
  title="Page not found — Dayront"
  description="That page doesn't exist. Try searching or browse our tools."
  noindex={true}
>
  <main class="page-404">
    <div class="wrapper">
      <div class="error-code" aria-hidden="true">404</div>

      <h1>Page not found</h1>
      <p class="lead">
        The page you're looking for doesn't exist, was moved, or the URL is
        slightly off. Let's get you back on track.
      </p>

      <!-- Search -->
      <form class="search-404" action="/search" method="get" role="search">
        <div class="search-404__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.35-4.35" />
          </svg>
        </div>
        <input
          type="search"
          name="q"
          placeholder="Search tools, articles, and answers…"
          aria-label="Search Dayront"
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>

      <!-- Popular tools -->
      <section class="section-404">
        <h2>Popular tools</h2>
        <ul class="tool-grid">
          {popularTools.map((tool) => (
            <li>
              <a
                href={tool!.from && tool!.to ? `/convert/${tool!.slug}` : `/tools/${tool!.slug}`}
                class="tool-card"
              >
                <span class="tool-card__icon">{tool!.icon}</span>
                <span class="tool-card__body">
                  <strong>{tool!.name}</strong>
                  <span>{tool!.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Suggested pages -->
      <section class="section-404">
        <h2>Or jump to</h2>
        <div class="page-grid">
          {suggestedPages.map((p) => (
            <a href={p.url} class="page-card">
              <span class="page-card__icon">{p.icon}</span>
              <span class="page-card__body">
                <strong>{p.title}</strong>
                <span>{p.desc}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <div class="actions-404">
        <a href="/" class="btn btn--primary">← Back to home</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .page-404 {
    padding: 3rem 1.25rem 5rem;
  }
  .wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  .error-code {
    font-size: clamp(6rem, 20vw, 10rem);
    font-weight: 900;
    line-height: 1;
    text-align: center;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #2CB5F0, #0EA5E9);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.03em;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 800;
    text-align: center;
    margin: 0 0 0.75rem;
  }

  .lead {
    font-size: 1rem;
    text-align: center;
    opacity: 0.75;
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto 2rem;
  }

  /* Search */
  .search-404 {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    margin-bottom: 3rem;
    overflow: hidden;
  }
  .search-404:focus-within {
    border-color: #2CB5F0;
    box-shadow: 0 0 0 4px rgba(44, 181, 240, 0.12);
  }
  .search-404__icon {
    padding: 0 0.5rem 0 1rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .search-404 input {
    flex: 1;
    min-width: 0;
    padding: 1rem 0.5rem;
    border: none;
    background: transparent;
    font-size: 1rem;
    font-family: inherit;
    color: inherit;
    outline: none;
  }
  .search-404 input::placeholder { color: #94a3b8; }
  .search-404 button {
    padding: 0.75rem 1.5rem;
    margin: 0.4rem;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #2CB5F0, #0EA5E9);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .search-404 button:hover { opacity: 0.9; }
  .search-404 button:active { transform: scale(0.98); }

  .section-404 { margin-bottom: 2.5rem; }
  .section-404 h2 {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.65;
    font-size: 0.78rem;
  }

  /* Popular tools */
  .tool-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .tool-grid { grid-template-columns: 1fr 1fr; }
  }
  .tool-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    text-decoration: none;
    color: inherit;
    transition: all 0.12s ease;
  }
  .tool-card:hover {
    border-color: #8FD6F8;
    background: #E5F7FE;
    transform: translateY(-1px);
  }
  .tool-card__icon {
    font-size: 1.35rem;
    flex-shrink: 0;
    line-height: 1;
  }
  .tool-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .tool-card__body strong {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .tool-card__body span {
    font-size: 0.75rem;
    opacity: 0.7;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Suggested pages */
  .page-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 1fr 1fr;
  }
  .page-card {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.75rem 0.9rem;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    text-decoration: none;
    color: inherit;
    transition: all 0.12s ease;
  }
  .page-card:hover {
    border-color: #2CB5F0;
    box-shadow: 0 4px 14px rgba(44, 181, 240, 0.12);
  }
  .page-card__icon { font-size: 1.25rem; flex-shrink: 0; }
  .page-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .page-card__body strong {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .page-card__body span {
    font-size: 0.7rem;
    opacity: 0.65;
  }

  .actions-404 {
    text-align: center;
    margin-top: 3rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.75rem 1.5rem;
    min-height: 46px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
    border: none;
    font-family: inherit;
  }
  .btn--primary {
    background: linear-gradient(135deg, #2CB5F0 0%, #0EA5E9 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(44, 181, 240, 0.3);
  }
  .btn--primary:hover {
    box-shadow: 0 6px 20px rgba(44, 181, 240, 0.45);
    transform: translateY(-1px);
  }

  /* Dark mode */
  @media (prefers-color-scheme: dark) {
    .search-404 {
      background: #0f172a;
      border-color: #1e293b;
    }
    .search-404:focus-within {
      border-color: #2CB5F0;
      box-shadow: 0 0 0 4px rgba(44, 181, 240, 0.2);
    }
    .tool-card {
      background: #0f172a;
      border-color: #1e293b;
      color: #e2e8f0;
    }
    .tool-card:hover {
      background: #0c2a42;
      border-color: #2CB5F0;
    }
    .page-card {
      background: #0f172a;
      border-color: #1e293b;
      color: #e2e8f0;
    }
    .page-card:hover {
      border-color: #2CB5F0;
      box-shadow: 0 4px 14px rgba(44, 181, 240, 0.2);
    }
  }
  </style>