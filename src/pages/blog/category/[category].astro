---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/blog/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', (entry) => entry.id.startsWith('en/'));
  const categoriesSet = new Set<string>();
  allPosts.forEach(post => {
    post.data.categories?.forEach(cat => categoriesSet.add(cat.toLowerCase()));
  });
  return Array.from(categoriesSet).map(cat => ({
    params: { category: cat },
  }));
}

const { category } = Astro.params;
const allPosts = await getCollection('blog', (entry) => entry.id.startsWith('en/'));
const filteredPosts = allPosts
  .filter(post => post.data.categories?.some(cat => cat.toLowerCase() === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    slug: post.id.replace(/\.mdx$/, '').replace(/^en\//, ''),
    date: post.data.date.toISOString(),
    categories: post.data.categories || [],
    tags: post.data.tags || [],
  }));

const categoryName = category.charAt(0).toUpperCase() + category.slice(1);
---

<BaseLayout
  title={`${categoryName} – Blog | Dayront`}
  description={`Blog posts about ${categoryName} – media tools, privacy, guides.`}
>
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-extrabold text-black dark:text-white mb-8">Category: {categoryName}</h1>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {filteredPosts.map(post => <ArticleCard {...post} />)}
    </div>
  </section>
</BaseLayout>