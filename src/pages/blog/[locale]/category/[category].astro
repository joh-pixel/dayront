---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locales = ['en']; // Add 'es', 'fr', etc. later
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.flatMap(p => p.data.categories || []))];

  return locales.flatMap(locale =>
    categories.map(category => ({
      params: { locale, category: category.toLowerCase() },
      props: { category, locale }
    }))
  );
}

const { category, locale } = Astro.props;

const allPosts = await getCollection('blog', ({ id, data }) =>
  id.startsWith(`${locale}/`) &&
  (data.categories || []).map(c => c.toLowerCase()).includes(category)
);

const sortedPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    slug: post.id.replace(/\.mdx$/, '').replace(new RegExp(`^${locale}\/`), ''),
    date: post.data.date.toISOString(),
    categories: post.data.categories || [],
    image: post.data.image || null,
  }));
---

<BaseLayout lang={locale}
  title={`${category.charAt(0).toUpperCase() + category.slice(1)} – Dayront Blog`}
  description={`Articles categorized under ${category}.`}
>
  <main class="max-w-7xl mx-auto px-6 py-24">
    <nav class="text-sm text-gray-500 mb-6">
      <a href={`/blog/${locale}`} class="hover:text-sky transition">← Back to Blog</a>
    </nav>
    
    <h1 class="text-4xl font-black text-black dark:text-white mb-10">
      Category: <span class="text-sky">{category.charAt(0).toUpperCase() + category.slice(1)}</span>
    </h1>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <article class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden hover:shadow-lg transition">
          {post.image && (
            <a href={`/blog/${locale}/${post.slug}`}>
              <img src={post.image} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />
            </a>
          )}
          <div class="p-6">
            <h2 class="text-xl font-bold text-black dark:text-white mb-2">
              <a href={`/blog/${locale}/${post.slug}`} class="hover:text-sky transition">{post.title}</a>
            </h2>
            <p class="text-gray-600 dark:text-white line-clamp-2 mb-4">{post.description}</p>
            <a href={`/blog/${locale}/${post.slug}`} class="text-sky font-semibold text-sm">Read More →</a>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>