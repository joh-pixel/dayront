---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const locales = ['en'];
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap(p => p.data.tags || []))];

  return locales.flatMap(locale =>
    tags.map(tag => ({
      params: { locale, tag: tag.toLowerCase() },
      props: { tag, locale }
    }))
  );
}

const { tag, locale } = Astro.props;

const allPosts = await getCollection('blog', ({ id, data }) =>
  id.startsWith(`${locale}/`) &&
  // FIXED: Added .toLowerCase() to the tag prop here
  (data.tags || []).map(t => t.toLowerCase()).includes(tag.toLowerCase())
);

// Dynamically map all images from your centralized content/images folder
const allImages = import.meta.glob('/src/content/images/*.{jpg,jpeg,png,webp}');

const sortedPosts = await Promise.all(
  allPosts
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map(async (post) => {
      const imgFileName = post.data.image;
      let resolvedImage = null;
      
      if (imgFileName) {
        const imagePath = `/src/content/images/${imgFileName}`;
        if (allImages[imagePath]) {
          const imgModule = await allImages[imagePath]();
          resolvedImage = imgModule.default;
        }
      }

      return {
        title: post.data.title,
        description: post.data.description,
        slug: post.id.replace(/\.mdx$/, '').replace(new RegExp(`^${locale}\/`), ''),
        date: post.data.date.toISOString(),
        image: resolvedImage,
      };
    })
);
---

<BaseLayout lang={locale}
  title={`#${tag} – Dayront Blog`}
  description={`Articles tagged with ${tag}.`}
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <main class="max-w-7xl mx-auto px-6 py-24">
    <nav class="text-sm text-gray-500 mb-6">
      <a href={`/blog/${locale}`} class="hover:text-sky transition">← Back to Blog</a>
    </nav>
    
    <h1 class="text-4xl font-black text-black dark:text-white mb-10">
      Tag: <span class="text-sky">#{tag}</span>
    </h1>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <article class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl overflow-hidden hover:shadow-lg transition">
          {post.image && (
            <a href={`/blog/${locale}/${post.slug}`}>
              <Image 
                src={post.image} 
                alt={post.title} 
                width={400} 
                height={300} 
                class="w-full h-48 object-cover" 
                loading="lazy" 
              />
            </a>
          )}
          <div class="p-6">
            <h2 class="text-xl font-bold text-black dark:text-white mb-2">
              <a href={`/blog/${locale}/${post.slug}`} class="hover:text-sky transition">{post.title}</a>
            </h2>
            <p class="text-gray-600 dark:text-white line-clamp-2 mb-4">{post.description}</p>
            <a href={`/blog/${locale}/${post.slug}`} class="text-sky font-semibold text-sm">Read More →</a>
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>